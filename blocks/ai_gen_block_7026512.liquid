{% doc %}
  @prompt
    I need you to make a bblockwhere i can p[aste the custom liquid code directly from the editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-liquid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-custom-liquid-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-custom-liquid-empty-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: 8px;
    color: #666666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-custom-liquid-container-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<custom-liquid-block-{{ ai_gen_id }}
  class="ai-custom-liquid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-custom-liquid-container-{{ ai_gen_id }}">
    {% if block.settings.custom_liquid != blank %}
      {{ block.settings.custom_liquid }}
    {% else %}
      <div class="ai-custom-liquid-empty-{{ ai_gen_id }}">
        Paste your custom Liquid code in the block settings
      </div>
    {% endif %}
  </div>
</custom-liquid-block-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Custom liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid code"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Custom liquid"
    }
  ]
}
{% endschema %}
