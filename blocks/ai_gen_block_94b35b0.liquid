{% doc %}
  @prompt
    I need you to make a supper rich text editor like google doc.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rich-editor-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
  }

  .ai-rich-editor__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    background-color: {{ block.settings.editor_bg_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.editor_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-rich-editor__toolbar-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 12px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.toolbar_bg_color }};
    border-radius: {{ block.settings.editor_border_radius }}px {{ block.settings.editor_border_radius }}px 0 0;
  }

  .ai-rich-editor__toolbar-group-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    padding: 0 8px;
    border-right: 1px solid {{ block.settings.border_color }};
  }

  .ai-rich-editor__toolbar-group-{{ ai_gen_id }}:last-child {
    border-right: none;
  }

  .ai-rich-editor__toolbar-btn-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    color: {{ block.settings.toolbar_icon_color }};
    transition: all 0.2s ease;
  }

  .ai-rich-editor__toolbar-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.toolbar_hover_bg }};
    border-color: {{ block.settings.border_color }};
  }

  .ai-rich-editor__toolbar-btn-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.toolbar_active_bg }};
    color: {{ block.settings.toolbar_active_color }};
  }

  .ai-rich-editor__toolbar-select-{{ ai_gen_id }} {
    height: 32px;
    padding: 0 8px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 4px;
    background-color: {{ block.settings.editor_bg_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} {
    min-height: {{ block.settings.min_height }}px;
    padding: 24px;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    outline: none;
    overflow-y: auto;
  }

  .ai-rich-editor__content-{{ ai_gen_id }}:empty:before {
    content: attr(data-placeholder);
    color: {{ block.settings.placeholder_color }};
    pointer-events: none;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} h1 {
    font-size: 2em;
    font-weight: bold;
    margin: 0.67em 0;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} h2 {
    font-size: 1.5em;
    font-weight: bold;
    margin: 0.75em 0;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} h3 {
    font-size: 1.17em;
    font-weight: bold;
    margin: 0.83em 0;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} p {
    margin: 1em 0;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} ul,
  .ai-rich-editor__content-{{ ai_gen_id }} ol {
    margin: 1em 0;
    padding-left: 40px;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} blockquote {
    margin: 1em 0;
    padding-left: 16px;
    border-left: 4px solid {{ block.settings.border_color }};
    color: #666;
    font-style: italic;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} code {
    background-color: #f4f4f4;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1em 0;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} table {
    border-collapse: collapse;
    width: 100%;
    margin: 1em 0;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} table td,
  .ai-rich-editor__content-{{ ai_gen_id }} table th {
    border: 1px solid {{ block.settings.border_color }};
    padding: 8px;
    text-align: left;
  }

  .ai-rich-editor__content-{{ ai_gen_id }} table th {
    background-color: #f4f4f4;
    font-weight: bold;
  }

  .ai-rich-editor__footer-{{ ai_gen_id }} {
    padding: 12px 24px;
    border-top: 1px solid {{ block.settings.border_color }};
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #666;
  }

  .ai-rich-editor__word-count-{{ ai_gen_id }} {
    color: #666;
  }

  @media screen and (max-width: 749px) {
    .ai-rich-editor__toolbar-{{ ai_gen_id }} {
      gap: 2px;
      padding: 8px;
    }

    .ai-rich-editor__toolbar-group-{{ ai_gen_id }} {
      padding: 0 4px;
    }

    .ai-rich-editor__toolbar-btn-{{ ai_gen_id }} {
      width: 28px;
      height: 28px;
    }

    .ai-rich-editor__content-{{ ai_gen_id }} {
      padding: 16px;
      font-size: 14px;
    }
  }
{% endstyle %}

<rich-text-editor-{{ ai_gen_id }} class="ai-rich-editor-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-rich-editor__container-{{ ai_gen_id }}">
    <div class="ai-rich-editor__toolbar-{{ ai_gen_id }}">
      <div class="ai-rich-editor__toolbar-group-{{ ai_gen_id }}">
        <select class="ai-rich-editor__toolbar-select-{{ ai_gen_id }}" data-command="formatBlock">
          <option value="p">Paragraph</option>
          <option value="h1">Heading 1</option>
          <option value="h2">Heading 2</option>
          <option value="h3">Heading 3</option>
        </select>
      </div>

      <div class="ai-rich-editor__toolbar-group-{{ ai_gen_id }}">
        <button class="ai-rich-editor__toolbar-btn-{{ ai_gen_id }}" data-command="bold" title="Bold (Ctrl+B)">
