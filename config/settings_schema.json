[
  {
    "name": "theme_info",
    "theme_name": "Dawn Imperial",
    "theme_version": "2.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Mega Menu",
    "settings": [
      {
        "type": "header",
        "content": "Appearance"
      },
      {
        "type": "color",
        "id": "mega_menu_bg",
        "label": "Background Color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "mega_menu_text",
        "label": "Text Color",
        "default": "#333333"
      },
      {
        "type": "range",
        "id": "mega_menu_opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Background Opacity",
        "default": 100
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "mega_menu_min_height",
        "min": 200,
        "max": 800,
        "step": 50,
        "unit": "px",
        "label": "Minimum Height",
        "default": 300
      },
      {
        "type": "checkbox",
        "id": "mega_menu_show_images",
        "label": "Show Collection Images",
        "default": true
      }
    ]
  }
]