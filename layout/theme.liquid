<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
    {%- endif -%}

    {% render 'css-variables' %}
 
    <link rel="canonical" href="{{ shop.url }}{{ product.url }}">
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

     {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    {% if request.query_string != blank %}
      <meta name="robots" content="noindex, follow">
    {% endif %}
    {%- render 'foxify-head' -%}
    {% capture the_snippet_beae-global-theme-setting %}{% include 'beae-global-theme-setting' %}{% endcapture %}
    {% unless the_snippet_beae-global-theme-setting contains 'Liquid error' %}
      {{ the_snippet_beae-global-theme-setting }}
    {% endunless %}
  </head>

  <body>
    {% sections 'foxify-header-group' %}
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    {%- render 'foxify-footer' -%}
    {% sections 'foxify-footer-group' %}
    {%- render 'ecom_footer' -%}
    <!-- BEAE-FOOTER -->
    {%- render 'beae_footer' -%}
    <!-- END BEAE-FOOTER -->
    <!-- BEAE-AB-SNIPPET -->
    {%- render 'beae_ab_snippet' -%}
    <!-- END BEAE-AB-SNIPPET -->
  </body>
</html>

{%- if template.name == 'collection' -%}
  {% render 'schema-collection' %}
{%- endif -%}

{%- if page.handle == 'faqs' or page.handle == 'frequently-asked-questions' -%}
  {% render 'schema-faq' %}
{%- endif -%}

{% comment %} Load Organization Schema only on Homepage {% endcomment %}
{%- if template.name == 'index' -%}
  {% render 'schema-organization' %}
{%- endif -%}
{% comment %} Load Product Schema only on Product pages {% endcomment %}
{%- if template.name == 'product' -%}
  {% render 'schema-product' %}
{%- endif -%}
