<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="512x512" href="{{ settings.favicon | image_url: width: 512 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <meta property="og:image" content="{{ settings.favicon | image_url: width: 512 }}">
      <link rel="icon" href="https://imperialknots.com/cdn/shop/files/favicon.png">
    {%- endif -%}
    {% render 'css-variables' %}

    <link rel="canonical" href="{{ canonical_url }}">
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    {% if request.query_string != blank %}
      <meta name="robots" content="noindex, follow">
    {% endif %}
    {%- render 'foxify-head' -%}
    {% capture the_snippet_beae-global-theme-setting %}{% include 'beae-global-theme-setting' %}{% endcapture %}
    {% unless the_snippet_beae-global-theme-setting contains 'Liquid error' %}
      {{ the_snippet_beae-global-theme-setting }}
    {% endunless %}
  </head>

  <body>
    {% sections 'foxify-header-group' %}
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    {%- render 'foxify-footer' -%}
    {% sections 'foxify-footer-group' %}
    {%- render 'ecom_footer' -%}
    <!-- BEAE-FOOTER -->
    {%- render 'beae_footer' -%}
    <!-- END BEAE-FOOTER -->
    <!-- BEAE-AB-SNIPPET -->
    {%- render 'beae_ab_snippet' -%}
    <!-- END BEAE-AB-SNIPPET -->
  </body>
</html>

