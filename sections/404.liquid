{% comment %}
  Custom 404 page with automatic redirect to In-Stock collection
{% endcomment %}

<div class="page-404">
  <h1>Oops! Page Not Found</h1>
  <p>We couldn’t find what you’re looking for.</p>
  <p>Redirecting you to our available rugs...</p>

  <a href="https://www.imperialknots.com/collections/in-stock" class="btn">
    Shop In-Stock Rugs
  </a>
</div>

<script>
  setTimeout(function() {
    window.location.href = "https://www.imperialknots.com/collections/in-stock";
  }, 1500);
</script>

<style>
.page-404 {
  text-align: center;
  padding: 60px 20px;
}

.page-404 h1 {
  font-size: 32px;
  margin-bottom: 10px;
}

.page-404 p {
  font-size: 16px;
  margin: 5px 0;
}

.btn {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 24px;
  background: #000;
  color: #fff;
  text-decoration: none;
  font-weight: 500;
}
</style>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
