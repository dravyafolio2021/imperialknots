{% comment %}
  SECTION: CORA ARTICLE TEMPLATE
  Filename: sections/cora-article-template.liquid
  Purpose: Clean, readable blog post layout with hero image.
{% endcomment %}

{{ 'cora-article-template.css' | asset_url | stylesheet_tag }}

<article class="cat-section" itemscope itemtype="http://schema.org/BlogPosting">
  
  <div class="cat-hero">
    <div class="cat-hero-bg">
      {%- if article.image -%}
        <img src="{{ article.image | img_url: '2000x' }}" width="" height="" alt="{{ article.title }}" loading="eager">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    
    <div class="cat-hero-overlay"></div>

    <div class="cat-hero-content">
      <h1 class="cat-title" itemprop="headline">{{ article.title }}</h1>
      {%- if article.excerpt.size > 0 -%}
        <div class="cat-excerpt">{{ article.excerpt }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="cat-container">
    
    <div class="cat-meta">
      <span>Last Updated: <time itemprop="datePublished" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: "%B %d, %Y" }}</time></span>
      {%- if section.settings.show_author -%}
        <span>&nbsp;&bull;&nbsp; Written by {{ article.author }}</span>
      {%- endif -%}
    </div>

    <div class="cat-content rte" itemprop="articleBody">
      {{ article.content }}
    </div>

    <div class="cat-footer">
      <a href="{{ blog.url }}" class="cat-back-link">← Back to {{ blog.title }}</a>
    </div>

    </div>
</article>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Article",
  "articleBody": {{ article.content | strip_html | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ request.origin | append: page.url | json }}
  },
  "headline": {{ article.title | json }},
  "image": [
    {{ article.image | image_url: width: 1200 | prepend: "https:" | json }}
  ],
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}
  }
}
</script>

{% schema %}
{
  "name": "Article Template",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author Name",
      "default": true
    }
  ]
}
{% endschema %}