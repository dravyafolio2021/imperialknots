{% comment %}
  SECTION: CORA BLOG GRID
  Filename: sections/cora-blog-grid.liquid
  Purpose: Displays articles in a 3-column grid with read time.
{% endcomment %}

{{ 'cora-blog-grid.css' | asset_url | stylesheet_tag }}

<section class="cbg-section">
  <div class="cbg-container">
    <div class="cbg-header">
      <h1 class="cbg-title">{{ blog.title }}</h1>
      <div class="cbg-desc">
        {%- if section.settings.description != blank -%}
          {{ section.settings.description }}
        {%- else -%}
          Explore our collection of articles on craftsmanship, design, and the art of handmade rugs.
        {%- endif -%}
      </div>
    </div>

    {% paginate blog.articles by 9 %}
      <div class="cbg-grid">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" class="cbg-card">
            <div class="cbg-image-wrap">
              {%- if article.image -%}
                <img
                  src="{{ article.image | img_url: '800x600', crop: 'center' }}"
                  alt="{{ article.title }}"
                  loading="lazy" width="" height=""
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}

              {%- if article.tags.size > 0 -%}
                <span class="cbg-tag">{{ article.tags.first }}</span>
              {%- endif -%}
            </div>

            <div class="cbg-content">
              <div class="cbg-meta">
                <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
                <span>&bull;</span>

                {% assign words = article.content | strip_html | split: ' ' | size %}
                {% assign read_time = words | divided_by: 200 | plus: 1 %}
                <span>{{ read_time }} min read</span>
              </div>

              <h2 class="cbg-card-title">{{ article.title }}</h2>
              <div class="cbg-excerpt">
                {% if article.excerpt.size > 0 %}
                  {{ article.excerpt }}
                {% else %}
                  {{ article.content | strip_html | truncatewords: 20 }}
                {% endif %}
              </div>

              <div class="cbg-read-more">Read More →</div>
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="cbg-pagination">
          {{ paginate | default_pagination: next: '>', previous: '<' }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog Grid",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our collection of articles on craftsmanship, design, and the art of handmade rugs."
    }
  ]
}
{% endschema %}





{% comment %} 

<h1>{{ blog.title }}</h1>

{% paginate blog.articles by 5 %}
  {% for article in blog.articles %}
    <div>
      {% if article.image %}
        {{ article.image | image_url: width: 1000 | image_tag }}
      {% endif %}
      <h2>
        {{ article.title | link_to: article.url }}
      </h2>
      {% assign date = article.published_at | time_tag: format: 'date' %}
      <p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
      <p>{{ article.excerpt }}</p>
    </div>
  {% endfor %}

  {%- if paginate.pages > 1 -%}
    {{- paginate | default_pagination -}}
  {%- endif -%}
{% endpaginate %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %} {% endcomment %}
