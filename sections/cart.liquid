{{ 'cora-cart.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Overriding the title for a cleaner, modern look */
  .cora-cart-title {
    font-family: var(--font-heading-family), 'Poppins', sans-serif; /* Uses theme font */
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #000;
  }
  
  /* Payment Icons Container */
  .cora-payment-icons {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    opacity: 0.8;
  }
  .cora-payment-icons svg {
    height: 24px;
    width: auto;
  }
{%- endstyle -%}

<div class="cora-cart-section">
  <div class="cora-cart-container">

    <div class="cora-cart-header">
      <h1 class="cora-cart-title">{{ 'cart.title' | t }}</h1>
      <span class="cora-cart-subtitle">
        {% if cart.item_count > 0 %}
          YOU HAVE {{ cart.item_count }} ITEM{% if cart.item_count != 1 %}S{% endif %} IN YOUR CART
        {% else %}
          YOUR CART IS CURRENTLY EMPTY
        {% endif %}
      </span>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      
      {% if cart.item_count > 0 %}
        <div class="cora-cart-grid">
          
          <div class="cora-cart-items">
            {% for item in cart.items %}
              <div class="cora-cart-item">
                
                {% if item.image %}
                  <a href="{{ item.url }}">
                    <img 
                      src="{{ item.image | img_url: '400x' }}" 
                      alt="{{ item.title | escape }}" 
                      class="cora-item-image"
                      loading="lazy"
                    >
                  </a>
                {% else %}
                  <div class="cora-item-image" style="background:#f4f4f4; display:flex; align-items:center; justify-content:center;">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}

                <div class="cora-item-details">
                  <div>
                    <h3 class="cora-item-title">
                      <a href="{{ item.url }}" style="text-transform: uppercase; letter-spacing: 0.5px;">{{ item.product.title }}</a>
                    </h3>
                    
                    {% unless item.product.has_only_default_variant %}
                      <div class="cora-item-variant">{{ item.variant.title }}</div>
                    {% endunless %}
                  </div>

                  <div style="margin-top: 15px;">
                    <div class="cora-qty-pill">
                      <button type="button" class="cora-qty-btn" onclick="this.nextElementSibling.stepDown(); this.nextElementSibling.form.submit()">
                        &minus;
                      </button>
                      <input 
                        type="number" 
                        name="updates[]" 
                        value="{{ item.quantity }}" 
                        min="0" 
                        class="cora-qty-input"
                        aria-label="Quantity"
                      >
                      <button type="button" class="cora-qty-btn" onclick="this.previousElementSibling.stepUp(); this.previousElementSibling.form.submit()">
                        &plus;
                      </button>
                    </div>

                    <br>
                    <a href="{{ item.url_to_remove }}" class="cora-item-remove" style="text-transform: uppercase; font-size: 11px; letter-spacing: 1px;">
                      Remove
                    </a>
                  </div>
                </div>

                <div class="cora-item-price-col">
                  {% if item.original_line_price != item.final_line_price %}
                    <div class="cora-cart-item__discounted-prices">
                      <s class="cora-cart-item__old-price price" style="color:#999; margin-right:5px;">
                        {{ item.original_line_price | money }}
                      </s>
                      <span class="price" style="color:#d32f2f;">
                        {{ item.final_line_price | money }}
                      </span>
                    </div>
                  {% else %}
                    <span class="price">
                      {{ item.original_line_price | money }}
                    </span>
                  {% endif %}
                </div>

              </div>
            {% endfor %}
          </div>

          <div class="cora-cart-summary">
            <h2 class="cora-summary-title" style="font-family: inherit;">Order Summary</h2>
            
            <div class="cora-summary-row">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            
            <p style="font-size: 13px; color: #888; margin-top: 10px; line-height: 1.5;">
              Shipping costs, taxes, and discounts will be calculated at checkout.
            </p>

            <div class="cora-summary-row total">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <button type="submit" name="checkout" class="cora-checkout-btn">
              Proceed to Checkout
            </button>

            <div class="cora-payment-icons">
              <ul class="list list-payment" role="list" style="display:flex; gap:10px; justify-content:center; list-style:none; padding:0;">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            
            <div style="text-align: center; margin-top: 10px; font-size: 11px; color: #999;">
               Secure Checkout
            </div>

          </div>

        </div>

      {% else %}
        <div class="cora-cart-empty">
          <div style="font-size: 60px; margin-bottom: 20px;">🛍️</div>
          <h2 class="cora-cart-title" style="font-size: 32px; margin-bottom: 10px;">Your cart is empty</h2>
          <p style="color: #666; margin-bottom: 30px;">Looks like you haven't added any items yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="cora-empty-btn">Start Shopping</a>
        </div>
      {% endif %}

    </form>

  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}