{% comment %}
  STAGING LINK MANAGER - V2 (Fixes Broken Links)
  - Automatically adds 'https://' if missing
  - Fixes the issue where links merge with your store domain
{% endcomment %}

<style>
  .staging-board {
    max-width: 900px;
    margin: 60px auto;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #333;
    padding: 20px;
  }

  .sb-header {
    background: #f4f4f4;
    padding: 30px;
    border-radius: 12px;
    margin-bottom: 40px;
    border: 1px solid #ddd;
    text-align: center;
  }

  .sb-title { margin: 0 0 10px 0; font-size: 24px; font-weight: 700; }
  .sb-subtitle { margin: 0; color: #666; font-size: 14px; }

  /* The Link List */
  .sb-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .sb-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border: 1px solid #eee;
    border-radius: 8px;
    background: #fff;
    transition: box-shadow 0.2s;
    text-decoration: none;
    color: inherit;
  }

  .sb-item:hover {
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    border-color: #E87034; /* Brand Color */
  }

  .sb-name { font-weight: 600; font-size: 16px; }
  .sb-path { font-size: 12px; color: #999; font-family: monospace; margin-top: 4px; }
  
  .sb-status {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }
  .sb-status.ready { background: #e6fffa; color: #047481; }
  .sb-status.wip { background: #fffaf0; color: #9c4221; }

  .sb-arrow { font-size: 20px; color: #ccc; margin-left: 15px; }
  .sb-item:hover .sb-arrow { color: #E87034; }

  .sb-warning {
    background: #fff5f5;
    color: #c53030;
    padding: 15px;
    border-radius: 6px;
    margin-bottom: 20px;
    text-align: center;
    border: 1px solid #fc8181;
  }
</style>

<div class="staging-board">

  <div class="sb-header">
    <h1 class="sb-title">{{ section.settings.heading }}</h1>
    <p class="sb-subtitle">{{ section.settings.info_text }}</p>
  </div>

  {% if section.settings.base_url == blank %}
    <div class="sb-warning">
      ⚠️ <strong>Developer:</strong> Please paste the active Shopify Preview URL in the section settings.
    </div>
  {% endif %}

  <div class="sb-list">
    {% for block in section.blocks %}
      
      {% assign base = section.settings.base_url | strip %}
      
      {% comment %} ----------------------------------------- {% endcomment %}
      {% comment %} CRITICAL FIX: FORCE HTTPS IF MISSING      {% endcomment %}
      {% comment %} ----------------------------------------- {% endcomment %}
      {% unless base contains 'http://' or base contains 'https://' %}
        {% assign base = 'https://' | append: base %}
      {% endunless %}

      {% comment %} Clean up trailing slash {% endcomment %}
      {% assign base = base | remove_last: '/' %}

      {% assign path = block.settings.path %}
      
      {% comment %} Ensure path starts with slash {% endcomment %}
      {% unless path contains '/' %}
        {% assign path = '/' | append: path %}
      {% endunless %}

      {% assign full_url = base | append: path %}

      <a href="{{ full_url }}" target="_blank" class="sb-item">
        <div>
          <div class="sb-name">{{ block.settings.title }}</div>
          <div class="sb-path">{{ path }}</div>
        </div>
        
        <div style="display:flex; align-items:center; gap:10px;">
          {% if block.settings.status == 'ready' %}
            <span class="sb-status ready">Ready</span>
          {% else %}
            <span class="sb-status wip">WIP</span>
          {% endif %}
          <span class="sb-arrow">→</span>
        </div>
      </a>
    {% endfor %}
  </div>

</div>

{% schema %}
{
  "name": "Staging Link Manager",
  "settings": [
    {
      "type": "header",
      "content": "Configuration"
    },
    {
      "type": "text",
      "id": "base_url",
      "label": "Active Preview URL",
      "info": "Paste the generated preview link here. The code will automatically add https:// if you forget it.",
      "placeholder": "e.g. 7vge...shopifypreview.com"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Client Review Dashboard"
    },
    {
      "type": "textarea",
      "id": "info_text",
      "label": "Instructions",
      "default": "Click below to review the latest designs. Links open in a new tab."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Page Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Page Name", "default": "About Us" },
        { "type": "text", "id": "path", "label": "Page Path", "default": "/pages/about-us" },
        { "type": "select", "id": "status", "label": "Status", "options": [
          { "value": "ready", "label": "Ready" },
          { "value": "wip", "label": "WIP" }
        ], "default": "ready" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Staging Link Manager"
    }
  ]
}
{% endschema %}