{{ 'component-collection-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Dynamic Background & Spacing */
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .product-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 12px;
  }

  /* --- MOBILE DRAWER & HEADER STYLES --- */
  .mobile-filter-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .mobile-drawer-header { display: none; }
  .mobile-filter-overlay { display: none; }

  @media (max-width: 767px) {
    .collection-header {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 15px;
    }
    .cora-sort-select { flex-grow: 1; width: auto; height: 44px; }
    .product-count { display: none; }
    .collection-sidebar {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 85vh;
      background: #fff;
      z-index: 1000;
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -5px 20px rgba(0,0,0,0.1);
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      display: flex;
      flex-direction: column;
    }
    .collection-sidebar.open { transform: translateY(0); }
    .filter-wrapper { overflow-y: auto; padding: 20px; flex-grow: 1; }
    .mobile-drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 20px;
      border-bottom: 1px solid #eee;
      background: #fff;
      border-radius: 20px 20px 0 0;
    }
    .mobile-drawer-title { font-weight: 700; font-size: 16px; text-transform: uppercase; }
    .mobile-drawer-close { background: none; border: none; font-size: 24px; cursor: pointer; padding: 0; line-height: 1; }
    .mobile-filter-overlay {
      display: block;
      position: fixed;
      top: 0;
      left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 999;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s;
    }
    .mobile-filter-overlay.open { opacity: 1; visibility: visible; }
  }

  @media (min-width: 768px) {
    .mobile-filter-trigger { display: none; }
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 12px;
    }
    .collection-container { display: flex; align-items: flex-start; gap: 30px; }
    .collection-sidebar {
      position: -webkit-sticky;
      position: sticky;
      top: 20px;
      width: 250px;
      flex-shrink: 0;
      z-index: 10;
      transform: none !important;
      height: fit-content;
      border-radius: 0;
      box-shadow: none;
    }
    .collection-main { flex-grow: 1; width: 100%; }
  }
{%- endstyle -%}

<div class="collection-container" id="shopify-section-{{ section.id }}">
  <div class="mobile-filter-overlay" onclick="toggleFilterDrawer()"></div>

  <aside class="collection-sidebar" id="CollectionSidebar">
    <div class="mobile-drawer-header">
      <span class="mobile-drawer-title">Filters</span>
      <button class="mobile-drawer-close" onclick="toggleFilterDrawer()">&times;</button>
    </div>

    <div class="filter-wrapper">
      <form class="filter-form" id="CollectionFilterForm">
        {%- comment -%}
          MODIFIED: Manual "In-Stock" Filter that points to your collection
        {%- endcomment -%}
        <div class="availability-filter-pinned" style="margin-bottom: 20px;">
          <div class="filter-group">
            <details open>
              <summary class="filter-title">
                <span>Availability</span>
                <span class="icon-chevron"></span>
              </summary>
              <div class="filter-content">
                <ul class="filter-list">
                  <li class="filter-item">
                    <label class="filter-label" style="cursor:pointer;">
                      <input
                        type="checkbox"
                        class="in-stock-redirect"
                        {% if collection.handle == 'in-stock' %}
                          checked
                        {% endif %}
                        onclick="window.location.href='/collections/in-stock'"
                      >
                      <span>In stock</span>
                    </label>
                  </li>
                </ul>
              </div>
            </details>
          </div>
        </div>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <div class="sidebar-block sidebar-text" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h4>{{ block.settings.title }}</h4>
                {% endif %}
                <p>{{ block.settings.text }}</p>
              </div>
            {%- when 'image' -%}
              <div class="sidebar-block sidebar-image" {{ block.shopify_attributes }}>
                {% if block.settings.image %}
                  <img
                    src="{{ block.settings.image | img_url: '400x' }}"
                    alt="Promo"
                    loading="lazy"
                    style="width:100%; border-radius:8px;"
                  >
                {% endif %}
              </div>
            {%- when 'price_list' -%}
              {% render 'cora-filter-price-list', block: block %}
            {%- when 'filter_group' -%}
              {%- assign target_filter = block.settings.filter_name | downcase -%}
              {%- for filter in collection.filters -%}
                {%- assign current_filter = filter.label | downcase -%}
                {%- unless filter.param_name == 'filter.v.availability' -%}
                  {%- if current_filter == target_filter -%}
                    {% render 'cora-filter-item', filter: filter, block: block %}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- when 'tag_group' -%}
              <div class="filter-group" {{ block.shopify_attributes }}>
                <details
                  {% if block.settings.default_open %}
                    open
                  {% endif %}
                >
                  <summary class="filter-title">
                    <span>{{ block.settings.title }}</span>
                    <span class="icon-chevron"></span>
                  </summary>
                  <div class="filter-content">
                    <ul class="filter-list">
                      {%- assign custom_tags = block.settings.tag_list | split: '|' -%}
                      {%- for tag in custom_tags -%}
                        {%- assign clean_tag = tag | strip -%}
                        {%- if collection.all_tags contains clean_tag -%}
                          <li class="filter-item">
                            {%- if current_tags contains clean_tag -%}
                              {%- assign tag_html = clean_tag | link_to_remove_tag: clean_tag -%}
                              {%- assign tag_url = tag_html | split: 'href="' | last | split: '"' | first -%}
                              <a href="{{ tag_url }}" class="filter-label">
                                <input type="checkbox" checked onclick="this.parentElement.click();">
                                <span>{{ clean_tag }}</span>
                              </a>
                            {%- else -%}
                              {%- assign tag_html = clean_tag | link_to_add_tag: clean_tag -%}
                              {%- assign tag_url = tag_html | split: 'href="' | last | split: '"' | first -%}
                              <a href="{{ tag_url }}" class="filter-label">
                                <input type="checkbox" onclick="this.parentElement.click();">
                                <span>{{ clean_tag }}</span>
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
              </div>
            {%- when 'price_range' -%}
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'price_range' -%}
                  {% render 'cora-filter-item', filter: filter, block: block %}
                {%- endif -%}
              {%- endfor -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.show_remaining -%}
          {%- for filter in collection.filters -%}
            {%- assign rendered = false -%}
            {%- if filter.param_name == 'filter.v.availability' -%}{%- continue -%}{%- endif -%}
            {%- if filter.type == 'price_range' -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'price_range' or block.type == 'price_list' -%}
                  {% assign rendered = true %}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- assign b_name = block.settings.filter_name | downcase -%}
                {%- assign f_label = filter.label | downcase -%}
                {%- if block.type == 'filter_group' and b_name == f_label -%}{% assign rendered = true %}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if rendered == false -%}
              {%- if filter.type == 'price_range' -%}
                {% render 'cora-filter-price', filter: filter, default_open: false %}
              {%- else -%}
                {% render 'cora-filter-item', filter: filter, default_open: false %}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </form>
      <div class="filter-header" style="font-family: Assistant;">
        <span class="filter-header-title">Filters</span>
        <a href="{{ collection.url }}" class="filter-clear-all">Clear All</a>
      </div>
    </div>
  </aside>

  <div class="collection-main">
    <div class="collection-header">
      <button class="mobile-filter-trigger" onclick="toggleFilterDrawer()" aria-label="Open Filters">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4H14M4 8H12M6 12H10" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <span class="product-count">{{ collection.products_count }} Products</span>

      <select id="sort-by" onchange="location = this.value;" class="cora-sort-select">
        {% for option in collection.sort_options %}
          {%- unless option.value contains 'title' or option.value contains 'created-ascending' -%}
            <option
              value="?sort_by={{ option.value }}"
              {% if option.value == collection.sort_by %}
                selected
              {% endif %}
            >
              {%- if option.value == 'created-descending' -%}Newest{%- else -%}{{ option.name }}{%- endif -%}
            </option>
          {%- endunless -%}
        {% endfor %}
      </select>
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="product-grid">
        {% for product in collection.products %}
          <div class="product-card">
            <div class="product-image-wrapper">
              <a href="{{ product.url }}">
                {%- assign has_instock_tag = false -%}
                {%- for tag in product.tags -%}
                  {%- assign clean_tag = tag | downcase | replace: '-', '' | replace: ' ', '' -%}
                  {%- if clean_tag == 'instock' -%}
                    {%- assign has_instock_tag = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if has_instock_tag -%}
                  <span class="product-badge" style="background: #E87034;">In Stock</span>
                {%- elsif product.compare_at_price > product.price -%}
                  {%- assign discount = product.compare_at_price
                    | minus: product.price
                    | times: 100.0
                    | divided_by: product.compare_at_price
                    | round
                  -%}
                  <span class="product-badge">{{ discount }}% OFF</span>
                {%- endif -%}

                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
            </div>
            <div class="product-info">
              <h3>
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              {%- assign displayed_price = product.price -%}
              {%- assign displayed_compare = product.compare_at_price -%}
              <div class="product-price">
                <span>{{ displayed_price | money }}</span>
                {% if displayed_compare > displayed_price %}
                  <span class="price-compare">{{ displayed_compare | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="cora-pagination">
          <div class="cora-pagination__left">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="cora-pagination__btn cora-pagination__prev">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                  <path d="M8.84182 3.13514C9.04327 3.32401 9.05348 3.64042 8.86462 3.84188L5.43521 7.49991L8.86462 11.1579C9.05348 11.3594 9.04327 11.6758 8.84182 11.8647C8.64036 12.0535 8.32394 12.0433 8.13508 11.8419L4.38508 7.84188C4.20477 7.64955 4.20477 7.35027 4.38508 7.15794L8.13508 3.15794C8.32394 2.95648 8.64036 2.94628 8.84182 3.13514Z" fill="currentColor"/>
                </svg>
                <span>Previous</span>
              </a>
            {% endif %}
          </div>
          <div class="cora-pagination__list">
            {% for part in paginate.parts %}
              {% if part.is_link -%}
                <a href="{{ part.url }}" class="cora-pagination__item">{{ part.title }}</a>
              {% else -%}
                <span class="cora-pagination__item {% if part.title == paginate.current_page %}cora-pagination__item--active{% endif %}">
                  {{- part.title -}}
                </span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="cora-pagination__right">
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="cora-pagination__btn cora-pagination__next">
                <span>Next</span>
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none">
                  <path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

<script>
  function toggleFilterDrawer() {
    const sidebar = document.getElementById('CollectionSidebar');
    const overlay = document.querySelector('.mobile-filter-overlay');
    if (sidebar && overlay) {
      sidebar.classList.toggle('open');
      overlay.classList.toggle('open');
      document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    const filterForm = document.getElementById('CollectionFilterForm');
    if (filterForm) {
      filterForm.addEventListener('change', function (e) {
        // Prevent auto-submit if the click was on the in-stock redirect
        if (e.target.classList.contains('in-stock-redirect')) return;
        this.submit();
      });
    }
  });
</script>

{% schema %}
{
  "name": "Advanced Filter Grid",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop Columns"
    },
    { "type": "range", "id": "columns_mobile", "min": 2, "max": 4, "step": 1, "default": 2, "label": "Mobile Columns" },
    { "type": "checkbox", "id": "show_remaining", "label": "Auto-show remaining filters", "default": true },
    { "type": "header", "content": "Spacing & Color" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "default": 60, "label": "Top Padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "default": 60, "label": "Bottom Padding" }
  ],
  "blocks": [
    {
      "type": "filter_group",
      "name": "Filter Group",
      "settings": [
        { "type": "text", "id": "filter_name", "label": "Filter Label", "default": "Color" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "tag_group",
      "name": "Tag List (Manual)",
      "settings": [
        { "type": "text", "id": "title", "label": "Filter Title", "default": "Filter By Material" },
        { "type": "textarea", "id": "tag_list", "label": "Tags to Show", "default": "Wool|Jute|Cotton" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "price_range",
      "name": "Price Slider",
      "settings": [{ "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }]
    },
    {
      "type": "price_list",
      "name": "Price List (Radio)",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Price Range" },
        {
          "type": "textarea",
          "id": "price_ranges",
          "label": "Price Ranges",
          "default": "0-20000:Under ₹20,000\n20000-50000:₹20,000 - ₹50,000"
        },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Text Box",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Need Help?" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Call us at..." }
      ]
    },
    {
      "type": "image",
      "name": "Promo Image",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [{ "name": "Advanced Filter Grid" }]
}
{% endschema %}
