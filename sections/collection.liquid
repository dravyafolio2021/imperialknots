{{ 'component-collection-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Dynamic Background & Spacing */
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
     #shopify-section-{{ section.id }} .product-grid {
      /* Override for Desktop */
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 12px;
    }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-grid {
      /* Override for Desktop */
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 12px;
    }
  }
{%- endstyle -%}

<div class="collection-container" id="shopify-section-{{ section.id }}">
  {%- comment -%} SIDEBAR (Block-Based) {%- endcomment -%}
  <aside class="collection-sidebar">
    <div class="filter-wrapper">
      <div class="filter-header">
        <span class="filter-header-title">Filters</span>
        <a href="{{ collection.url }}" class="filter-clear-all">Clear All</a>
      </div>

      <form class="filter-form">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
              {%- comment -%} BLOCK: TEXT / NOTE {%- endcomment -%}
            {%- when 'text' -%}
              <div class="sidebar-block sidebar-text" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h4>{{ block.settings.title }}</h4>
                {% endif %}
                <p>{{ block.settings.text }}</p>
              </div>

              {%- comment -%} BLOCK: PROMO IMAGE {%- endcomment -%}
            {%- when 'image' -%}
              <div class="sidebar-block sidebar-image" {{ block.shopify_attributes }}>
                {% if block.settings.image %}
                  <img
                    src="{{ block.settings.image | img_url: '400x' }}"
                    alt="Promo"
                    loading="lazy"
                    style="width:100%; border-radius:8px;"
                  >
                {% endif %}
              </div>

              {%- comment -%} BLOCK: SPECIFIC FILTER (e.g. Color) {%- endcomment -%}
            {%- when 'filter_group' -%}
              {%- assign target_filter = block.settings.filter_name | downcase -%}
              {%- for filter in collection.filters -%}
                {%- assign current_filter = filter.label | downcase -%}
                {%- if current_filter == target_filter -%}
                  {% render 'cora-filter-item', filter: filter, block: block %}
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} BLOCK: PRICE RANGE {%- endcomment -%}
            {%- when 'price_range' -%}
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'price_range' -%}
                  {% render 'cora-filter-item', filter: filter, block: block %}
                {%- endif -%}
              {%- endfor -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.show_remaining -%}
          {%- for filter in collection.filters -%}
            {%- assign rendered = false -%}

            {%- comment -%} Check if this filter was already rendered by a block {%- endcomment -%}
            {%- if filter.type == 'price_range' -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'price_range' -%}{% assign rendered = true %}{%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- comment -%} FIX: Added pipes and assigned variables for safe comparison {%- endcomment -%}
                {%- assign b_name = block.settings.filter_name | downcase -%}
                {%- assign f_label = filter.label | downcase -%}

                {%- if block.type == 'filter_group' and b_name == f_label -%}
                  {% assign rendered = true %}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if rendered == false -%}
              {% render 'cora-filter-item', filter: filter, default_open: false %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </form>
    </div>
  </aside>

  {%- comment -%} MAIN PRODUCT GRID {%- endcomment -%}
  <div class="collection-main">
    <div class="collection-header">
      <span class="product-count">{{ collection.products_count }} Products</span>
      <select id="sort-by" onchange="location = this.value;" class="cora-sort-select">
        {% for option in collection.sort_options %}
          <option
            value="?sort_by={{ option.value }}"
            {% if option.value == collection.sort_by %}
              selected
            {% endif %}
          >
            {{ option.name }}
          </option>
        {% endfor %}
      </select>
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="product-grid">
  {% for product in collection.products %}
    <div class="product-card">
      <div class="product-image-wrapper">
        <a href="{{ product.url }}">
          {% if product.compare_at_price > product.price -%}
            <span class="product-badge">Sale</span>
          {%- endif %}
          
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
              alt="{{ product.title }}"
              loading="lazy"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </a>
      </div>
      <div class="product-info">
        <h3>
          <a href="{{ product.url }}">{{ product.title }}</a>
        </h3>
        <div class="product-price">
          <span>{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="price-compare">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>
      {% comment %} <div class="product-grid" style="grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);">
        {% for product in collection.products %}
          <div class="product-card">
            <div class="product-image-wrapper">
              <a href="{{ product.url }}">
                {% if product.compare_at_price > product.price -%}
                  <span class="product-badge">Sale</span>
                {%- endif %}
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}"
                    alt="{{ product.title }}"
                    loading="lazy"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
            </div>
            <div class="product-info">
              <h3>
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="product-price">
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div> {% endcomment %}

      {% if paginate.pages > 1 %}
        <div class="cora-pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Advanced Filter Grid",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop Columns"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Mobile Columns"
    },
    {
      "type": "checkbox",
      "id": "show_remaining",
      "label": "Auto-show remaining filters",
      "default": true,
      "info": "Shows filters not explicitly added as blocks at the bottom."
    },
    { "type": "header", "content": "Spacing & Color" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "default": 60, "label": "Top Padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "default": 60, "label": "Bottom Padding" }
  ],
  "blocks": [
    {
      "type": "filter_group",
      "name": "Filter Group",
      "settings": [
        {
          "type": "text",
          "id": "filter_name",
          "label": "Filter Label",
          "info": "Must match exact name in Search & Discovery (e.g. 'Color')",
          "default": "Color"
        },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": true }
      ]
    },
    {
      "type": "price_range",
      "name": "Price Slider",
      "settings": [{ "type": "checkbox", "id": "default_open", "label": "Open by default", "default": true }]
    },
    {
      "type": "text",
      "name": "Text Box",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Need Help?" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Call us at..." }
      ]
    },
    {
      "type": "image",
      "name": "Promo Image",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [{ "name": "Advanced Filter Grid" }]
}
{% endschema %}
