{{ 'component-collection-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .product-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 12px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      gap: 12px;
    }
  }
{%- endstyle -%}

<div class="collection-container" id="shopify-section-{{ section.id }}">
  <aside class="collection-sidebar">
    <div class="filter-wrapper">
      <form class="filter-form">
        
        {%- comment -%} 
          =============================================
          1. AVAILABILITY (Pinned Top, Always Open) 
          =============================================
        {%- endcomment -%}
        {%- for filter in collection.filters -%}
          {%- if filter.param_name == 'filter.v.availability' -%}
            <div class="availability-pinned">
              {% render 'cora-filter-item', filter: filter, default_open: true %}
            </div>
            <style>
              .availability-pinned li:has(input[value="0"]) { display: none !important; }
            </style>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} 
          =============================================
          2. PRICE LIST (Pinned Second) 
          =============================================
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'price_list' -%}
            {% render 'cora-filter-price-list', block: block %}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} 
          =============================================
          3. REMAINING BLOCKS (Skip Price List) 
          =============================================
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <div class="sidebar-block sidebar-text" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}<h4>{{ block.settings.title }}</h4>{% endif %}
                <p>{{ block.settings.text }}</p>
              </div>

            {%- when 'image' -%}
              <div class="sidebar-block sidebar-image" {{ block.shopify_attributes }}>
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | img_url: '400x' }}" alt="Promo" style="width:100%; border-radius:8px;">
                {% endif %}
              </div>

            {%- comment -%} SKIP PRICE LIST (Rendered Above) {%- endcomment -%}
            {%- when 'price_list' -%}
              {%- continue -%}

            {%- when 'filter_group' -%}
              {%- assign target_filter = block.settings.filter_name | downcase -%}
              {%- for filter in collection.filters -%}
                {%- assign current_filter = filter.label | downcase -%}
                {%- unless filter.param_name == 'filter.v.availability' -%}
                  {%- if current_filter == target_filter -%}
                    {% render 'cora-filter-item', filter: filter, block: block %}
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}

            {%- when 'tag_group' -%}
              <div class="filter-group" {{ block.shopify_attributes }}>
                <details {% if block.settings.default_open %}open{% endif %}>
                  <summary class="filter-title">
                    <span>{{ block.settings.title }}</span>
                    <span class="icon-chevron"></span>
                  </summary>
                  <div class="filter-content">
                    <ul class="filter-list">
                      {%- assign custom_tags = block.settings.tag_list | split: '|' -%}
                      {%- for tag in custom_tags -%}
                        {%- assign clean_tag = tag | strip -%}
                        {%- if collection.all_tags contains clean_tag -%}
                          <li class="filter-item">
                            {%- if current_tags contains clean_tag -%}
                              {%- assign tag_html = clean_tag | link_to_remove_tag: clean_tag -%}
                              <a href="{{ tag_html | split: 'href="' | last | split: '"' | first }}" class="filter-label">
                                <input type="checkbox" checked onclick="this.parentElement.click();">
                                <span>{{ clean_tag }}</span>
                              </a>
                            {%- else -%}
                              {%- assign tag_html = clean_tag | link_to_add_tag: clean_tag -%}
                              <a href="{{ tag_html | split: 'href="' | last | split: '"' | first }}" class="filter-label">
                                <input type="checkbox" onclick="this.parentElement.click();">
                                <span>{{ clean_tag }}</span>
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
              </div>

            {%- when 'price_range' -%}
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'price_range' -%}
                  {% render 'cora-filter-item', filter: filter, block: block %}
                {%- endif -%}
              {%- endfor -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%} 
          =============================================
          4. CLEANUP (Catch-all)
          =============================================
        {%- endcomment -%}
        {%- if section.settings.show_remaining -%}
          {%- for filter in collection.filters -%}
            {%- assign rendered = false -%}

            {%- if filter.param_name == 'filter.v.availability' -%}{%- continue -%}{%- endif -%}

            {%- if filter.type == 'price_range' -%}
               {%- for block in section.blocks -%}
                  {%- if block.type == 'price_range' or block.type == 'price_list' -%}{% assign rendered = true %}{%- endif -%}
               {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks -%}
                {%- assign b_name = block.settings.filter_name | downcase -%}
                {%- assign f_label = filter.label | downcase -%}
                {%- if block.type == 'filter_group' and b_name == f_label -%}{% assign rendered = true %}{%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if rendered == false -%}
               {% render 'cora-filter-item', filter: filter, default_open: true %}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

      </form>
      <div class="filter-header">
        <span class="filter-header-title">Filters</span>
        <a href="{{ collection.url }}" class="filter-clear-all">Clear All</a>
      </div>
    </div>
  </aside>

  {%- comment -%} MAIN PRODUCT GRID {%- endcomment -%}
  <div class="collection-main">
    <div class="collection-header">
      <span class="product-count">{{ collection.products_count }} Products</span>
      <select id="sort-by" onchange="location = this.value;" class="cora-sort-select">
        {% for option in collection.sort_options %}
          <option value="?sort_by={{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {% endfor %}
      </select>
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="product-grid">
        {% for product in collection.products %}
          <div class="product-card">
            <div class="product-image-wrapper">
              <a href="{{ product.url }}">
                {% if product.compare_at_price > product.price -%}<span class="product-badge">Sale</span>{%- endif %}
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
            </div>
            <div class="product-info">
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="product-price">
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="cora-pagination">
          <div class="cora-pagination__left">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="cora-pagination__btn">Previous</a>
            {% endif %}
          </div>
          <div class="cora-pagination__list">
            {% for part in paginate.parts %}
              {% if part.is_link %}<a href="{{ part.url }}" class="cora-pagination__item">{{ part.title }}</a>
              {% else %}<span class="cora-pagination__item cora-pagination__item--active">{{ part.title }}</span>{% endif %}
            {% endfor %}
          </div>
          <div class="cora-pagination__right">
            {% if paginate.next %}<a href="{{ paginate.next.url }}" class="cora-pagination__btn">Next</a>{% endif %}
          </div>
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Advanced Filter Grid",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "default": 16, "label": "Products per page" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "default": 3, "label": "Desktop Columns" },
    { "type": "range", "id": "columns_mobile", "min": 2, "max": 4, "default": 2, "label": "Mobile Columns" },
    { "type": "checkbox", "id": "show_remaining", "label": "Auto-show remaining filters", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "default": 60, "label": "Top Padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "default": 60, "label": "Bottom Padding" }
  ],
  "blocks": [
    {
      "type": "filter_group",
      "name": "Filter Group",
      "settings": [
        { "type": "text", "id": "filter_name", "label": "Filter Label", "default": "Color" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": true }
      ]
    },
    {
      "type": "tag_group",
      "name": "Tag List (Manual)",
      "settings": [
        { "type": "text", "id": "title", "label": "Filter Title", "default": "Material" },
        { "type": "textarea", "id": "tag_list", "label": "Tags (Separated by |)", "default": "Cotton|Wool" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": true }
      ]
    },
    { "type": "price_range", "name": "Standard Slider", "settings": [] },
    {
      "type": "price_list",
      "name": "Price List (Radio)",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Price Range" },
        { "type": "textarea", "id": "price_ranges", "label": "Ranges", "default": "0-20000:Under ₹20k\n20000-50000:₹20k - ₹50k" },
        { "type": "checkbox", "id": "default_open", "label": "Open by default", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "Text Box",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "image",
      "name": "Promo Image",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [{ "name": "Advanced Filter Grid" }]
}
{% endschema %}