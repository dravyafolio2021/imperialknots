{% comment %}
  Custom Collections Grid (clean + container + modular)
  - All UI CSS lives in assets/collections-grid-custom.css
  - Only Section-specific background/padding/gap overrides are in the <style> block
{% endcomment %}

{{ 'collections-grid-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Section Background & Padding */
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color_desktop | default: '#ffffff' }};
    {% if section.settings.bg_image_desktop %}
      background-image: url({{ section.settings.bg_image_desktop | img_url: '2000x' }});
      background-size: cover;
      background-position: center;
    {% endif %}
    padding-top: {{ section.settings.padding_top_desktop | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 60 }}px;
    width: 100%;
    display: flex;
    justify-content:center;
    
  }

  /* Grid gap override */
  #shopify-section-{{ section.id }} .collections-grid {
    --grid-gap: {{ section.settings.grid_gap_desktop | default: 20 }}px;
    --card-aspect: {{ section.settings.card_aspect | default: 125 }}%;
    --card-radius: {{ section.settings.card_radius | default: 12 }}px;
    --card-shadow: {{ section.settings.card_shadow | default: "0 8px 22px rgba(11,20,23,0.06)" }};
  }

  /* Tablet overrides */
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_tablet | default: 40 }}px;
      padding-bottom: {{ section.settings.padding_bottom_tablet | default: 40 }}px;
      margin-left: 0;
      margin-right: 0;
      max-width:1200px;
      {% if section.settings.bg_image_tablet %}
        background-image: url({{ section.settings.bg_image_tablet | img_url: '1200x' }});
      {% endif %}
    }
    #shopify-section-{{ section.id }} .collections-grid {
      --grid-gap: {{ section.settings.grid_gap_tablet | default: 16 }}px;
    }
  }

  /* Mobile overrides */
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 24 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 24 }}px;
      {% if section.settings.bg_image_mobile %}
        background-image: url({{ section.settings.bg_image_mobile | img_url: '800x' }});
      {% endif %}
    }
    #shopify-section-{{ section.id }} .collections-grid {
      --grid-gap: {{ section.settings.grid_gap_mobile | default: 12 }}px;
    }
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}" class="collections-grid__section">
  <div class="collections-grid__container">
    <div
      class="collections-grid"
      data-columns-desktop="{{ section.settings.columns_desktop }}"
      data-columns-tablet="{{ section.settings.columns_tablet }}"
      data-columns-mobile="{{ section.settings.columns_mobile }}"
    >
      {% for collection in collections %}
        <a class="collections-grid__card" href="{{ collection.url }}">
          <div class="collections-grid__media">
            {% if collection.featured_image %}
              {% render 'image',
                class: 'collections-grid__img',
                image: collection.featured_image,
                width: 1200,
                height: 1200,
                crop: section.settings.image_crop
              %}
            {% else %}
              <!-- Fallback image -->
              <img
                class="collections-grid__img"
                src="/mnt/data/47923d28-a8b4-4cbd-bf6c-3671aa8f51e9.png"
                alt="{{ collection.title }}"
                loading="lazy" width="" height=""
              >
            {% endif %}
          </div>

          <div class="collections-grid__content">
            <h3 class="collections-grid__title">{{ collection.title }}</h3>

            {% if section.settings.show_description and collection.description %}
              <p class="collections-grid__desc">
                {{ collection.description | strip_html | truncatewords: section.settings.description_words }}
              </p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections Grid ",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "number", "id": "description_words", "label": "Description words",   "default": 15 },

    { "type": "number", "id": "columns_desktop", "label": "Desktop columns",   "default": 3 },
    { "type": "number", "id": "columns_tablet", "label": "Tablet columns", "default": 2 },
    { "type": "number", "id": "columns_mobile", "label": "Mobile columns", "default": 1 },

    {
      "type": "range",
      "id": "grid_gap_desktop",
      "label": "Desktop gap",
      "min": 6,
      "max": 36,
      "step": 2,
      "default": 20
    },
    { "type": "range", "id": "grid_gap_tablet", "label": "Tablet gap", "min": 6, "max": 28, "step": 2, "default": 16 },
    { "type": "range", "id": "grid_gap_mobile", "label": "Mobile gap", "min": 6, "max": 20, "step": 2, "default": 12 },

    {
      "type": "range",
      "id": "card_aspect",
      "label": "Card aspect ratio %",
      "min": 100,
      "max": 200,
      "step": 1,
      "default": 125
    },
    { "type": "range", "id": "card_radius", "label": "Card radius (px)", "min": 0, "max": 48, "default": 14 },
    { "type": "text", "id": "card_shadow", "label": "Card Shadow CSS", "default": "0 8px 22px rgba(11,20,23,0.06)" },

    {
      "type": "select",
      "id": "image_crop",
      "label": "Image crop",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },

    { "type": "color", "id": "bg_color_desktop", "label": "BG Color Desktop", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "BG Image Desktop" },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
     
      "default": 60
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      
      "default": 60
    },

    { "type": "image_picker", "id": "bg_image_tablet", "label": "BG Image Tablet" },
    {
      "type": "number",
      "id": "padding_top_tablet",
      "label": "Padding top tablet",
      
      "default": 40
    },
    {
      "type": "number",
      "id": "padding_bottom_tablet",
      "label": "Padding bottom tablet",
    
      "default": 40
    },

    { "type": "image_picker", "id": "bg_image_mobile", "label": "BG Image Mobile" },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
  
      "default": 24
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      
      "default": 24
    }
  ],
  "presets": [{ "name": "Collections Grid (Container)" }]
}
{% endschema %}
