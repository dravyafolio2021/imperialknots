{% comment %}
  SECTION: CORA ABOUT HERO
  Purpose: Large image banner with text overlay.
{% endcomment %}

{{ 'cora-about-hero.css' | asset_url | stylesheet_tag }}

<div class="cah-section">
  
  <div class="cah-bg">
    {%- if section.settings.image_desktop != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | img_url: '800x' }}">
        {%- endif -%}
        <img 
          src="{{ section.settings.image_desktop | img_url: '2000x' }}" 
          alt="{{ section.settings.heading | escape }}" 
         width="" height="" loading="eager"
        >
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="cah-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="cah-content">
    <h1 class="cah-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <div class="cah-subtitle">{{ section.settings.subheading }}</div>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (Mobile)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 30,
      "unit": "%",
      "label": "Overlay Darkness"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey in Every Thread"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted in India. Cherished Worldwide."
    }
  ],
  "presets": [
    {
      "name": "About Hero", "category": "About Us"
    }
  ]
}
{% endschema %}