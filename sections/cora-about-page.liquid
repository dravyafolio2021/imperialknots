{% comment %}
  SECTION: CORA ABOUT BUILDER
  Usage: Drag and drop blocks to build a story page.
{% endcomment %}

{{ 'cora-about-page.css' | asset_url | stylesheet_tag }}

<div class="cap-section">
  
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      
      {%- comment -%} HERO BANNER {%- endcomment -%}
      {%- when 'hero' -%}
        <div class="cap-hero" {{ block.shopify_attributes }}>
          <div class="cap-hero-bg">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: '2000x' }}" height="" width="" loading="eager" alt="{{ block.settings.heading }}">
            {%- endif -%}
          </div>
          <div class="cap-hero-overlay" style="opacity: {{ block.settings.overlay_opacity }}%;"></div>
          <div class="cap-hero-content">
            <h1 class="cap-hero-title">{{ block.settings.heading }}</h1>
            <div class="cap-hero-text">{{ block.settings.text }}</div>
          </div>
        </div>

      {%- comment -%} IMAGE WITH TEXT {%- endcomment -%}
      {%- when 'image_text' -%}
        <div class="cap-container" {{ block.shopify_attributes }}>
          <div class="cap-iwt {% if block.settings.layout == 'right' %}reverse{% endif %}">
            <div class="cap-iwt-image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | img_url: '1000x' }}"  height="" width="" loading="lazy" alt="{{ block.settings.heading }}">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="cap-iwt-content">
              {%- if block.settings.kicker != blank -%}
                <div class="cap-iwt-kicker">{{ block.settings.kicker }}</div>
              {%- endif -%}
              <h2 class="cap-iwt-title">{{ block.settings.heading }}</h2>
              <div class="cap-iwt-desc">{{ block.settings.text }}</div>
            </div>
          </div>
        </div>

      {%- comment -%} STATS ROW {%- endcomment -%}
      {%- when 'stats' -%}
        <div class="cap-stats" {{ block.shopify_attributes }}>
          <div class="cap-container cap-stats-grid">
            <div>
              <div class="cap-stat-number">{{ block.settings.stat_1_num }}</div>
              <div class="cap-stat-label">{{ block.settings.stat_1_txt }}</div>
            </div>
            <div>
              <div class="cap-stat-number">{{ block.settings.stat_2_num }}</div>
              <div class="cap-stat-label">{{ block.settings.stat_2_txt }}</div>
            </div>
            <div>
              <div class="cap-stat-number">{{ block.settings.stat_3_num }}</div>
              <div class="cap-stat-label">{{ block.settings.stat_3_txt }}</div>
            </div>
          </div>
        </div>

    {%- endcase -%}
  {%- endfor -%}

</div>

{% schema %}
{
  "name": "About Page Builder",
  "settings": [],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our Story" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Handcrafted with passion since 1990." },
        { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 10, "default": 30, "label": "Overlay %" }
      ]
    },
    {
      "type": "image_text",
      "name": "Image with Text",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "layout", "label": "Image Position", "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ], "default": "left" 
        },
        { "type": "text", "id": "kicker", "label": "Small Label", "default": "Craftsmanship" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Woven by History" },
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Tell your brand story here.</p>" }
      ]
    },
    {
      "type": "stats",
      "name": "Stats Row",
      "settings": [
        { "type": "header", "content": "Stat 1" },
        { "type": "text", "id": "stat_1_num", "default": "1990", "label": "Number" },
        { "type": "text", "id": "stat_1_txt", "default": "Established", "label": "Label" },
        { "type": "header", "content": "Stat 2" },
        { "type": "text", "id": "stat_2_num", "default": "50k+", "label": "Number" },
        { "type": "text", "id": "stat_2_txt", "default": "Happy Clients", "label": "Label" },
        { "type": "header", "content": "Stat 3" },
        { "type": "text", "id": "stat_3_num", "default": "100%", "label": "Number" },
        { "type": "text", "id": "stat_3_txt", "default": "Handmade", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Page Builder",
      "blocks": [
        { "type": "hero" },
        { "type": "image_text" },
        { "type": "stats" }
      ]
    }
  ]
}
{% endschema %}