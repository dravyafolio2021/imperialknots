{% comment %}
  CORA BLOG GRID - With Bottom Button
{% endcomment %}

{{ 'cora-blog-grid_v2.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #CoraBlog-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --accent-color: {{ section.settings.accent_color }};
    
    --pt-mob: {{ section.settings.padding_top_mobile }}px;
    --pb-mob: {{ section.settings.padding_bottom_mobile }}px;
    --pt-desk: {{ section.settings.padding_top_desktop }}px;
    --pb-desk: {{ section.settings.padding_bottom_desktop }}px;
  }
{%- endstyle -%}

<div id="CoraBlog-{{ section.id }}" class="cora-blog-section">
  <div class="cora-container">
    
    {% if section.settings.heading != blank %}
      <div class="cora-section-header">
        <h2 class="cora-section-title">{{ section.settings.heading }}</h2>
        {% if section.settings.show_view_all_top %}
          <a href="{{ blogs[section.settings.blog].url }}" class="cora-section-link">View All Articles &rarr;</a>
        {% endif %}
      </div>
    {% endif %}
     <header class="cora-product-grid__header">
       <h2 class="cora-product-section-grid__title">Our Blogs</h2>
           
          <p class="cora-product-grid__description">Expore our educational Content</p>
        </header>

    <div class="cora-blog-grid">
      {% assign blog_handle = section.settings.blog %}
      {% assign limit = section.settings.post_limit %}

      {% if blog_handle != blank and blogs[blog_handle].articles_count > 0 %}
        
        {% for article in blogs[blog_handle].articles limit: limit %}
          <a href="{{ article.url }}" class="cora-blog-card">
            
            <div class="cora-blog-img-wrapper">
              {% if article.image %}
                {{ article.image | image_url: width: 600 | image_tag: class: 'cora-blog-img', loading: 'lazy' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'cora-blog-img' }}
              {% endif %}
            </div>

            <div class="cora-blog-meta">
              {{ article.published_at | date: "%b %d, %Y" }}
              {% if section.settings.show_author %} • {{ article.author }} {% endif %}
            </div>

            <h3 class="cora-blog-title">{{ article.title }}</h3>

            {% if section.settings.show_excerpt %}
              <div class="cora-blog-excerpt">
                {% if article.excerpt.size > 0 %}
                  {{ article.excerpt | strip_html }}
                {% else %}
                  {{ article.content | strip_html | truncatewords: 25 }}
                {% endif %}
              </div>
            {% endif %}

            <span class="cora-read-more">Read More &rarr;</span>

          </a>
        {% endfor %}

      {% else %}
        {% for i in (1..3) %}
          <div class="cora-blog-card">
            <div class="cora-blog-img-wrapper">
              {{ 'image' | placeholder_svg_tag: 'cora-blog-img' }}
            </div>
            <div class="cora-blog-meta">May 01, 2025 • 3 min read</div>
            <h3 class="cora-blog-title">Example Blog Post Title</h3>
            <div class="cora-blog-excerpt">This is example text that shows what the blog post excerpt will look like on your live store...</div>
            <span class="cora-read-more">Read More &rarr;</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.show_bottom_btn %}
      <div class="cora-blog-footer">
        <a href="{{ blogs[section.settings.blog].url | default: '#' }}" class="cora-btn_blog">
          {{ section.settings.btn_text }}
        </a>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Cora Blog Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest from our Journal" },
    { "type": "blog", "id": "blog", "label": "Select Blog Category" },
    { "type": "range", "id": "post_limit", "min": 3, "max": 9, "step": 3, "label": "Number of Posts", "default": 3 },
    { "type": "select", "id": "text_alignment", "label": "Heading Alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },

    { "type": "header", "content": "Buttons & Links" },
    { "type": "checkbox", "id": "show_view_all_top", "label": "Show Top Text Link", "default": false },
    { "type": "checkbox", "id": "show_bottom_btn", "label": "Show Bottom Button", "default": true },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "View All Posts" },

    { "type": "header", "content": "Content Options" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show Excerpt", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show Author Name", "default": false },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#222222" },
    { "type": "color", "id": "accent_color", "label": "Accent / Button Color", "default": "#E87034" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 100, "default": 60, "unit": "px", "label": "Top Padding" },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 100, "default": 60, "unit": "px", "label": "Bottom Padding" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "default": 40, "unit": "px", "label": "Mobile Top" },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "default": 40, "unit": "px", "label": "Mobile Bottom" }
  ],
  "presets": [
    {
      "name": "Cora Blog Grid V2"
    }
  ]
}
{% endschema %}