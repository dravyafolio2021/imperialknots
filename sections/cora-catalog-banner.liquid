{{ 'cora-catalog-banner.css' | asset_url | stylesheet_tag }}

<section
  id="cora-catalog-banner-{{ section.id }}"
  class="cora-catalog-banner"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Catalog banner' }}"
  style="
    padding-top: {{ section.settings.pt_desktop | default: 60 }}px;
    padding-bottom: {{ section.settings.pb_desktop | default: 4 }}px;
    
    {% if section.settings.bg_image_desktop != blank %}
      background-image: url('{{ section.settings.bg_image_desktop | image_url: '2000x' }}');

    {% endif %}
    background-size: cover;
    background-position: center;
  "
>
  <div class="cora-catalog-banner__inner {% if section.settings.text_align == 'left' %}align-left{% elsif section.settings.text_align == 'right' %}align-right{% else %}align-center{% endif %}">
    <h1 class="cora-catalog-banner__heading">
      {{ section.settings.heading | default: 'Product Catalog' }}
    </h1>

    {% if section.settings.subheading != blank %}
      <p class="cora-catalog-banner__subheading" style="color: {{ section.settings.text_color | default: '#000' }};">
        {{ section.settings.subheading }}
      </p>
    {% endif %}
  </div>

  <style>
    #shopify-section-{{ section.id }}{
      background-color:  {{ section.settings.bg_color |  default: '#F0EBE4'}} ;
    }
    /* mobile background override (keeps code minimal in-liquid - desktop handled inline above) */
    @media (max-width: 768px) {
      #cora-catalog-banner-{{ section.id }} {
        padding-top: {{ section.settings.pt_mobile | default: 40 }}px;
        padding-bottom: {{ section.settings.pb_mobile | default: 40 }}px;
        {% if section.settings.bg_image_mobile != blank %}
          background-image: url('{{ section.settings.bg_image_mobile | image_url: "1000x" }}');
        {% endif %}
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Cora — Catalog Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product Catalog" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Browse our complete collection of handcrafted luxury rugs. Each piece is woven by skilled Indian artisans, blending traditional craftsmanship with contemporary design."
    },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#000000" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Background & Spacing" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#F0EBE4" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Desktop background image" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Mobile background image" },

    {
      "type": "range",
      "id": "pt_desktop",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "pb_desktop",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "pt_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "pb_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 40
    }
  ],
  "presets": [{ "name": "Catalog Banner", "category": "Catalog Page" }]
}
{% endschema %}
