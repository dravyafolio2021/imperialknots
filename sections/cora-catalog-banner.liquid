{{ 'cora-catalog-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #cora-catalog-banner-{{ section.id }} {
    --pt-desktop: {{ section.settings.pt_desktop }}px;
    --pb-desktop: {{ section.settings.pb_desktop }}px;
    --pt-mobile: {{ section.settings.pt_mobile }}px;
    --pb-mobile: {{ section.settings.pb_mobile }}px;
    
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    
    /* Overlay Logic */
    --overlay-color: {{ section.settings.overlay_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    /* Background Image Logic */
    {% if section.settings.bg_image_desktop != blank %}
      --bg-image: url('{{ section.settings.bg_image_desktop | img_url: '2000x' }}');
    {% else %}
      --bg-image: none;
    {% endif %}
  }

  /* Mobile Image Override */
  {% if section.settings.bg_image_mobile != blank %}
    @media (max-width: 768px) {
      #cora-catalog-banner-{{ section.id }} {
        --bg-image: url('{{ section.settings.bg_image_mobile | img_url: '1000x' }}');
      }
    }
  {% endif %}
{%- endstyle -%}

<section
  id="cora-catalog-banner-{{ section.id }}"
  class="cora-catalog-banner"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Catalog banner' }}"
>
  <div class="cora-banner-overlay"></div>

  <div class="cora-catalog-banner__inner {% if section.settings.text_align == 'left' %}align-left{% elsif section.settings.text_align == 'right' %}align-right{% else %}align-center{% endif %}">
    
    <h1 class="cora-catalog-banner__heading">
      {{ section.settings.heading | default: 'Product Catalog' }}
    </h1>

    {% if section.settings.subheading != blank %}
      <p class="cora-catalog-banner__subheading">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Cora — Catalog Banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product Catalog" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "default": "Browse our complete collection of handcrafted luxury rugs."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#000000" },

    { "type": "header", "content": "Background" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#F0EBE4" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Desktop Image" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Mobile Image" },

    { "type": "header", "content": "Overlay (For Readability)" },
    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Overlay Opacity", "default": 0 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt_desktop", "label": "Top Padding (Desktop)", "min": 0, "max": 200, "step": 5, "default": 80 },
    { "type": "range", "id": "pb_desktop", "label": "Bottom Padding (Desktop)", "min": 0, "max": 200, "step": 5, "default": 80 },
    { "type": "range", "id": "pt_mobile", "label": "Top Padding (Mobile)", "min": 0, "max": 100, "step": 5, "default": 60 },
    { "type": "range", "id": "pb_mobile", "label": "Bottom Padding (Mobile)", "min": 0, "max": 100, "step": 5, "default": 60 }
  ],
  "presets": [{ "name": "Catalog Banner", "category": "Catalog Page" }]
}
{% endschema %}


{% comment %} {{ 'cora-catalog-banner.css' | asset_url | stylesheet_tag }}

<section
  id="cora-catalog-banner-{{ section.id }}"
  class="cora-catalog-banner"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Catalog banner' }}"
  style="
    padding-top: {{ section.settings.pt_desktop | default: 60 }}px;
    padding-bottom: {{ section.settings.pb_desktop | default: 60 }}px;
    background-color: {{ section.settings.bg_color | default: '#F0EBE4' }};
    {% if section.settings.bg_image_desktop != blank %}
      background-image: url('{{ section.settings.bg_image_desktop | image_url: '2000x' }}');

    {% endif %}
    background-size: cover;
    background-position: center;
  "
>
  <div class="cora-catalog-banner__inner {% if section.settings.text_align == 'left' %}align-left{% elsif section.settings.text_align == 'right' %}align-right{% else %}align-center{% endif %}">
    <h1 class="cora-catalog-banner__heading" style="color: {{ section.settings.text_color | default: '#000' }};">
      {{ section.settings.heading | default: 'Product Catalog' }}
    </h1>

    {% if section.settings.subheading != blank %}
      <p class="cora-catalog-banner__subheading" style="color: {{ section.settings.text_color | default: '#000' }};">
        {{ section.settings.subheading }}
      </p>
    {% endif %}
  </div>

  <style>
    #shopify-section-{{ section.id }}{
      background-image: url('{{ section.settings.bg_color |  default: '#F0EBE4'}}');
    }
    /* mobile background override (keeps code minimal in-liquid - desktop handled inline above) */
    @media (max-width: 768px) {
      #cora-catalog-banner-{{ section.id }} {
        padding-top: {{ section.settings.pt_mobile | default: 40 }}px;
        padding-bottom: {{ section.settings.pb_mobile | default: 40 }}px;
        {% if section.settings.bg_image_mobile != blank %}
          background-image: url('{{ section.settings.bg_image_mobile | image_url: "1000x" }}');
        {% endif %}
      }
    }
  </style>
</section>

{% schema %}
{
