{{ 'cora-category-slider.css' | asset_url | stylesheet_tag }}

<section id="cora-category-slider-{{ section.id }}"
  class="cora-category-slider"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Category slider' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 12 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 12 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-category-slider__wrap">
    
    <button type="button" class="cora-slider-arrow cora-slider-arrow--prev" aria-label="Scroll left">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <div class="cora-category-slider__track" tabindex="0" role="list" aria-label="Categories">
      {% for block in section.blocks %}
        <div class="cora-category-slider__item" role="listitem">
          <a href="{{ block.settings.link | default: '#' }}" class="cora-category-slider__link" aria-label="{{ block.settings.title }}" draggable="false">
            {% if block.settings.image %}
              <div class="cora-category-slider__media" aria-hidden="true">
                <img src="{{ block.settings.image | img_url: '360x360' }}" width="160" height="160" alt="{{ block.settings.image_alt | default: block.settings.title }}" draggable="false">
              </div>
            {% else %}
              <div class="cora-category-slider__media cora-category-slider__media--placeholder" aria-hidden="true"></div>
            {% endif %}
            <div class="cora-category-slider__title">{{ block.settings.title }}</div>
          </a>
        </div>
      {% endfor %}
    </div>

    <button type="button" class="cora-slider-arrow cora-slider-arrow--next" aria-label="Scroll right">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('cora-category-slider-{{ section.id }}');
    const slider = section.querySelector('.cora-category-slider__track');
    const prevBtn = section.querySelector('.cora-slider-arrow--prev');
    const nextBtn = section.querySelector('.cora-slider-arrow--next');
    let isDown = false;
    let startX;
    let scrollLeft;
    let isDragging = false;

    // --- 1. Arrow Click Logic ---
    prevBtn.addEventListener('click', () => {
      slider.scrollBy({ left: -250, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      slider.scrollBy({ left: 250, behavior: 'smooth' });
    });

    // --- 2. Mouse Drag to Scroll Logic ---
    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      isDragging = false; // Reset drag flag
      slider.classList.add('cora-is-dragging'); // Changes cursor style
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      isDown = false;
      slider.classList.remove('cora-is-dragging');
    });

    slider.addEventListener('mouseup', () => {
      isDown = false;
      setTimeout(() => { slider.classList.remove('cora-is-dragging'); }, 50);
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5; // Scroll-fast multiplier
      
      // If moved more than 5 pixels, consider it a drag operation
      if (Math.abs(walk) > 5) {
        isDragging = true;
      }
      
      slider.scrollLeft = scrollLeft - walk;
    });

    // --- 3. Prevent Link Click if Dragging ---
    const links = slider.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Category Slider",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Category slider" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 120, "step": 2, "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 120, "step": 2, "default": 12 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Circle image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Imperial Knots" },
        { "type": "text", "id": "title", "label": "Category title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link (to collection / page)" }
      ]
    }
  ],
  "presets": [
    { "name": "Category Slider", "category": "Home Page" }
  ]
}
{% endschema %}



