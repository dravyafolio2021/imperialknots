{{ 'cora-category-slider.css' | asset_url | stylesheet_tag }}

<section id="cora-category-slider-{{ section.id }}"
  class="cora-category-slider"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Category slider' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 12 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 12 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-category-slider__wrap">
    <div class="cora-category-slider__track" tabindex="0" role="list" aria-label="Categories">
      {% for block in section.blocks %}
        <div class="cora-category-slider__item" role="listitem">
          <a href="{{ block.settings.link | default: '#' }}" class="cora-category-slider__link" aria-label="{{ block.settings.title }}">
            {% if block.settings.image %}
              <div class="cora-category-slider__media" aria-hidden="true">
                <img src="{{ block.settings.image | img_url: '360x360' }}" width="160" height="160" alt="{{ block.settings.image_alt | default: block.settings.title }}">
              </div>
            {% else %}
              <div class="cora-category-slider__media cora-category-slider__media--placeholder" aria-hidden="true"></div>
            {% endif %}
            <div class="cora-category-slider__title">{{ block.settings.title }}</div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Slider",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Category slider" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 120, "step": 2, "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 120, "step": 2, "default": 12 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Circle image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Imperial Knots" },
        { "type": "text", "id": "title", "label": "Category title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link (to collection / page)" }
      ]
    }
  ],
  "presets": [
    { "name": "Category Slider", "category": "Home Page" }
  ]
}
{% endschema %}
