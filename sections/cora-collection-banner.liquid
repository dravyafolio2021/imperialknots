{% comment %}
  -----------------------------------------------------------------------------
  SECTION: DYNAMIC COLLECTION BANNER
  -----------------------------------------------------------------------------
{% endcomment %}

{{ 'collection-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Dynamic Spacing */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
    }
  }

  /* Dynamic Colors & Overlay */
  #cb-root-{{ section.id }} .cb-container {
    background-color: {{ section.settings.bg_color }};
  }

  #cb-root-{{ section.id }} .cb-overlay {
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  #cb-root-{{ section.id }} .cb-content {
    color: {{ section.settings.text_color }};
  }

  /* Dynamic Typography */
  #cb-root-{{ section.id }} .cb-heading {
    font-size: {{ section.settings.heading_size }}px;
  }

  #cb-root-{{ section.id }} .cb-subheading {
    font-size: {{ section.settings.subheading_size }}px;
  }

  /* Mobile Font Scaling */
  @media screen and (max-width: 768px) {
    #cb-root-{{ section.id }} .cb-heading {
      font-size: {{ section.settings.heading_size | times: 0.7 | round: 0 }}px;
    }
    #cb-root-{{ section.id }} .cb-subheading {
      font-size: {{ section.settings.subheading_size | times: 0.9 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<section id="cb-root-{{ section.id }}" class="collection-banner-section" aria-label="Collection Banner">
  <div class="cb-container section-{{ section.id }}-padding">

    <!-- Background Image -->
    <div class="cb-bg">
      {%- if section.settings.image_desktop != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | img_url: '800x' }}">
          {%- endif -%}
          <img
            src="{{ section.settings.image_desktop | img_url: '2000x' }}"
            alt="{{ collection.title | escape }}"
            loading="eager"
            width="2000"
            height="800"
          >
        </picture>

      {%- elsif collection.image != blank -%}
        <img
          src="{{ collection.image | img_url: '2000x' }}"
          alt="{{ collection.title | escape }}"
          loading="eager"
          width="2000"
          height="800"
        >

      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <!-- Overlay -->
    <div class="cb-overlay"></div>

    <!-- Content -->
    <div class="cb-content">
      <h1 class="cb-heading">{{ collection.title }}</h1>

      {%- if section.settings.subheading != blank -%}
        <div class="cb-subheading">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use Collection Title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Description",
      "info": "Leave blank to hide description completely."
    },

    { "type": "header", "content": "Images" },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image",
      "info": "If blank, uses Collection Featured Image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },

    { "type": "header", "content": "Colors & Overlay" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1a1a1a" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#f3f3f3" },
    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#ffffff" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 85
    },

    { "type": "header", "content": "Sizing" },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    }
  ],
  "presets": [
    { "name": "Collection Banner" }
  ]
}
{% endschema %}