{{ 'cora-catalog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #cora-prod-grid-{{ section.id }} {
    --cora-bg: {{ section.settings.bg_color }};
    --cora-text: {{ section.settings.text_color }};
    --cora-pt: {{ section.settings.padding_top }}px;
    --cora-pb: {{ section.settings.padding_bottom }}px;
    --cora-align: {{ section.settings.text_align }};
    --grid-desktop: {{ section.settings.columns_desktop }};
    --grid-mobile: {{ section.settings.columns_mobile }};
  }
{%- endstyle -%}

<div id="cora-prod-grid-{{ section.id }}" class="cora-catalog-section">
  <div class="cora-catalog-container">
    <div class="cora-catalog-header">
      <h1 class="cora-catalog-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
<div class="cora-catalog-desc">{{ collection.description | strip_html | truncatewords: 20 }}</div>      {% endif %}
    </div>

    {% paginate collection.products by section.settings.products_per_page %}
      <div class="cora-grid-layout">
        {% for product in collection.products %}
          <a href="{{ product.url }}?view=cora-product" class="cora-card">
            <div class="cora-card-media {{ section.settings.image_ratio }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | img_url: '800x' }}"
                  alt="{{ product.title }}"
                  class="cora-card-img"
                  loading="lazy" height="" width=""
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'cora-card-img' }}
              {% endif %}
            </div>

            <div class="cora-card-info">
              <h3 class="cora-card-title">{{ product.title }}</h3>
            </div>
          </a>
        {% else %}
          <p style="text-align:center; width:100%; grid-column: 1 / -1; padding: 40px;">
            No products found in this collection.
          </p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div style="text-align: center; margin-top: 50px; display:flex; justify-content:center; gap:10px;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Cora Product Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Grid Layout" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Shape",
      "options": [
        { "value": "cora-ratio-portrait", "label": "Portrait (Tall)" },
        { "value": "cora-ratio-square", "label": "Square" }
      ],
      "default": "cora-ratio-portrait"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1a1a1a" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 5, "default": 60, "label": "Padding Top" },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "label": "Padding Bottom"
    }
  ]
}
{% endschema %}
