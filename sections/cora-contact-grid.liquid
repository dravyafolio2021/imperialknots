            "svg_icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'></path></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="cora-contact-section" style="
  background-color: {{ section.settings.bg_color }}; 
  color: {{ section.settings.text_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="cora-contact-container">
    
    <div class="cora-contact-header">
      {% if section.settings.heading != blank %}
        <h2 class="cora-contact-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.desc != blank %}
        <p class="cora-contact-desc">{{ section.settings.desc }}</p>
      {% endif %}
    </div>

    <div class="cora-contact-grid">
      {% for block in section.blocks %}
        <div class="cora-card" {{ block.shopify_attributes }}>
          
          <div class="cora-card-icon-wrapper" style="background-color: {{ section.settings.text_color | color_modify: 'alpha', 0.05 }}">
            {% if block.settings.svg_icon != blank %}
              <div class="cora-card-svg" style="color: {{ section.settings.text_color }}">
                {{ block.settings.svg_icon }}
              </div>
            {% elsif block.settings.image_icon != blank %}
              <img src="{{ block.settings.image_icon | img_url: '100x' }}" alt="{{ block.settings.label }}" class="cora-card-img" loading="lazy">
            {% endif %}
          </div>

          <div class="cora-card-label">{{ block.settings.label }}</div>
          <div class="cora-card-value">{{ block.settings.value | newline_to_br }}</div>
          <div class="cora-card-subtext">{{ block.settings.subtext }}</div>
          
          {% if block.settings.link_text != blank %}
            <a href="{{ block.settings.link_url }}" class="cora-card-link">
              {{ block.settings.link_text }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>
</div>