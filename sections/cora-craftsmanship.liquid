 
{{ 'cora-craftsmanship.css' | asset_url | stylesheet_tag }}

<section class="cc-section" aria-label="Craftsmanship">
  <div class="cc-container">
    
    <div class="cc-header">
      <h2 class="cc-title">{{ section.settings.heading }}</h2>
      <div class="cc-desc">{{ section.settings.text }}</div>
    </div>

    <div class="cc-grid">
      {%- for block in section.blocks -%}
        <div class="cc-item" {{ block.shopify_attributes }}>
          
          <div class="cc-card">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: '800x' }}" width="" height="" loading="lazy" alt="{{ block.settings.title }}">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
            
            <div class="cc-overlay">
              <h3 class="cc-card-title">{{ block.settings.title }}</h3>
            </div>
          </div>

          <div class="cc-caption">{{ block.settings.caption }}</div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Craftsmanship Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Craftsmanship & Production"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Each rug passes through multiple stages of meticulous craftsmanship."
    }
  ],
  "blocks": [
    {
      "type": "process_step",
      "name": "Process Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption",
          "default": "Description of this step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship Grid",
      "category": "About Us",
      "blocks": [
        { 
          "type": "process_step",
          "settings": { "title": "Yarn Dyeing", "caption": "Natural and synthetic dyes carefully selected." }
        },
        { 
          "type": "process_step",
          "settings": { "title": "Hand-Knotting", "caption": "Each knot tied by skilled artisans." }
        },
        { 
          "type": "process_step",
          "settings": { "title": "Quality Checks", "caption": "Rigorous inspection ensures luxury standards." }
        }
      ]
    }
  ]
}
{% endschema %}