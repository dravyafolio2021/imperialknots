{%- style -%}
  /* DOCUMENT CONTAINER */
  #cora-doc-{{ section.id }} {
    background-color: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: 'Poppins', sans-serif;
  }

  .cora-doc-paper {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    background-color: {{ section.settings.paper_bg }};
    padding: 60px; /* Document-like padding */
    box-shadow: {% if section.settings.show_shadow %}0 4px 20px rgba(0,0,0,0.08){% else %}none{% endif %};
    border-radius: {% if section.settings.show_shadow %}8px{% else %}0{% endif %};
  }

  /* TYPOGRAPHY */
  .cora-doc-paper h1, .cora-doc-paper h2, .cora-doc-paper h3, 
  .cora-doc-paper h4, .cora-doc-paper h5, .cora-doc-paper h6 {
    color: {{ section.settings.text_color }};
    margin: 0 0 16px 0;
    line-height: 1.3;
  }
  
  .cora-doc-paper p, .cora-doc-paper li {
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.8; /* Comfortable reading height */
    margin-bottom: 24px;
  }
  
  .cora-doc-paper a {
    color: #000;
    text-decoration: underline;
  }

  /* BLOCKS */
  .cora-doc-block {
    margin-bottom: 20px;
  }

  /* Image Block */
  .cora-doc-image-wrapper {
    display: flex;
    flex-direction: column;
  }
  .cora-doc-image {
    height: auto;
    border-radius: 4px;
  }
  .cora-doc-caption {
    font-size: 13px;
    color: #666;
    margin-top: 8px;
    text-align: center;
    font-style: italic;
  }

  /* Video Block */
  .cora-doc-video {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
  }
  .cora-doc-video iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Divider */
  .cora-doc-divider {
    height: 1px;
    background-color: #e5e5e5;
    margin: 40px 0;
    border: none;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .cora-doc-paper {
      padding: 30px 20px;
    }
    #cora-doc-{{ section.id }} {
      padding-top: 40px;
      padding-bottom: 40px;
    }
  }
{%- endstyle -%}

<section id="cora-doc-{{ section.id }}">
  <div class="cora-doc-paper">
    {%- for block in section.blocks -%}
      <div class="cora-doc-block" {{ block.shopify_attributes }}>
        
        {%- case block.type -%}
          
          {%- when 'heading' -%}
            {%- capture heading_tag -%}{{ block.settings.heading_size }}{%- endcapture -%}
            <{{ heading_tag }} style="text-align: {{ block.settings.alignment }}">
              {{ block.settings.title }}
            </{{ heading_tag }}>

          {%- when 'paragraph' -%}
            <div class="rte" style="text-align: {{ block.settings.alignment }}">
              {{ block.settings.text }}
            </div>

          {%- when 'image' -%}
            <div class="cora-doc-image-wrapper" style="align-items: {{ block.settings.alignment }};">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: 
                  class: 'cora-doc-image', 
                  loading: 'lazy',
                  style: 'max-width: ' | append: block.settings.width | append: '%'
                }}
                {%- if block.settings.caption != blank -%}
                  <span class="cora-doc-caption">{{ block.settings.caption }}</span>
                {%- endif -%}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'cora-doc-image' }}
              {%- endif -%}
            </div>

          {%- when 'html' -%}
            <div class="cora-custom-html">
              {{ block.settings.html_code }}
            </div>

          {%- when 'video' -%}
            {%- if block.settings.video_url != blank -%}
              <div class="cora-doc-video">
                {%- if block.settings.video_url.type == 'youtube' -%}
                  <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?rel=0&showinfo=0" frameborder="0" allowfullscreen></iframe>
                {%- elsif block.settings.video_url.type == 'vimeo' -%}
                  <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?color={{ section.settings.text_color | remove: '#' }}" frameborder="0" allowfullscreen></iframe>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'divider' -%}
            <hr class="cora-doc-divider">
            
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "📄 Doc Builder (Rich Text)",
  "settings": [
    { "type": "header", "content": "Page Setup" },
    { "type": "range", "id": "page_width", "min": 600, "max": 1200, "step": 50, "default": 800, "unit": "px", "label": "Document Width" },
    { "type": "color", "id": "section_bg", "label": "Section Background", "default": "#f4f4f4" },
    { "type": "color", "id": "paper_bg", "label": "Paper Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1a1a1a" },
    { "type": "checkbox", "id": "show_shadow", "label": "Show Paper Shadow", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "default": 60, "label": "Top Padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "default": 60, "label": "Bottom Padding" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading Text", "default": "Section Title" },
        { 
          "type": "select", 
          "id": "heading_size", 
          "label": "Size",
          "options": [
            { "value": "h1", "label": "H1 (Title)" },
            { "value": "h2", "label": "H2 (Large)" },
            { "value": "h3", "label": "H3 (Medium)" },
            { "value": "h4", "label": "H4 (Small)" }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "Rich Text Area",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Write your content here just like a document.</p>" },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "justify", "label": "Justify" }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "width", "min": 20, "max": 100, "step": 5, "default": 100, "unit": "%", "label": "Width" },
        { "type": "text", "id": "caption", "label": "Caption (Optional)" },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "flex-start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "html",
      "name": "Custom HTML / Code",
      "settings": [
        { "type": "html", "id": "html_code", "label": "HTML Code", "default": "<div>Use this for tables, embeds, or custom layouts.</div>" }
      ]
    },
    {
      "type": "video",
      "name": "Video Embed",
      "settings": [
        { "type": "video_url", "id": "video_url", "label": "Video Link", "accept": ["youtube", "vimeo"] }
      ]
    },
    {
      "type": "divider",
      "name": "Divider Line"
    }
  ],
  "presets": [
    {
      "name": "📄 Doc Builder (Rich Text)",
      "blocks": [
        { "type": "heading", "settings": { "title": "My Document Title" } },
        { "type": "paragraph" },
        { "type": "image" },
        { "type": "paragraph" }
      ]
    }
  ]
}
{% endschema %}