{{ 'cora-faq.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Cora FAQ Accordion",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Find answers to common questions about our products and services."
    },
    {
      "type": "header",
      "content": "Functionality"
    },
    {
      "type": "checkbox",
      "id": "enable_accordion_mode",
      "label": "One open at a time",
      "default": true,
      "info": "If checked, opening a question will automatically close others."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy for all unused items in their original packaging.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cora FAQ Accordion",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}

<div 
  id="cora-faq-section-{{ section.id }}" 
  class="cora-faq-section" 
  data-accordion-mode="{{ section.settings.enable_accordion_mode }}"
  style="
    background-color: {{ section.settings.bg_color }}; 
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="cora-faq-container">
    
    <div class="cora-faq-header">
      {% if section.settings.heading != blank %}
        <h2 class="cora-faq-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.desc != blank %}
        <p class="cora-faq-desc">{{ section.settings.desc }}</p>
      {% endif %}
    </div>

    <div class="cora-faq-list">
      {% for block in section.blocks %}
        <div class="cora-faq-item" {{ block.shopify_attributes }}>
          <button class="cora-faq-trigger" aria-expanded="false" aria-controls="faq-content-{{ block.id }}">
            <span class="cora-faq-question">{{ block.settings.question }}</span>
            <span class="cora-faq-icon"></span>
          </button>
          <div id="faq-content-{{ block.id }}" class="cora-faq-content">
            <div class="cora-faq-answer">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Select this specific section instance to handle multiple FAQs on one page correctly
    const sectionContainer = document.getElementById('cora-faq-section-{{ section.id }}');
    if (!sectionContainer) return;

    const triggers = sectionContainer.querySelectorAll('.cora-faq-trigger');
    const isAccordionMode = sectionContainer.getAttribute('data-accordion-mode') === 'true';

    triggers.forEach(trigger => {
      trigger.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const content = this.nextElementSibling;
        const parent = this.parentElement;

        // ACCORDION LOGIC: If mode is enabled and we are opening an item, close all others
        if (isAccordionMode && !isExpanded) {
          triggers.forEach(otherTrigger => {
            if (otherTrigger !== trigger) {
              // Close other trigger
              otherTrigger.setAttribute('aria-expanded', 'false');
              otherTrigger.parentElement.classList.remove('active');
              // Collapse other content
              otherTrigger.nextElementSibling.style.maxHeight = null;
            }
          });
        }

        // Toggle current clicked item
        this.setAttribute('aria-expanded', !isExpanded);
        parent.classList.toggle('active');

        if (!isExpanded) {
          content.style.maxHeight = content.scrollHeight + "px";
        } else {
          content.style.maxHeight = null;
        }
      });
    });
  });
</script>

