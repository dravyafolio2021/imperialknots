{{ 'cora-faq-v2.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #cora-faq-v2-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #cora-faq-v2-{{ section.id }} .cora-faq-v2__heading {
    color: {{ section.settings.heading_color }};
  }
{%- endstyle -%}

<section id="cora-faq-v2-{{ section.id }}" class="cora-faq-v2-section">
  <div class="cora-faq-v2__container">
    
    {%- if section.settings.heading != blank -%}
      <div class="cora-faq-v2__header">
        <h2 class="cora-faq-v2__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="cora-faq-v2__desc">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cora-faq-v2__wrapper">
      {%- assign category_open = false -%}
      
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'category' -%}
            {%- comment -%} Close previous category if one is open {%- endcomment -%}
            {%- if category_open -%}
                </div>
              </details>
            {%- endif -%}
            
            {%- assign category_open = true -%}
            
            <details class="cora-faq-v2__category" {{ block.shopify_attributes }}>
              <summary class="cora-faq-v2__category-trigger">
                <h3 class="cora-faq-v2__category-title">{{ block.settings.title }}</h3>
                <span class="cora-faq-v2__icon cora-faq-v2__icon--category">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="cora-faq-v2__category-content">

          {%- when 'question' -%}
            {%- comment -%} Only render questions if inside an open category {%- endcomment -%}
            {%- if category_open -%}
              <div class="cora-faq-v2__item" {{ block.shopify_attributes }}>
                <button class="cora-faq-v2__question-trigger" aria-expanded="false" type="button">
                  <span class="cora-faq-v2__question">{{ block.settings.title }}</span>
                  <span class="cora-faq-v2__icon cora-faq-v2__icon--question"></span>
                </button>
                <div class="cora-faq-v2__answer-wrapper">
                  <div class="cora-faq-v2__answer">
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} Close the last category if one was open {%- endcomment -%}
      {%- if category_open -%}
          </div>
        </details>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const section = document.getElementById("cora-faq-v2-{{ section.id }}");
    
    // Question Accordion Logic
    const questionTriggers = section.querySelectorAll('.cora-faq-v2__question-trigger');
    questionTriggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        e.preventDefault(); // Prevent any default button behavior
        const content = this.nextElementSibling;
        const isOpen = this.getAttribute('aria-expanded') === 'true';
        const parentCategoryContent = this.closest('.cora-faq-v2__category-content');

        // Optional: Close other questions within the same category
        if (parentCategoryContent) {
            parentCategoryContent.querySelectorAll('.cora-faq-v2__question-trigger').forEach(otherBtn => {
                if (otherBtn !== this && otherBtn.getAttribute('aria-expanded') === 'true') {
                    otherBtn.setAttribute('aria-expanded', 'false');
                    otherBtn.nextElementSibling.style.maxHeight = null;
                }
            });
        }

        // Toggle current question
        this.setAttribute('aria-expanded', !isOpen);
        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + "px";
        } else {
          content.style.maxHeight = null;
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ V2 (Collapsible)",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Common questions about our products and shipping." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading Color", "default": "#1a1a1a" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "default": 80, "label": "Padding Top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "default": 80, "label": "Padding Bottom" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Header",
      "settings": [
        { "type": "text", "id": "title", "label": "Category Title", "default": "General" }
      ]
    },
    {
      "type": "question",
      "name": "Question & Answer",
      "settings": [
        { "type": "text", "id": "title", "label": "Question", "default": "What is your return policy?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We accept returns within 30 days of purchase.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ V2 (Collapsible)",
      "blocks": [
        { "type": "category", "settings": { "title": "General" } },
        { "type": "question" },
        { "type": "question" },
        { "type": "category", "settings": { "title": "Shipping" } },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}