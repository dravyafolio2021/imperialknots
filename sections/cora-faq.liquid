{{ 'cora-faq.css' | asset_url | stylesheet_tag }}

<section id="cora-faq-{{ section.id }}"
  class="cora-faq"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'FAQ' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 32 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 32 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-faq__inner">
    {% comment %} optional heading block (add one heading block at top) {% endcomment %}
    {% for block in section.blocks %}
      {% if block.type == 'heading' %}
        <header class="cora-faq__header">
          {% if block.settings.heading != blank %}
            <h2 class="cora-faq__title">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="cora-faq__description">{{ block.settings.description }}</p>
          {% endif %}
        </header>
      {% endif %}
    {% endfor %}

    <div class="cora-faq__list" role="list" aria-label="Frequently asked questions">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          {% capture panel_id %}cora-faq-{{ section.id }}-panel-{{ forloop.index0 }}{% endcapture %}
          {% capture button_id %}cora-faq-{{ section.id }}-button-{{ forloop.index0 }}{% endcapture %}

          <div class="cora-faq__item" role="listitem">
            <button
              id="{{ button_id }}"
              class="cora-faq__trigger"
              aria-expanded="{{ block.settings.open | default: false }}"
              aria-controls="{{ panel_id }}"
              data-index="{{ forloop.index0 }}"
              >
              <span class="cora-faq__question">{{ block.settings.question }}</span>
              <span class="cora-faq__toggle-icon" aria-hidden="true">+</span>
            </button>

            <div id="{{ panel_id }}" class="cora-faq__panel" role="region" aria-labelledby="{{ button_id }}" {% if block.settings.open %} style="display:block;" {% else %} style="display:none;" {% endif %}>
              <div class="cora-faq__answer">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('cora-faq-{{ section.id }}');
  if (!root) return;

  var triggers = root.querySelectorAll('.cora-faq__trigger');
  var panels = root.querySelectorAll('.cora-faq__panel');

  // Utility to close all (if accordion mode), else toggle only clicked
  var accordionMode = {{ section.settings.accordion | default: true }};

  function closePanel(btn, panel) {
    btn.setAttribute('aria-expanded', 'false');
    panel.style.display = 'none';
    btn.querySelector('.cora-faq__toggle-icon').textContent = '+';
  }
  function openPanel(btn, panel) {
    btn.setAttribute('aria-expanded', 'true');
    panel.style.display = 'block';
    btn.querySelector('.cora-faq__toggle-icon').textContent = '−';
  }

  triggers.forEach(function(btn, idx){
    var panel = document.getElementById(btn.getAttribute('aria-controls'));
    // initialize icons
    if (btn.getAttribute('aria-expanded') === 'true') {
      btn.querySelector('.cora-faq__toggle-icon').textContent = '−';
      panel.style.display = 'block';
    } else {
      btn.querySelector('.cora-faq__toggle-icon').textContent = '+';
      panel.style.display = 'none';
    }

    btn.addEventListener('click', function(e){
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closePanel(btn, panel);
      } else {
        if (accordionMode) {
          // close others
          triggers.forEach(function(otherBtn){
            var otherPanel = document.getElementById(otherBtn.getAttribute('aria-controls'));
            closePanel(otherBtn, otherPanel);
          });
        }
        openPanel(btn, panel);
      }
    });

    // keyboard support
    btn.addEventListener('keydown', function(e){
      var key = e.key || e.keyCode;
      if (key === 'ArrowDown' || key === 'Down' || key === 40) {
        e.preventDefault();
        var next = triggers[(idx + 1) % triggers.length];
        next.focus();
      } else if (key === 'ArrowUp' || key === 'Up' || key === 38) {
        e.preventDefault();
        var prev = triggers[(idx - 1 + triggers.length) % triggers.length];
        prev.focus();
      } else if (key === 'Home') {
        e.preventDefault();
        triggers[0].focus();
      } else if (key === 'End') {
        e.preventDefault();
        triggers[triggers.length - 1].focus();
      } else if (key === 'Enter' || key === ' ' || key === 13 || key === 32) {
        e.preventDefault();
        btn.click();
      }
    });
  });

})();
</script>

{% schema %}
{
  "name": "Cora FAQ ",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "FAQ" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 200, "step": 2, "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 200, "step": 2, "default": 32 },
    { "type": "checkbox", "id": "accordion", "label": "Only one open at a time (accordion mode)", "default": true }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Have a question? We have answers. Browse common questions below." }
      ]
    },
    {
      "type": "faq",
      "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question goes here" },
        { "type": "textarea", "id": "answer", "label": "Answer (supports HTML)", "default": "Answer goes here" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Cora FAQ", "category": "Home Page" }
  ]
}
{% endschema %}
