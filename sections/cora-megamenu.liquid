{{ 'cora-megamenu.css' | asset_url | stylesheet_tag }}

<div class="cora-megamenu-wrapper" data-menu-handle="{{ section.settings.parent_link | handleize }}">
  <div class="cora-mm-container">
    
    <div class="cora-mm-links">
      {%- assign main_link_handle = section.settings.parent_link | handleize -%}
      {%- assign main_link = linklists[section.settings.menu].links | where: "handle", main_link_handle | first -%}
      
      {%- unless main_link -%}
         {%- assign main_link = linklists[section.settings.menu].links | where: "title", section.settings.parent_link | first -%}
      {%- endunless -%}
      
      {% if main_link %}
        {% for child_link in main_link.links limit: 2 %} <div class="cora-mm-col">
            <h4 class="cora-mm-heading">{{ child_link.title }}</h4>
            <ul class="cora-mm-list">
              {% for grandchild in child_link.links %}
                <li><a href="{{ grandchild.url }}" class="cora-mm-link">{{ grandchild.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      {% else %}
        <p style="padding: 20px; color: red;">
          Error: Could not find a link named "{{ section.settings.parent_link }}" in menu "{{ section.settings.menu }}". 
          Please ensure the "Trigger Link Name" matches exactly.
        </p>
      {% endif %}
    </div>

    <div class="cora-mm-promos">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cora-mm-card">
          <div class="cora-mm-image-wrap">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | img_url: '400x500', crop: 'center' }}" alt="{{ block.settings.title }}" loading="lazy">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="cora-mm-label">
            <span>{{ block.settings.title }}</span>
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Cora Mega Menu",
  "class": "cora-megamenu-section",
  "settings": [
    {
      "type": "text",
      "id": "parent_link",
      "label": "Trigger Link Name",
      "info": "Exact name of the menu item that opens this (e.g. 'Catalog')",
      "default": "Catalog"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu",
      "default": "main-menu",
      "info": "Select the menu where your nested links are located."
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Label", "default": "Best Sellers" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cora Mega Menu",
      "blocks": [
        { "type": "promo" },
        { "type": "promo" },
        { "type": "promo" }
      ]
    }
  ]
}
{% endschema %}