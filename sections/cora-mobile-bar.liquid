{{ 'cora-mobile-bar.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <nav class="cora-mobile-bar">
    {%- for block in section.blocks -%}
      
      {%- case block.type -%}
        
        {%- comment -%} 1. MENU TRIGGER (Opens Existing Header Drawer) {%- endcomment -%}
        {%- when 'menu_trigger' -%}
          <label for="cora-nav-toggle" class="cora-bar-item" {{ block.shopify_attributes }}>
            <div class="cora-bar-icon">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
              {% endif %}
            </div>
            <span class="cora-bar-label">{{ block.settings.label }}</span>
          </label>

        {%- comment -%} 2. STANDARD LINK (Categories, etc.) {%- endcomment -%}
        {%- when 'link' -%}
          <a href="{{ block.settings.url }}" class="cora-bar-item" {{ block.shopify_attributes }}>
            <div class="cora-bar-icon" style="position:relative;">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              {% endif %}
            </div>
            <span class="cora-bar-label">{{ block.settings.label }}</span>
          </a>

        {%- comment -%} 3. WHATSAPP BLOCK {%- endcomment -%}
        {%- when 'whatsapp' -%}
          <a href="https://wa.me/{{ block.settings.phone_number }}?text={{ block.settings.message | url_encode }}" target="_blank" class="cora-bar-item whatsapp-item" {{ block.shopify_attributes }}>
            <div class="cora-bar-icon">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              {% endif %}
            </div>
            <span class="cora-bar-label">{{ block.settings.label }}</span>
          </a>
        
        {%- comment -%} 4. PHONE CALL BLOCK {%- endcomment -%}
        {%- when 'phone' -%}
          <a href="tel:{{ block.settings.phone_number }}" class="cora-bar-item" {{ block.shopify_attributes }}>
            <div class="cora-bar-icon">
              {% if block.settings.custom_svg != blank %}
                {{ block.settings.custom_svg }}
              {% else %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              {% endif %}
            </div>
            <span class="cora-bar-label">{{ block.settings.label }}</span>
          </a>

      {%- endcase -%}
    {%- endfor -%}
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Mobile Sticky Bar",
  "settings": [],
  "blocks": [
    {
      "type": "menu_trigger",
      "name": "Menu Trigger",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Menu" },
        { "type": "html", "id": "custom_svg", "label": "Custom SVG (Optional)" }
      ]
    },
    {
      "type": "link",
      "name": "Link Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Categories" },
        { "type": "url", "id": "url", "label": "Link URL" },
        { "type": "html", "id": "custom_svg", "label": "Custom SVG (Optional)", "info": "Paste <svg> code here" }
      ]
    },
    {
      "type": "whatsapp",
      "name": "WhatsApp Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "WhatsApp" },
        { "type": "text", "id": "phone_number", "label": "Phone Number", "info": "Format: 15551234567 (No + or spaces)" },
        { "type": "text", "id": "message", "label": "Pre-filled Message", "default": "Hi, I need help with..." },
        { "type": "html", "id": "custom_svg", "label": "Custom SVG (Optional)" }
      ]
    },
    {
      "type": "phone",
      "name": "Call Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Call" },
        { "type": "text", "id": "phone_number", "label": "Phone Number" },
        { "type": "html", "id": "custom_svg", "label": "Custom SVG (Optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Sticky Bar",
      "blocks": [
        { "type": "menu_trigger" },
        { "type": "link", "settings": { "label": "Categories" } },
        { "type": "whatsapp" },
        { "type": "phone" }
      ]
    }
  ]
}
{% endschema %}