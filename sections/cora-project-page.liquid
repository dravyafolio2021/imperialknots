{% comment %}
  SECTION: CUSTOM RUG REQUEST FORM
  Filename: sections/cora-custom-rug.liquid
{% endcomment %}

{{ 'cora-custom-rug.css' | asset_url | stylesheet_tag }}

<div class="ccr-hero">
  <h1 class="ccr-hero-title">{{ section.settings.heading }}</h1>
  <div class="ccr-hero-desc">{{ section.settings.text }}</div>
</div>



{% schema %}
{
  "name": "Custom Rugs 2",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Custom Rug Request"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Create your perfect rug. Tell us about your vision and our artisans will bring it to life."
    }
  ],
  "presets": [{ "name": "Custom Rugs 2", "category": "Custom Rugs" }]
}
{% endschema %}
