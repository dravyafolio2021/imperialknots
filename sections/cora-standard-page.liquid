{{ 'cora-standard-page.css' | asset_url | stylesheet_tag }}

<section
  id="cora-standard-page-{{ section.id }}"
  class="cora-standard-page"
  role="main"
  aria-label="{{ section.settings.aria_label | default: 'Standard page' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top_desktop | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 48 }}px;
  "
>
  {%- comment -%}
    Banner (global image) — title/subtitle per-page
    Order of title: page.title (always)
    Order of subtitle: page.metafields.cora.banner_subheading -> page.excerpt -> section.settings.subheading
  {%- endcomment -%}

  <div
    class="cora-standard-page__banner"
    role="banner"
    style="
      {% if section.settings.banner_image_desktop %}
        background-image: url('{{ section.settings.banner_image_desktop | img_url: '2000x' }}');
      {% else %}
        background-image: url('{{ 'fallback.png' | asset_url }}');
      {% endif %}
      background-size: cover;
      background-position: center;
    "
  >
    <div class="cora-standard-page__banner-inner">
      {% if section.settings.banner_tagline != blank %}
        <div
          class="cora-standard-page__banner-tagline"
          style="color: {{ section.settings.banner_tagline_color | default: '#6b7280' }};"
        >
          {{ section.settings.banner_tagline }}
        </div>
      {% endif %}

      {%- comment -%}
        Title: use the page title if available (this ensures each page displays its own title).
      {%- endcomment -%}
      {% if page and page.title != blank %}
        <h1
          class="cora-standard-page__banner-title"
          style="color: {{ section.settings.banner_heading_color | default: '#111' }};"
        >
          {{ page.title }}
        </h1>
      {% elsif section.settings.banner_heading != blank %}
        <h1
          class="cora-standard-page__banner-title"
          style="color: {{ section.settings.banner_heading_color | default: '#111' }};"
        >
          {{ section.settings.banner_heading }}
        </h1>
      {% endif %}

      {%- comment -%}
        Subtitle precedence:
          1) page metafield: page.metafields.cora.banner_subheading
          2) page.excerpt (Shopify page summary)
          3) section.settings.banner_subheading (global fallback)
      {%- endcomment -%}

      {% assign page_sub = '' %}
      {% if page and page.metafields and page.metafields.cora and page.metafields.cora.banner_subheading %}
        {% assign page_sub = page.metafields.cora.banner_subheading.value %}
      {% endif %}

      {% if page_sub != blank %}
        <p
          class="cora-standard-page__banner-subheading"
          style="color: {{ section.settings.banner_subheading_color | default: '#6b7280' }};"
        >
          {{ page_sub }}
        </p>
      {% elsif page and page.excerpt != blank %}
        <p
          class="cora-standard-page__banner-subheading"
          style="color: {{ section.settings.banner_subheading_color | default: '#6b7280' }};"
        >
          {{ page.excerpt }}
        </p>
      {% elsif section.settings.banner_subheading != blank %}
        <p
          class="cora-standard-page__banner-subheading"
          style="color: {{ section.settings.banner_subheading_color | default: '#6b7280' }};"
        >
          {{ section.settings.banner_subheading }}
        </p>
      {% endif %}
    </div>
  </div>

  {%- comment -%}
    Content container (page content or richtext blocks).
  {%- endcomment -%}
  <div class="cora-standard-page__inner {{ section.settings.container_width | default: 'wide' }}">
    <div class="cora-standard-page__header">
      {%- comment -%}
        We already display big title in the banner. Show small header only if requested (or show page title if no banner)
      {%- endcomment -%}
      {% unless section.settings.hide_header_on_banner %}
        {% if page and page.title != blank and section.settings.show_title_under_banner %}
          <h2 class="cora-standard-page__title" style="color: {{ section.settings.heading_color | default: '#111' }};">
            {{ page.title }}
          </h2>
        {% endif %}
        {% if page and page.excerpt != blank and section.settings.show_excerpt_under_banner %}
          <p
            class="cora-standard-page__subheading"
            style="color: {{ section.settings.subheading_color | default: '#6b7280' }};"
          >
            {{ page.excerpt }}
          </p>
        {% endif %}
      {% endunless %}
    </div>

    <div
      class="cora-standard-page__content-wrapper"
      style="text-align: {{ section.settings.text_align | default: 'left' }};"
    >
      {% comment %}
        If theme editor was used to add RichText blocks, render them in order.
        Otherwise fallback to page.content so each page has unique body content.
      {% endcomment %}

      {% assign rich_blocks = false %}
      {% for block in section.blocks %}
        {% if block.type == 'richtext' %}
          {% assign rich_blocks = true %}
        {% endif %}
      {% endfor %}

      {% if rich_blocks %}
        {% for block in section.blocks %}
          {% if block.type == 'richtext' %}
            <div id="block-{{ block.id }}" class="cora-standard-page__block cora-standard-page__block--richtext rte">
              {{ block.settings.content }}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="cora-standard-page__content rte">
          {% if page and page.content != blank %}
            {{ page.content }}
          {% elsif section.settings.content != blank %}
            {{ section.settings.content }}
          {% else %}
            <p>
              Edit this page's content in Shopify Admin → Online Store → Pages, or add richtext blocks to this section
              in the Theme Editor.
            </p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_info_box and section.settings.info_box != blank %}
        <aside class="cora-standard-page__info-box rte">
          {{ section.settings.info_box }}
        </aside>
      {% endif %}
    </div>
  </div>

  <style>
    /* mobile padding + per-section mobile banner override */
    @media (max-width: 900px) {
      #cora-standard-page-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile | default: 28 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 28 }}px;
      }

      {% if section.settings.banner_image_mobile %}
        #cora-standard-page-{{ section.id }} .cora-standard-page__banner {
          background-image: url('{{ section.settings.banner_image_mobile | img_url: "1000x" }}');
        }
      {% endif %}
    }
  </style>
</section>

{% schema %}
{
  "name": "Cora — Standard Page",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Standard page" },

    { "type": "header", "content": "Banner (global image, per-page title/subtitle)" },
    { "type": "image_picker", "id": "banner_image_desktop", "label": "Banner image (desktop)" },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Banner image (mobile, optional)" },
    { "type": "text", "id": "banner_tagline", "label": "Small tagline (global)", "default": "banner_tagline" },
    { "type": "color", "id": "banner_tagline_color", "label": "Tagline color", "default": "#6b7280" },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner heading fallback (used if page title is empty)",
      "default": "banner_heading"
    },
    { "type": "color", "id": "banner_heading_color", "label": "Banner heading color", "default": "#111111" },
    { "type": "text", "id": "banner_subheading", "label": "Banner subheading fallback (global)", "default": "banner_subheading" },
    { "type": "color", "id": "banner_subheading_color", "label": "Banner subheading color", "default": "#6b7280" },

    { "type": "header", "content": "Layout & content" },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "wide",
      "options": [
        { "value": "wide", "label": "Wide (1320px)" },
        { "value": "narrow", "label": "Narrow (900px)" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    {
      "type": "checkbox",
      "id": "hide_header_on_banner",
      "label": "Hide repeating header below banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title_under_banner",
      "label": "Show page title below banner (even if banner exists)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt_under_banner",
      "label": "Show page excerpt below banner",
      "default": false
    },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop px)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop px)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile px)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile px)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 28
    },

    { "type": "header", "content": "Info box (optional)" },
    { "type": "checkbox", "id": "show_info_box", "label": "Show bottom info box", "default": true },
    {
      "type": "richtext",
      "id": "info_box",
      "label": "Info box content",
      "default": "<p>Questions about this policy? Contact us at <a href='mailto:privacy@yourstore.com'>privacy@yourstore.com</a>.</p>"
    },

    { "type": "header", "content": "Fallback content" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Fallback content (used if page content empty)",
      "default": "<p>Edit this page's content in Shopify Admin → Online Store → Pages.</p>"
    }
  ],
  "blocks": [
    {
      "type": "richtext",
      "name": "Rich text",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Your content here...</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cora — Standard Page ",
      "category": "Pages",
      "blocks": [{ "type": "richtext" }]
    }
  ]
}
{% endschema %}
