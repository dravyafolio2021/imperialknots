{{ 'cora-style-grid.css' | asset_url | stylesheet_tag }}

<section
  id="cora-style-grid-{{ section.id }}"
  class="cora-style-grid"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Rugs by color' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 32 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 32 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-style-grid__inner">
    {% for block in section.blocks %}
      {% if block.type == 'heading' %}
        <header class="cora-style-grid__header">
          {% if block.settings.heading != blank %}
            <h2 class="cora-style-grid__title">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="cora-style-grid__description">{{ block.settings.description }}</p>
          {% endif %}
        </header>
      {% endif %}
    {% endfor %}

    <div class="cora-style-grid__grid" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          <article class="cora-style-grid__card" role="listitem">
            <a href="{{ block.settings.link | default: '#' }}" class="cora-style-grid__card-link">
              {% if block.settings.image %}
                <div class="cora-style-grid__media">
                  <picture>
                    {% if block.settings.image_mobile %}
                      <source media="(max-width:900px)" srcset="{{ block.settings.image_mobile | img_url: '800x' }}">
                    {% endif %}
                    <img
                      src="{{ block.settings.image | img_url: '1200x' }}"
                      alt="{{ block.settings.image_alt | default: block.settings.title }}"
                      loading="lazy"
                      
                      width="1200"
                      height="900"
                    >
                  </picture>
                </div>
              {% else %}
                <div class="cora-style-grid__media cora-style-grid__media--placeholder"></div>
              {% endif %}

              <div
                class="cora-style-grid__overlay"
                style="background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,{{ block.settings.overlay_opacity | default: 0.56 }}) 100%);"
              ></div>

              <div class="cora-style-grid__content">
                {% if block.settings.kicker != blank %}
                  <div class="cora-style-grid__kicker">{{ block.settings.kicker }}</div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <h3 class="cora-style-grid__card-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.subtitle != blank %}
                  <div class="cora-style-grid__card-sub">{{ block.settings.subtitle }}</div>
                {% endif %}
                {% if block.settings.cta_text != blank %}
                  <span class="cora-style-grid__card-cta">
                    {{- block.settings.cta_text }}
                    {% render 'icon-chevron' -%}
                  </span>
                {% endif %}
              </div>
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Style Grid",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Rugs by color" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Rugs by Color" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Imperial Knots" }
      ]
    },
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Imperial Knots" },
        { "type": "text", "id": "kicker", "label": "Kicker (small text)", "default": "Kicker" },
        { "type": "text", "id": "title", "label": "Title", "default": "Natural Jute" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (small)", "default": "Eco-friendly" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Now →" },
        { "type": "url", "id": "link", "label": "Link (collection or page)" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity (0 - 1)",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "default": 0.5
        }
      ]
    }
  ],
  "presets": [{ "name": "Style Grid", "category": "Home Page" }]
}
{% endschema %}
