{{ 'cora-testimonials.css' | asset_url | stylesheet_tag }}

<section class="cora-testimonials" style="background-color: {{ section.settings.bg_color }};">
  <div class="cora-testimonials__inner">
    
    {% if section.settings.heading != blank %}
      <div class="cora-testimonials__header">
        <h2 class="cora-testimonials__title" style="color: {{ section.settings.text_color }};">
          {{ section.settings.heading }}
        </h2>
        {% if section.settings.subheading != blank %}
          <p class="cora-testimonials__sub" style="color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="cora-testimonials__grid">
      {% for block in section.blocks %}
        <div class="cora-testimonials__card" {{ block.shopify_attributes }}>
          
          <div class="cora-testimonials__stars">
            {% for i in (1..block.settings.stars) %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#FFB800" xmlns="http://www.w3.org/2000/svg"><path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/></svg>
            {% endfor %}
          </div>

          <h3 class="cora-testimonials__quote">"{{ block.settings.quote }}"</h3>
          
          <div class="cora-testimonials__text">{{ block.settings.text }}</div>

          <div class="cora-testimonials__author">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 60, height: 60, crop: 'center' }}" 
                alt="{{ block.settings.author }}" 
                class="cora-testimonials__avatar"
                loading="lazy"
                width="48"
                height="48"
              >
            {% else %}
               <div class="cora-testimonials__avatar-placeholder">
                 {{ block.settings.author | slice: 0 }}
               </div>
            {% endif %}
            
            <div class="cora-testimonials__meta">
              <span class="cora-testimonials__name">{{ block.settings.author }}</span>
              <span class="cora-testimonials__verified">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Verified Buyer
              </span>
            </div>
          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Cora Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Thousands"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See what our happy customers have to say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 3,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Short Headline",
          "default": "Absolutely amazing!"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "The quality is outstanding and delivery was super fast. Highly recommend!"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Photo"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah J."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cora Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Fresh breath instantly!",
            "text": "I was skeptical, but after a week of using PawBright, my Golden Retriever's breath is actually pleasant. He loves the taste too!",
            "author": "Priya Sharma"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Vet approved & safe",
            "text": "My vet recommended looking for these specific ingredients. I'm so glad I found a local brand that prioritizes safety. Great job!",
            "author": "Rahul Verma"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 4,
            "quote": "Great for picky eaters",
            "text": "My Shih Tzu is extremely fussy with treats, but she took to these immediately. The packaging was also very secure.",
            "author": "Ananya Gupta"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Visible tartar reduction",
            "text": "Been using this for a month on my German Shepherd. The plaque buildup on his back teeth has definitely gone down. Will subscribe.",
            "author": "Vikram Singh"
          }
        }
      ]
    }
  ]
}
{% endschema %}