{% comment %}
  CORA THEME PREVIEW WIDGET
  A floating sidebar to showcase different theme templates/styles.
{% endcomment %}

<style>
  /* --------------------------
     1. WIDGET STYLING
  --------------------------- */
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap');

  :root {
    --preview-primary: #E87034; /* Imperial Knots Orange */
    --preview-bg: #ffffff;
    --preview-text: #333333;
    --preview-width: 340px;
  }

  .cora-preview-widget {
    font-family: 'Quicksand', sans-serif;
    z-index: 99999;
  }

  /* 2. FLOATING TOGGLE BUTTON */
  .cp-toggle {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    background: var(--preview-bg);
    color: var(--preview-text);
    width: 50px;
    height: 50px;
    border-radius: 8px 0 0 8px;
    box-shadow: -4px 0 15px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 100000;
    transition: right 0.3s ease;
  }

  .cp-toggle svg {
    width: 24px;
    height: 24px;
    stroke: var(--preview-primary);
    stroke-width: 2px;
  }

  /* Hide toggle when drawer is open */
  .cora-preview-wrapper.active + .cp-toggle {
    right: var(--preview-width);
  }

  /* 3. SIDEBAR DRAWER */
  .cora-preview-wrapper {
    position: fixed;
    top: 0;
    right: -100%; /* Hidden by default */
    width: var(--preview-width);
    height: 100vh;
    background: var(--preview-bg);
    box-shadow: -10px 0 30px rgba(0,0,0,0.1);
    transition: right 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: 100000;
    display: flex;
    flex-direction: column;
  }

  .cora-preview-wrapper.active {
    right: 0;
  }

  /* Header */
  .cp-header {
    padding: 20px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fafafa;
  }

  .cp-title {
    font-weight: 700;
    font-size: 16px;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .cp-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 24px;
    color: #999;
    padding: 0;
    line-height: 1;
  }

  /* Content Scroll Area */
  .cp-content {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  /* 4. TEMPLATE GROUPS */
  .cp-group {
    margin-bottom: 30px;
  }

  .cp-group-title {
    font-size: 12px;
    font-weight: 700;
    color: #999;
    text-transform: uppercase;
    margin-bottom: 15px;
    letter-spacing: 1px;
  }

  /* Grid of Thumbnails */
  .cp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .cp-item {
    text-decoration: none;
    display: block;
    group: hover;
  }

  .cp-thumb {
    width: 100%;
    aspect-ratio: 16/10; /* Landscape rectangle */
    background: #f4f4f4;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 8px;
    border: 1px solid #eee;
    transition: border-color 0.2s, transform 0.2s;
    position: relative;
  }

  .cp-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cp-item:hover .cp-thumb {
    border-color: var(--preview-primary);
    transform: translateY(-3px);
  }

  /* Active State (Use query param or handle to detect) */
  .cp-item.current .cp-thumb {
    border: 2px solid var(--preview-primary);
  }
  
  .cp-item.current .cp-thumb::after {
    content: 'Active';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: var(--preview-primary);
    color: #fff;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
  }

  .cp-name {
    font-size: 13px;
    color: #333;
    font-weight: 500;
    text-align: center;
  }

  /* 5. FOOTER (CTA) */
  .cp-footer {
    padding: 20px;
    border-top: 1px solid #eee;
    background: #fff;
  }

  .cp-btn {
    display: block;
    background: var(--preview-primary);
    color: #fff;
    text-align: center;
    padding: 12px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    transition: opacity 0.2s;
  }
  .cp-btn:hover { opacity: 0.9; }

</style>

<div class="cora-preview-widget">
  
  <div class="cora-preview-wrapper" id="coraPreviewDrawer">
    <div class="cp-header">
      <span class="cp-title">{{ section.settings.heading }}</span>
      <button class="cp-close" onclick="togglePreview()">×</button>
    </div>

    <div class="cp-content">
      
      {% if section.blocks.size > 0 %}
        <div class="cp-group">
          <div class="cp-group-title">Templates</div>
          <div class="cp-grid">
            {% for block in section.blocks %}
              <a href="{{ block.settings.url }}" class="cp-item {% if request.path == block.settings.url %}current{% endif %}">
                <div class="cp-thumb">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 300 }}" loading="lazy" alt="{{ block.settings.title }}">
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="cp-name">{{ block.settings.title }}</div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}

    </div>

    {% if section.settings.cta_link != blank %}
      <div class="cp-footer">
        <a href="{{ section.settings.cta_link }}" class="cp-btn">{{ section.settings.cta_text }}</a>
      </div>
    {% endif %}
  </div>

  <div class="cp-toggle" onclick="togglePreview()">
    <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  </div>

</div>

<script>
  function togglePreview() {
    document.getElementById('coraPreviewDrawer').classList.toggle('active');
  }
</script>

{% schema %}
{
  "name": "Theme Preview Widget",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Select Layout"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Buy This Theme"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "template",
      "name": "Template/Page",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Preview Thumbnail"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Template Name",
          "default": "Home v1"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link to Page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Theme Preview Widget"
    }
  ]
}
{% endschema %}