{{ 'cora-topbar.css' | asset_url | stylesheet_tag }}

<style>
    #cora-topbar-marquee-{{ section.id }}{
      box-sizing:border-box;
      position:relative;
      overflow:hidden;
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      background-color: {{ section.settings.bg_color_desktop }};
      width:100vw;
      margin-left:calc(50% - 50vw);
      margin-right:calc(50% - 50vw);
    }
  #shopify-section-{{ section.id }}{
     background-image:url({{ section.settings.bg_image_desktop | img_url: '2000x' }});
     background-color: {{ section.settings.bg_color_desktop }};
     background-size:cover;
     overflow:hidden;
     background-position:center;
  }

    {% if section.settings.bg_image_desktop %}
    #cora-topbar-marquee-{{ section.id }}{
      background-image:url({{ section.settings.bg_image_desktop | img_url: '2000x' }});
      background-size:cover;
      background-position:center;
    }
    {% endif %}

    #cora-topbar-marquee-{{ section.id }} .cora-topbar-marquee__inner{
      position:relative;
      z-index:2;
      display:flex;
      align-items:center;
      justify-content:center;
      padding-left:12px;
      padding-right:12px;
    }

    #cora-topbar-marquee-{{ section.id }} .cora-marquee__track{
      animation-duration: {{ section.settings.speed }}s;
      {% if section.settings.direction == 'right' %}
        animation-direction: reverse;
      {% endif %}
    }

    #cora-topbar-marquee-{{ section.id }} .cora-marquee__item{
      margin-right: {{ section.settings.gap }}px;
    }

    #cora-topbar-marquee-{{ section.id }} .cora-marquee__text{
      font-size: {{ section.settings.font_size_desktop }}px;
      font-weight: {{ section.settings.font_weight }};
      letter-spacing: {{ section.settings.letter_spacing }}px;
      {% if section.settings.uppercase %} text-transform:uppercase; {% endif %}
      color: {{ section.settings.text_color }};
    }

    @media (max-width:900px){
      #cora-topbar-marquee-{{ section.id }}{
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        background-color: {{ section.settings.bg_color_mobile }};
        width:100%;
        margin-left:0;
        margin-right:0;
      }

      {% if section.settings.bg_image_mobile %}
      #cora-topbar-marquee-{{ section.id }}{
        background-image:url({{ section.settings.bg_image_mobile | img_url: '800x' }});
        background-size:cover;
        background-position:center;
      }
      {% endif %}

      #cora-topbar-marquee-{{ section.id }} .cora-marquee__text{
        font-size: {{ section.settings.font_size_mobile }}px;
      }
    }

    @media (prefers-reduced-motion: reduce){
      #cora-topbar-marquee-{{ section.id }} .cora-marquee__track{
        animation:none !important;
        transform:none !important;
      }
    }
</style>

<section
  id="cora-topbar-marquee-{{ section.id }}"
  class="cora-topbar-marquee {% if section.settings.hide_on_mobile %}cora-topbar--hide-mobile{% endif %}"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'Announcement' }}"
>
  <div class="cora-topbar-marquee__inner">
    <div class="cora-marquee" tabindex="0" aria-live="polite" role="status">
      <div class="cora-marquee__track">
        {% capture item_html %}
          {% if section.settings.show_icon and section.settings.icon_image %}
            <span class="cora-marquee__icon">
              <img src="{{ section.settings.icon_image | img_url: '48x' }}"
                   width="{{ section.settings.icon_image.width }}"
                   height="{{ section.settings.icon_image.height }}"
                   alt="">
            </span>
          {% endif %}
          <span class="cora-marquee__text">
            {% if section.settings.uppercase %}
              {{ section.settings.text | upcase }}
            {% else %}
              {{ section.settings.text }}
            {% endif %}
          </span>
        {% endcapture %}

        <div class="cora-marquee__item">{{ item_html }}</div>
        <div class="cora-marquee__item">{{ item_html }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cora Topbar  ",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "ARIA label", "default": "Announcement" },
    {
      "type": "text",
      "id": "text",
      "label": "Marquee text",
      "default": "Free Shipping on All Orders | 30-Day Returns | Sustainably Crafted"
    },
    { "type": "url", "id": "link_url", "label": "Optional link" },

    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size desktop",
      "min": 10,
      "max": 36,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size mobile",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "400" },
        { "value": "500", "label": "500" },
        { "value": "600", "label": "600" },
        { "value": "700", "label": "700" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "default": 0
    },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": false },

    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "speed", "label": "Speed", "min": 4, "max": 40, "step": 1, "default": 12 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 12, "max": 200, "step": 4, "default": 48 },

    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "bg_color_desktop", "label": "Background desktop", "default": "#0B1220" },
    { "type": "color", "id": "bg_color_mobile", "label": "Background mobile", "default": "#0B1220" },
    { "type": "image_picker", "id": "bg_image_desktop", "label": "Desktop background image" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Mobile background image" },

    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": false },
    { "type": "image_picker", "id": "icon_image", "label": "Icon image" },

    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 8
    },

    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false }
  ],
  "presets": [{ "name": "Cora — Topbar Marquee ", "category": "Global" }]
}
{% endschema %}
