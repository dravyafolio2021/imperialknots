{{ 'cora-footer.css' | asset_url | stylesheet_tag }}

<section
  id="cora-footer-{{ section.id }}"
  class="cora-footer"
  role="contentinfo"
  aria-label="{{ section.settings.aria_label | default: 'Footer' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-footer__inner">
    <div class="cora-footer__top">
      
      <div class="cora-footer__brand" role="region" aria-label="Brand">
        <a href="{{ routes.root_url }}" class="cora-footer__logo-link" aria-label="{{ shop.name }}">
          {% if section.settings.logo %}
            <img
              src="{{ section.settings.logo | img_url: '400x' }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="{{ section.settings.logo_width }}"
              height="auto"
              style="width: {{ section.settings.logo_width }}px; max-width: 100%;"
            >
          {% else %}
            <span style="font-family:'Times New Roman', serif; font-size:24px; font-weight:bold; text-transform:uppercase;">{{ shop.name }}</span>
          {% endif %}
        </a>

        {% if section.settings.brand_description != blank %}
          <p class="cora-footer__brand-desc">{{ section.settings.brand_description }}</p>
        {% endif %}

        <div class="cora-footer__socials" aria-label="Follow us">
          {% for block in section.blocks %}
            {% if block.type == 'social' and block.settings.icon %}
              <a
                class="cora-footer__social-link"
                href="{{ block.settings.url | default: '#' }}"
                aria-label="{{ block.settings.label }}"
                target="{{ block.settings.target }}"
              >
                <img
                  src="{{ block.settings.icon | img_url: '64x64' }}"
                  alt="{{ block.settings.label }}"
                  width="40"
                  height="40"
                  loading="lazy"
                >
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="cora-footer__columns" role="navigation" aria-label="Footer menus">
        {% for block in section.blocks %}
          {% if block.type == 'link_column' %}
            <div class="cora-footer__col" aria-label="{{ block.settings.title }}">
              
              <button class="cora-footer__col-header" aria-expanded="false" onclick="this.parentElement.classList.toggle('is-open')">
                {% if block.settings.title != blank %}
                  <h4 class="cora-footer__col-title">{{ block.settings.title }}</h4>
                {% endif %}
                <span class="cora-footer__col-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </button>

              {% if block.settings.menu %}
                <ul class="cora-footer__links">
                  {% assign list_handle = block.settings.menu %}
                  {% for link in linklists[list_handle].links %}
                    <li class="cora-footer__link-item">
                      <a class="cora-footer__link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="cora-footer__divider" role="presentation" aria-hidden="true"></div>

    <div class="cora-footer__bottom">
      <div class="cora-footer__copyright">
        {% if section.settings.copyright_text != blank %}
          {{ section.settings.copyright_text }}
        {% else %}
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        {% endif %}
      </div>

      <div class="cora-footer__right">
        {% if section.settings.trust_text != blank %}
          <div class="cora-footer__trust">{{ section.settings.trust_text }}</div>
        {% endif %}
        
        {% if section.settings.show_payment_icons %}
           <div class="cora-footer__payments" aria-hidden="true">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              {% endfor %}
           </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cora Footer",
  "settings": [
    { "type": "header", "content": "Brand Settings" },
    { "type": "image_picker", "id": "logo", "label": "Logo Image" },
    { "type": "range", "id": "logo_width", "min": 50, "max": 300, "step": 10, "default": 180, "label": "Logo Width (px)" },
    { "type": "textarea", "id": "brand_description", "label": "Brand Description" },

    { "type": "header", "content": "Style & Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 5, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 100, "step": 5, "default": 60 },

    { "type": "header", "content": "Bottom Bar" },
    { "type": "text", "id": "copyright_text", "label": "Copyright Text" },
    { "type": "text", "id": "trust_text", "label": "Trust Text (Right side)" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show Payment Icons", "default": true }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column Title", "default": "Links" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "social",
      "name": "Social Icon",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (SVG/PNG)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Social" },
        { "type": "url", "id": "url", "label": "Link URL" },
        {
          "type": "select",
          "id": "target",
          "label": "Open in",
          "options": [
            { "value": "_self", "label": "Same Window" },
            { "value": "_blank", "label": "New Tab" }
          ],
          "default": "_blank"
        }
      ]
    }
  ],
  "presets": [{ "name": "Cora Footer", "category": "Global" }]
}
{% endschema %}


{% comment %} {{ 'cora-footer.css' | asset_url | stylesheet_tag }}

<section
  id="cora-footer-{{ section.id }}"
  class="cora-footer"
  role="contentinfo"
  aria-label="{{ section.settings.aria_label | default: 'Footer' }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-footer__inner">
    <div class="cora-footer__top">
      {%- comment -%} BRAND COLUMN (add only one brand block) {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'brand' %}
          <div class="cora-footer__brand" role="region" aria-label="Brand">
            {% if block.settings.logo %}
              <a href="{{ routes.root_url }}" class="cora-footer__logo-link" aria-label="{{ shop.name }}">
                <img
                  src="{{ block.settings.logo | img_url: '300x' }}"
                  alt="{{ shop.name }}"
                  loading="eager"
                  width="200"
                  height="60"
                >
              </a>
            {% else %}
              <!-- fallback demo image (replace with theme asset on deploy) -->
              <a href="{{ routes.root_url }}" class="cora-footer__logo-link" aria-label="{{ shop.name }}">
                <img
                  src="{{ 'fallback.png' | asset_url }}"
                  alt="{{ shop.name }}"
                  width="200"
                  height="60"
                  loading="lazy"
                >
              </a>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="cora-footer__brand-desc">{{ block.settings.description }}</p>
            {% endif %}

            <div class="cora-footer__socials" aria-label="Follow us">
              {% for icon_block in section.blocks %}
                {% if icon_block.type == 'social' and icon_block.settings.icon %}
                  <a
                    class="cora-footer__social-link"
                    href="{{ icon_block.settings.url | default: '#' }}"
                    aria-label="{{ icon_block.settings.label }}"
                    target="{{ icon_block.settings.target }}"
                  >
                    <img
                      src="{{ icon_block.settings.icon | img_url: '64x64' }}"
                      alt="{{ icon_block.settings.label }}"
                      width="40"
                      height="40"
                      loading="lazy"
                    >
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {%- comment -%} LINK COLUMNS (merchant can add multiple) {%- endcomment -%}
      <div class="cora-footer__columns" role="navigation" aria-label="Footer menus">
        {% for block in section.blocks %}
          {% if block.type == 'link_column' %}
            <div class="cora-footer__col" aria-label="{{ block.settings.title }}">
              {% if block.settings.title != blank %}
                <h4 class="cora-footer__col-title">{{ block.settings.title }}</h4>
              {% endif %}

              {% if block.settings.menu %}
                <ul class="cora-footer__links" aria-hidden="false">
                  {% assign list_handle = block.settings.menu %}
                  {% for link in linklists[list_handle].links %}
                    <li class="cora-footer__link-item">
                      <a class="cora-footer__link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <!-- /.cora-footer__top -->

    <div class="cora-footer__divider" role="presentation" aria-hidden="true"></div>

    <div class="cora-footer__bottom">
      <div class="cora-footer__copyright">
        {% if section.settings.copyright_text != blank %}
          {{ section.settings.copyright_text }}
        {% else %}
          &copy; {{ 'now' | date: '%Y' }}
          {{ shop.name }}. All rights reserved.
        {% endif %}
      </div>

      <div class="cora-footer__right">
        {% if section.settings.trust_text != blank %}
          <div class="cora-footer__trust">{{ section.settings.trust_text }}</div>
        {% endif %}

        {% comment %}
          {% if section.settings.show_payment_icons %}
            <div class="cora-footer__payments" aria-hidden="true">
              {% for type in shop.enabled_payment_types %}
                <span class="cora-footer__payment-icon">{% raw %}{{% endraw %} type | payment_type_svg_tag {% raw %}}{% endraw %}</span>
              {% endfor %}
            </div>
          {% endif %}
        {% endcomment %}
      </div>
    </div>
  </div>
</section>

