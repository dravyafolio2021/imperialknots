{% comment %}
  CORA HEADER - IMPERIAL KNOTS (Responsive + Multi-Promo + Custom Menus)
  Place this in sections/header-cora.liquid
{% endcomment %}

<style>
    /* --------------------------
       1. BASE LAYOUT & VARIABLES
    --------------------------- */
    :root {
      --header-height: {{ section.settings.header_height }}px;
      --header-bg: {{ section.settings.bg_color }};
      --header-text: {{ section.settings.text_color }};
    }

    .cora-header {
      background: var(--header-bg);
      color: var(--header-text);
      position: relative;
      border-bottom: 1px solid rgba(0,0,0,0.05);
      z-index: 1000;
    }

    .header-container {
      display: grid;
      /* Desktop: Logo | Nav | Icons */
      /* Mobile: Hamburger | Logo | Icons */
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      height: var(--header-height);
      max-width: var(--page-width, 1600px);
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* --------------------------
       2. LOGO (Centered)
    --------------------------- */
    .header-logo {
      justify-self: center;
      text-align: center;
      z-index: 1001;
    }

    .header-logo img {
      display: block;
      height: auto;
      max-width: 100%;
    }

    /* --------------------------
       3. DESKTOP NAVIGATION
    --------------------------- */
    .cora-nav-desktop {
      justify-self: center;
      display: flex;
      height: 100%;
      align-items: center;
      gap: 2.5rem;
    }

    /* Hide Desktop Nav on Mobile */
    @media screen and (max-width: 989px) {
      .cora-nav-desktop { display: none; }
      .header-logo { grid-column: 2; }
    }

    @media screen and (min-width: 990px) {
      .header-container {
        grid-template-columns: auto 1fr auto;
        padding: 0 ;
      }
      .header-logo { justify-self: start; }
    }
    @media screen and (max-width:764px){
     .header-container {
        grid-template-columns: auto 1fr auto;
        padding: 0 ;
    }}

    .nav-item {
      height: 100%;
      display: flex;
      align-items: center;
      cursor: pointer;
    }

    /* NEW: Anchor specific nav items for compact dropdowns */
    .nav-item.is-dropdown {
      position: relative;
    }

    .nav-link {
      text-decoration: none;
      color: currentColor;
      font-weight: 500;
      font-size: 0.95rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 0.5rem 0;
      position: relative;
    }

    .nav-link:hover { opacity: 0.7; }

    /* --------------------------
       4. MEGA MENU (Desktop)
    --------------------------- */
    .mega-menu-container {
      visibility: hidden;
      opacity: 0;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      /* Default Full Width */
      background: #ffffff;
      border-top: 1px solid #e5e5e5;
      border-bottom: 1px solid #e5e5e5;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      z-index: 999;
      transform: translateY(10px);
      transition: all 0.25s ease;
    }

    /* Override for Compact Dropdowns (The New Block) */
    .nav-item.is-dropdown .mega-menu-container {
      width: max-content;
      /* Shrink to fit content */
      min-width: 200px;
      padding: 0 36px;
      max-width: 90vw;
      left: 0;
      /* Align with left edge of link */
      border: 1px solid #e5e5e5;
      /* Full border for floating dropdown */
    }

    .nav-item:hover .mega-menu-container {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .mega-menu-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 3rem 2rem;
      display: grid;
      /* Default Layout: Menu1 Menu2 | Promo Promo Promo */
      grid-template-columns: 1.2fr 1.2fr 1fr 1fr 1fr;
      gap: 2rem;
    }

    /* --- CENTERED COLUMNS LOGIC --- */
    
    /* 1. Reset & Center the Columns Content Globally */
    .mm-column {
      display: flex;
      flex-direction: column;
      align-items: center; /* Centers items horizontally */
      text-align: center;
      /* Centers text inside items */
      width: 100%;
    }

    /* 2. Remove default list padding to fix off-center alignment */
    .mm-column ul {
      list-style: none;
      padding: 0 !important; /* Force remove left padding */
      margin: 0 !important;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .mm-column li {
      width: 100%;
      margin-bottom: 0.8rem;
    }
    
    /* ------------------------------ */

    /* Headings */
    .mm-column h4 {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
      letter-spacing: 0.05em;
      color: #000;
      width: 100%;
      text-align: center;
    }

    .mm-column a {
      text-decoration: none;
      color: #555;
      font-size: 0.9rem;
      transition: color 0.2s;
      text-transform: uppercase;
      white-space: nowrap; /* Prevent breaking lines in compact mode */
    }
    .mm-column a:hover { color: #000;
      text-decoration: underline; }

    /* Layout: Simple Flex Columns (If used) */
    .mega-menu-inner.simple-columns {
      display: flex;
      justify-content: center;
      gap: 5rem;
      padding: 3rem 0;
    }

    /* Promo Cards */
    .mm-promo-card {
      position: relative;
      height: 320px;
      width: 100%;
      overflow: hidden;
      text-decoration: none;
    }

    .mm-promo-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    /* Column Borders (Specific to the grid layout) */
    .mega-menu-inner > .mm-column:nth-child(2) {
      border-left: 1px solid rgba(0, 0, 0, 0.1);
      padding-left: 20px;
      padding-right: 20px;
    }
    .mega-menu-inner > .mm-column:nth-child(3) {
      border-left: 1px solid rgba(0, 0, 0, 0.1);
      padding-left: 20px;
      padding-right: 20px;
    }

    .mm-promo-card:hover img { transform: scale(1.05); }

    .mm-promo-overlay {
      position: absolute;
      border-radius: 6px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #ffffff;
      padding: 1rem 1.5rem;
      min-width: 70%;
      text-align: center;
      color: #000;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

   /* --------------------------
       5. MOBILE MENU (Drawer)
    --------------------------- */
    .header-mobile-toggle {
      display: none;
      justify-self: start;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      color: currentColor;
    }

    .mobile-drawer {
      position: fixed;
      top: 0; left: -100%;
      width: 85%;
      max-width: 400px;
      height: 100vh;
      background: #fff;
      z-index: 2000;
      transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 2.5rem 2rem;
      overflow-y: auto;
      box-shadow: 4px 0 15px rgba(0,0,0,0.05);
      
      /* Hide scrollbar for Chrome, Safari and Opera */
      &::-webkit-scrollbar {
        display: none;
      }
      /* Hide scrollbar for IE, Edge and Firefox */
      -ms-overflow-style: none;  
      scrollbar-width: none;  
    }

    .mobile-drawer.active { 
      left: 0; 
    }

    .mobile-overlay {
      position: fixed; top: 0;
      left: 0; width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(2px); /* Slight blur effect */
      z-index: 1999;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }
    
    .mobile-overlay.active { 
      opacity: 1; 
      visibility: visible; 
    }

    .drawer-close {
      position: absolute; 
      top: 1.5rem;
      right: 1.5rem;
      background: #f5f5f5;
      border: none;
      font-size: 1.2rem; 
      cursor: pointer;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }
    
    .drawer-close:hover {
      background: #e5e5e5;
    }

    .mobile-nav-list { 
      list-style: none; 
      padding: 0; 
      margin-top: 2.5rem; 
    }
    
    .mobile-nav-item { 
      border-bottom: 1px solid #f0f0f0; 
    }

    .mobile-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%; 
      padding: 1.2rem 0;
      text-decoration: none; 
      color: #121212;
      font-size: 0.95rem; 
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: none; 
      border: none;
      text-align: left; 
      cursor: pointer;
    }

    /* Style the + / - icons */
    .mobile-link span {
      font-size: 1.5rem;
      font-weight: 300;
      color: #888;
      line-height: 1;
      transition: transform 0.3s ease;
    }

    .mobile-submenu { 
      display: none; 
      padding: 0.5rem 0 1.5rem 0; 
      background: #ffffff; 
    }
    
    .mobile-submenu.open { 
      display: block; 
      animation: slideDown 0.3s ease forwards;
    }

    /* Modern indented look instead of gray background */
    .mobile-submenu a { 
      display: block; 
      padding: 0.7rem 1rem; 
      text-decoration: none; 
      color: #555;
      font-size: 1rem;
      border-left: 2px solid #eee;
      margin-left: 0.5rem;
      transition: all 0.2s ease;
    }

    .mobile-submenu a:hover {
      color: #000;
      border-left-color: #000;
      background: #fafafa;
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-5px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media screen and (max-width: 989px) {
      .header-mobile-toggle { display: block; }
    }

    /* --------------------------
       6. ICONS
    --------------------------- */
    .header-icons {
      justify-self: end;
      display: flex; align-items: center; gap: 1rem;
    }

    .icon-link svg{
      height:22px; width:22px;
    }
    .icon-link { color: currentColor; text-decoration: none; position: relative; }
    .cart-count-bubble {
      position: absolute; top: -5px; right: -8px;
      background: #000;
      color: #fff;
      font-size: 10px;
      font-weight: bold;
      height: 18px; width: 18px;
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
    }
</style>
<header class="cora-header">
  <div class="header-container">
    <button class="header-mobile-toggle" onclick="toggleDrawer()">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width }}"
            height="auto"
          >
        {% else %}
          <span style="font-size: 1.5rem; text-transform: uppercase; letter-spacing: 0.1em;">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <nav class="cora-nav-desktop">
      {% for link in linklists[section.settings.menu].links %}
        {% comment %}
          Logic moved UP to wrap the nav-item correctly for styling
        {% endcomment %}
        {% assign mega_block = null %}
        
        {% assign link_handle = link.title | handleize %}

        {% for block in section.blocks %}
          {% assign trigger = block.settings.menu_trigger | handleize %}
          {% if trigger == link_handle %}
            {% assign mega_block = block %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div class="nav-item {% if mega_block.type == 'mega_menu_links' %}is-dropdown{% endif %}">
          <a href="{{ link.url }}" class="nav-link">{{ link.title }}</a>

          {% if mega_block %}
            <div class="mega-menu-container">
              {% if mega_block.type == 'mega_menu_links' %}
                <div class="mega-menu-inner simple-columns">
                  {% if mega_block.settings.menu_1 != blank %}
                    <div class="mm-column">
                      {% comment %} <h4>{{ linklists[mega_block.settings.menu_1].title }}</h4> {% endcomment %}
                      <ul>
                        {% for sub_link in linklists[mega_block.settings.menu_1].links %}
                          <li>
                            <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if mega_block.settings.menu_2 != blank %}
                    <div class="mm-column">
                      {% comment %} <h4>{{ linklists[mega_block.settings.menu_2].title }}</h4> {% endcomment %}
                      <ul>
                        {% for sub_link in linklists[mega_block.settings.menu_2].links %}
                          <li>
                            <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}

                  {% if mega_block.settings.menu_3 != blank %}
                    <div class="mm-column">
                      {% comment %} <h4>{{ linklists[mega_block.settings.menu_3].title }}</h4> {% endcomment %}
                      <ul>
                        {% for sub_link in linklists[mega_block.settings.menu_3].links %}
                          <li>
                            <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endif %}
                </div>

              {% else %}
                <div class="mega-menu-inner">
                  <div class="mm-column">
                    {% if mega_block.settings.custom_menu_1 != blank %}
                      {% comment %} <h4>{{ linklists[mega_block.settings.custom_menu_1].title }}</h4> {% endcomment %}
                      <ul>
                        {% for sub_link in linklists[mega_block.settings.custom_menu_1].links %}
                          <li>
                            <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% elsif link.links.size > 0 %}
                      {% assign child_1 = link.links[0] %}
                      <h4>
                        <a href="{{ child_1.url }}">{{ child_1.title }}</a>
                      </h4>
                      <ul>
                        {% for grand_child in child_1.links %}
                          <li>
                            <a href="{{ grand_child.url }}">{{ grand_child.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% else %}
                       <p>Select a menu in block settings.</p>
                    {% endif %}
                  </div>

                  <div class="mm-column">
                    {% if mega_block.settings.custom_menu_2 != blank %}
                      {% comment %} <h4>{{ linklists[mega_block.settings.custom_menu_2].title }}</h4> {% endcomment %}
                      <ul>
                        {% for sub_link in linklists[mega_block.settings.custom_menu_2].links %}
                          <li>
                            <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% elsif link.links.size > 1 %}
                      {% assign child_2 = link.links[1] %}
                      <h4>
                         <a href="{{ child_2.url }}">{{ child_2.title }}</a>
                      </h4>
                      <ul>
                        {% for grand_child in child_2.links %}
                          <li>
                            <a href="{{ grand_child.url }}">{{ grand_child.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                  <div class="mm-column">
                    {% if mega_block.settings.custom_menu_3 != blank %}
                      {% comment %} <h4>{{ linklists[mega_block.settings.custom_menu_3].title }}</h4> {% endcomment %}
                      <ul>
                        {% for sub_link in linklists[mega_block.settings.custom_menu_3].links %}
                          <li>
                            <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% elsif link.links.size > 1 %}
                      {% assign child_3 = link.links[1] %}
                      <h4>
                        <a href="{{ child_3.url }}">{{ child_3.title }}</a>
                      </h4>
                      <ul>
                        {% for grand_child in child_3.links %}
                          <li>
                            <a href="{{ grand_child.url }}">{{ grand_child.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>

                  <a href="{{ mega_block.settings.promo_1_link }}" class="mm-promo-card">
                    {% if mega_block.settings.promo_1_img %}
                      <img src="{{ mega_block.settings.promo_1_img | image_url: width: 400 }}" loading="lazy">
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag }}
                    {% endif %}
                    <div class="mm-promo-overlay">{{ mega_block.settings.promo_1_text }}</div>
                  </a>

                  <a href="{{ mega_block.settings.promo_2_link }}" class="mm-promo-card">
                    {% if mega_block.settings.promo_2_img %}
                      <img src="{{ mega_block.settings.promo_2_img | image_url: width: 400 }}" loading="lazy">
                    {% else %}
                      {{ 'collection-2' | placeholder_svg_tag }}
                    {% endif %}
                    <div class="mm-promo-overlay">{{ mega_block.settings.promo_2_text }}</div>
                  </a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <div class="header-icons">
      <a href="{{ routes.search_url }}" class="icon-link">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="icon-link">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2L3 6V20C3 20.53 3.21 21.03 3.58 21.41C3.96 21.78 4.46 22 5 22H19C19.53 22 20.03 21.78 20.41 21.41C20.78 21.03 21 20.53 21 20V6L18 2H6Z"></path><path d="M3 6H21"></path><path d="M16 10C16 11.06 15.57 12.07 14.82 12.82C14.07 13.57 13.06 14 12 14C10.93 14 9.92 13.57 9.17 12.82C8.42 12.07 8 11.06 8 10"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <div class="cart-count-bubble">{{ cart.item_count }}</div>
        {% endif %}
      </a>
       <a href="https://shopify.com/78884929843/account"  class="icon-link">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M5 21C5 17.134 8.13401 14 12 14C15.866 14 19 17.134 19 21M16 7C16 9.20914 14.2091 11 12 11C9.79086 11 8 9.20914 8 7C8 4.79086 9.79086 3 12 3C14.2091 3 16 4.79086 16 7Z" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
      </a>
    </div>
  </div>
</header>

<div class="mobile-overlay" onclick="toggleDrawer()"></div>
<div class="mobile-drawer" id="mobileDrawer">
  <button class="drawer-close" onclick="toggleDrawer()">&times;</button>
  <ul class="mobile-nav-list">
    {% assign mobile_menu_handle = section.settings.mobile_menu | default: section.settings.menu %}
    {% for link in linklists[mobile_menu_handle].links %}
      <li class="mobile-nav-item">
        {% if link.links != blank %}
          <button class="mobile-link" onclick="toggleSubmenu(this)">
            {{ link.title }}
            <span>+</span>
          </button>
          <div class="mobile-submenu">
            {% for child in link.links %}
              <a href="{{ child.url }}">{{ child.title }}</a>
            {% endfor %}
          </div>
        {% else %}
          <a href="{{ link.url }}" class="mobile-link">{{ link.title }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>

<script>
  function toggleDrawer() {
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.querySelector('.mobile-overlay');
    drawer.classList.toggle('active');
    overlay.classList.toggle('active');
  }

  function toggleSubmenu(btn) {
    const btnSpan = btn.querySelector('span');
    const submenu = btn.nextElementSibling;
    submenu.classList.toggle('open');
    if (btnSpan) btnSpan.textContent = submenu.classList.contains('open') ? '-' : '+';
  }
</script>

{% schema %}
{
  "name": "Cora Header (Responsive)",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 50, "max": 250, "step": 5, "default": 140, "label": "Logo Width" },
    { "type": "link_list", "id": "menu", "label": "Desktop Menu", "default": "main-menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile Menu", "info": "If left blank, the Desktop Menu will be used." },
    { "type": "range", "id": "header_height", "min": 50, "max": 120, "step": 5, "default": 80, "label": "Height" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu  ",
      "settings": [
        { "type": "text", "id": "menu_trigger", "label": "Trigger Word", "info": "E.g. 'Collections'" },

        { "type": "header", "content": "Text Columns" },
        { "type": "paragraph", "content": "Select menus to override automatic nested links." },
        { "type": "link_list", "id": "custom_menu_1", "label": "Column 1 Menu" },
        { "type": "link_list", "id": "custom_menu_2", "label": "Column 2 Menu" },
        { "type": "link_list", "id": "custom_menu_3", "label": "Column 3 Menu" },

        { "type": "header", "content": "Promo Card 1" },
        { "type": "image_picker", "id": "promo_1_img", "label": "Image" },
        { "type": "text", "id": "promo_1_text", "label": "Overlay Text", "default": "In-Stock" },
        { "type": "url", "id": "promo_1_link", "label": "Link" },

        { "type": "header", "content": "Promo Card 2" },
        { "type": "image_picker", "id": "promo_2_img", "label": "Image" },
        { "type": "text", "id": "promo_2_text", "label": "Overlay Text", "default": "Luxe" },
        { "type": "url", "id": "promo_2_link", "label": "Link" }
      ]
    },
    {
      "type": "mega_menu_links",
      "name": "Mega Menu links ",
      "settings": [
        { "type": "text", "id": "menu_trigger", "label": "Trigger Word", "info": "E.g. 'Shop'" },
