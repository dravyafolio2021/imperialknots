{{ 'cora-header.css' | asset_url | stylesheet_tag }}

<header
  id="cora-header-{{ section.id }}"
  class="cora-header"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
>
  <input type="checkbox" id="cora-nav-toggle" style="display:none;">
  <label for="cora-nav-toggle" class="cora-mobile-overlay"></label>

  <div class="cora-header__inner">
    <div class="cora-header__mobile-trigger">
      <label for="cora-nav-toggle" class="cora-header__hamburger">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </label>
    </div>

    <div class="cora-header__left">
      <a href="{{ routes.root_url }}" class="cora-header__brand-link">
        {% if section.settings.logo_image %}
          <img
            src="{{ section.settings.logo_image | img_url: '400x' }}"
            alt="{{ shop.name }}"
            class="cora-header__logo-img"
            width="{{ section.settings.logo_width }}"
            height="auto"
          >
        {% else %}
          <span class="cora-header__brand-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="cora-header__center">
      <nav class="cora-header__nav">
        {% for link in section.settings.menu.links %}
          <div class="cora-nav__item">
            <a href="{{ link.url }}" class="cora-nav__link">
              {{ link.title }}
              {% if link.links != blank %}
                <svg class="cora-chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor">
                  <path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {% endif %}
            </a>

            {% if link.links != blank %}
              <div class="cora-nav__dropdown">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}" class="cora-dropdown__link">{{ child_link.title }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>
    </div>

    <div class="cora-header__right">
      <a href="{{ routes.search_url }}" class="cora-header__icon" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="cora-header__icon" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="cora-cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="cora-header__icon" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="cora-mobile-drawer">
    <div class="cora-drawer__header">
      <span style="font-weight:600; font-size:16px; text-transform:uppercase; letter-spacing:1px;">Menu</span>
      <label for="cora-nav-toggle" class="cora-drawer__close">&times;</label>
    </div>

    <nav class="cora-drawer__nav">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="cora-drawer__link">{{ link.title }}</a>
        {% for child_link in link.links %}
          <a
            href="{{ child_link.url }}"
            class="cora-drawer__link"
            style="padding-left: 20px; opacity: 0.8; font-size: 14px;"
            >— {{ child_link.title -}}
          </a>
        {% endfor %}
      {% endfor %}

      {% if shop.customer_accounts_enabled %}
        <a
          href="{{ routes.account_url }}"
          class="cora-drawer__link"
          style="margin-top:20px; border-top:1px solid #eee; padding-top:20px;"
          >Account</a
        >
      {% endif %}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Cora Header (Responsive)",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo Image" },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 150,
      "label": "Logo Width (px)"
    },
    { "type": "link_list", "id": "menu", "label": "Main Menu", "default": "main-menu" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1a1a1a" }
  ],
  "presets": [{ "name": "Cora Header (Responsive)" }]
}
{% endschema %}
