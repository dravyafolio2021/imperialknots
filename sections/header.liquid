{{ 'cora-header.css' | asset_url | stylesheet_tag }}

<header
  id="cora-header-{{ section.id }}"
  class="cora-header"
  role="banner"
  aria-label="Main header"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top | default: 18 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 18 }}px;
    {% if section.settings.bg_image %} background-image: url({{ section.settings.bg_image | img_url: '2000x' }}); background-size: cover; background-position: center; {% endif %}
  "
>
  <div class="cora-header__inner">
    <!-- left: hamburger (mobile) + primary nav (desktop) -->
    <div class="cora-header__left">
      <label
        for="cora-nav-toggle-{{ section.id }}"
        class="cora-header__hamburger"
        aria-hidden="false"
        aria-controls="cora-mobile-nav-{{ section.id }}"
      >
        <svg
          width="22"
          height="16"
          viewBox="0 0 22 16"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="22" height="2" rx="1" y="0" fill="currentColor"/><rect width="22" height="2" rx="1" y="7" fill="currentColor"/><rect width="22" height="2" rx="1" y="14" fill="currentColor"/>
        </svg>
      </label>
      <input id="cora-nav-toggle-{{ section.id }}" class="cora-nav-toggle" type="checkbox" aria-hidden="true">

      <nav class="cora-header__nav" role="navigation" aria-label="Primary">
        {% for link in section.settings.menu.links %}
          <a
            href="{{ link.url }}"
            {% if link.target %}
              target="{{ link.target }}"
            {% endif %}
            class="cora-header__nav-link"
            aria-haspopup="false"
          >
            {{- link.title -}}
          </a>
        {% endfor %}
      </nav>
    </div>

    <!-- center: brand -->
    <div class="cora-header__center">
      <div class="cora-header__brand">
        {% if section.settings.logo_image %}
          <a href="{{ routes.root_url }}" class="cora-header__logo-link" aria-label="{{ shop.name }}">
            <img src="{{ section.settings.logo_image | img_url: '300x' }}" alt="{{ shop.name }}" width="" height="" loading="eager">
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="cora-header__brand-text">{{ shop.name }}</a>
        {% endif %}
      </div>
    </div>

    <!-- right: icons -->
    <div class="cora-header__right">
      <a class="cora-header__icon cora-header__icon--search" href="{{ routes.search_url }}" aria-label="Search">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="11" cy="11" r="6" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </a>

      <a class="cora-header__icon cora-header__icon--cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {% if cart.item_count > 0 %}
          <span class="cora-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {% endif %}
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M6 6h15l-1.6 9.6a2 2 0 0 1-2 1.6H8.6a2 2 0 0 1-2-1.6L5 3H3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      {% if shop.customer_accounts_enabled %}
        <a class="cora-header__icon cora-header__icon--account" href="{{ routes.account_url }}" aria-label="Account">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  <!-- mobile dropdown nav (checkbox hack) -->
  <div id="cora-mobile-nav-{{ section.id }}" class="cora-header__mobile-nav" role="navigation" aria-label="Mobile menu">
    <ul class="cora-header__mobile-list">
      {% for link in section.settings.menu.links %}
        <li class="cora-header__mobile-item">
          <a
            href="{{ link.url }}"
            class="cora-header__mobile-link"
            {% if link.target %}
              target="{{ link.target }}"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "Cora — Header",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text / icon color", "default": "#111111" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 18
    },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (desktop)" },
    { "type": "link_list", "id": "menu", "label": "Main menu" }
  ],
  "presets": [{ "name": "Cora — Header (Updated)", "category": "Global" }]
}
{% endschema %}
