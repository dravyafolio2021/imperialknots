{{ 'cora-header.css' | asset_url | stylesheet_tag }}

<header
  id="cora-header-{{ section.id }}"
  class="cora-header"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
>
  <input type="checkbox" id="cora-nav-toggle" style="display:none;">
  <label for="cora-nav-toggle" class="cora-mobile-overlay"></label>

  <div class="cora-header__inner">
    
    <div class="cora-header__mobile-trigger">
      <label for="cora-nav-toggle" class="cora-header__hamburger">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </label>
    </div>

    <div class="cora-header__left">
      <a href="{{ routes.root_url }}" class="cora-header__brand-link">
        {%- if section.settings.logo_svg != blank -%}
          <div class="cora-header__logo-svg" style="width: {{ section.settings.logo_width }}px; max-width: 100%; display: flex; align-items: center;">
            <style>.cora-header__logo-svg svg { width: 100%; height: auto; }</style>
            {{ section.settings.logo_svg }}
          </div>
        {%- elsif section.settings.logo_image != blank -%}
          <img 
            src="{{ section.settings.logo_image | img_url: '600x' }}" 
            alt="{{ shop.name }}" 
            class="cora-header__logo-img" 
            width="{{ section.settings.logo_width }}" 
            height="auto"
            style="width: {{ section.settings.logo_width }}px;"
          >
        {%- else -%}
          <img 
            src="https://cdn.shopify.com/s/files/1/0694/0170/6565/files/Logo_430x.svg?v=1765908401#" 
            alt="{{ shop.name }}" 
            class="cora-header__logo-img" 
            width="{{ section.settings.logo_width }}" 
            height="auto"
            style="width: {{ section.settings.logo_width }}px;"
          >
        {%- endif -%}
      </a>
    </div>
    
    <div class="cora-header__center">
      <nav class="cora-header__nav">
        {% for link in section.settings.menu.links %}
          
          {% comment %} --- 1. FIND MATCHING BLOCK --- {% endcomment %}
          {% assign mega_menu_block = nil %}
          {% for block in section.blocks %}
            {% if block.type == 'mega_menu' %}
              {% assign trigger_handle = block.settings.trigger_link | handleize %}
              {% assign link_handle = link.title | handleize %}
              {% if trigger_handle == link_handle %}
                {% assign mega_menu_block = block %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}

          <div class="cora-nav__item {% if mega_menu_block %}has-mega-menu{% endif %}">
            <a href="{{ link.url }}" class="cora-nav__link">
              {{ link.title }}
              {% if link.links != blank or mega_menu_block %}<svg class="cora-chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor"><path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round"/></svg>{% endif %}
            </a>
            
            {% comment %} --- 2. RENDER MEGA MENU (If Block Found) --- {% endcomment %}
            {% if mega_menu_block %}
              <div class="cora-megamenu-wrapper">
                <div class="cora-mm-container">
                  <div class="cora-mm-links">
                    {% for child_link in link.links limit: 2 %}
                      <div class="cora-mm-col">
                        <h4 class="cora-mm-heading">{{ child_link.title }}</h4>
                        <ul class="cora-mm-list">
                          {% for grandchild in child_link.links %}
                            <li><a href="{{ grandchild.url }}" class="cora-mm-link">{{ grandchild.title }}</a></li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endfor %}
                  </div>

                  <div class="cora-mm-promos">
                    {% if mega_menu_block.settings.promo_1_image %}
                      <a href="{{ mega_menu_block.settings.promo_1_link }}" class="cora-mm-card">
                        <div class="cora-mm-image-wrap"><img src="{{ mega_menu_block.settings.promo_1_image | img_url: '400x500', crop: 'center' }}" loading="lazy"></div>
                        <div class="cora-mm-label"><span>{{ mega_menu_block.settings.promo_1_title }}</span></div>
                      </a>
                    {% endif %}
                    {% if mega_menu_block.settings.promo_2_image %}
                      <a href="{{ mega_menu_block.settings.promo_2_link }}" class="cora-mm-card">
                        <div class="cora-mm-image-wrap"><img src="{{ mega_menu_block.settings.promo_2_image | img_url: '400x500', crop: 'center' }}" loading="lazy"></div>
                        <div class="cora-mm-label"><span>{{ mega_menu_block.settings.promo_2_title }}</span></div>
                      </a>
                    {% endif %}
                    {% if mega_menu_block.settings.promo_3_image %}
                      <a href="{{ mega_menu_block.settings.promo_3_link }}" class="cora-mm-card">
                        <div class="cora-mm-image-wrap"><img src="{{ mega_menu_block.settings.promo_3_image | img_url: '400x500', crop: 'center' }}" loading="lazy"></div>
                        <div class="cora-mm-label"><span>{{ mega_menu_block.settings.promo_3_title }}</span></div>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>

            {% comment %} --- 3. RENDER STANDARD DROPDOWN (If No Block) --- {% endcomment %}
            {% elsif link.links != blank %}
              <div class="cora-nav__dropdown">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}" class="cora-dropdown__link">{{ child_link.title }}</a>
                {% endfor %}
              </div>
            {% endif %}

          </div>
        {% endfor %}
      </nav>
    </div>

    <div class="cora-header__right">
      <a href="{{ routes.search_url }}" class="cora-header__icon" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="cora-header__icon" aria-label="Cart" style="margin-right: 5px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        {% if cart.item_count > 0 %}<span class="cora-cart-count">{{ cart.item_count }}</span>{% endif %}
      </a>
    </div>

  </div>

  <div class="cora-mobile-drawer">
    <div class="cora-drawer__header">
      <span style="font-weight:600; font-size:16px; text-transform:uppercase; letter-spacing:1px;">Menu</span>
      <label for="cora-nav-toggle" class="cora-drawer__close">&times;</label>
    </div>

    <nav class="cora-drawer__nav">
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <details class="cora-drawer__accordion">
            <summary class="cora-drawer__summary">
              {{ link.title }}
              <span class="cora-drawer__icon"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor"><path d="M6 1V11M1 6H11" stroke-width="1.5" stroke-linecap="round"/></svg></span>
            </summary>
            <div class="cora-drawer__submenu">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}" class="cora-drawer__link cora-drawer__sublink">{{ child_link.title }}</a>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a href="{{ link.url }}" class="cora-drawer__link">{{ link.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    
    <div class="cora-drawer__footer">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <a href="{{ routes.account_url }}" class="cora-drawer__cta">My Account</a>
        {% else %}
          <div style="display: flex; gap: 12px;">
            <a href="{{ routes.account_login_url }}" class="cora-btn-shadcn cora-btn-ghost" style="flex: 1; border: 1px solid #e2e8f0; justify-content: center;">Log in</a>
            <a href="{{ routes.account_register_url }}" class="cora-btn-shadcn cora-btn-primary" style="flex: 1; justify-content: center;">Sign up</a>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Cora Header",
  "settings": [
    { "type": "header", "content": "Logo Settings" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo Image" },
    { "type": "html", "id": "logo_svg", "label": "Custom SVG Logo" },
    { "type": "range", "id": "logo_width", "min": 100, "max": 300, "step": 2, "default": 150, "label": "Logo Width (px)" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Main Menu", "default": "main-menu" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "settings": [
        { "type": "text", "id": "trigger_link", "label": "Trigger Link Name", "info": "Type the menu item name (e.g. Catalog)", "default": "Catalog" },
        
        { "type": "header", "content": "Promo 1" },
        { "type": "image_picker", "id": "promo_1_image", "label": "Image" },
        { "type": "text", "id": "promo_1_title", "label": "Title", "default": "In-Stock" },
        { "type": "url", "id": "promo_1_link", "label": "Link" },
        
        { "type": "header", "content": "Promo 2" },
        { "type": "image_picker", "id": "promo_2_image", "label": "Image" },
        { "type": "text", "id": "promo_2_title", "label": "Title", "default": "Luxe" },
        { "type": "url", "id": "promo_2_link", "label": "Link" },
        
        { "type": "header", "content": "Promo 3" },
        { "type": "image_picker", "id": "promo_3_image", "label": "Image" },
        { "type": "text", "id": "promo_3_title", "label": "Title", "default": "Best Sellers" },
        { "type": "url", "id": "promo_3_link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Cora Header" }]
}
{% endschema %}