{{ 'cora-header.css' | asset_url | stylesheet_tag }}

<header class="cora-header">
  <div class="cora-header__inner">

    <!-- LOGO -->
    <div class="cora-header__left">
      <a href="{{ routes.root_url }}" class="cora-header__brand-link">
        {{ shop.name }}
      </a>
    </div>

    <!-- NAV -->
    <nav class="cora-header__nav">
      {% for link in section.settings.menu.links %}
        <div class="cora-nav__item" data-trigger="{{ link.title | handleize }}">
          <a href="{{ link.url }}" class="cora-nav__link">
            {{ link.title }}
            {% if link.links != blank %}
              <svg
                class="cora-chevron"
                viewBox="0 0 10 6"
                fill="none"
                stroke="currentColor"
              >
                <path d="M1 1L5 5L9 1" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            {% endif %}
          </a>

          {% if link.links != blank %}
            <div class="cora-nav__dropdown">
              {% for child in link.links %}
                <a href="{{ child.url }}" class="cora-dropdown__link">
                  {{ child.title }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

  </div>

  <!-- MEGA MENUS -->
  {% for block in section.blocks %}
    {% if block.type == 'mega_menu' %}
      <div
        class="cora-megamenu"
        data-menu-handle="{{ block.settings.nav_title | handleize }}"
      >
        <div class="cora-megamenu__inner">
          {% for link in block.settings.menu.links %}
            <div>
              <strong>{{ link.title }}</strong>
              {% for child in link.links %}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endfor %}
</header>

<script>
document.querySelectorAll('.cora-nav__item').forEach(item => {
  const handle = item.dataset.trigger
  const mega = document.querySelector(
    `.cora-megamenu[data-menu-handle="${handle}"]`
  )

  if (!mega) return

  item.addEventListener('mouseenter', () => {
    mega.classList.add('is-active')
  })

  item.addEventListener('mouseleave', () => {
    setTimeout(() => {
      if (!mega.matches(':hover')) {
        mega.classList.remove('is-active')
      }
    }, 100)
  })

  mega.addEventListener('mouseleave', () => {
    mega.classList.remove('is-active')
  })
})
</script>

{% schema %}
{
  "name": "Cora Header – Stable",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu",
      "settings": [
        {
          "type": "text",
          "id": "nav_title",
          "label": "Nav item title (exact)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Mega menu links"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Cora Header – Stable" }
  ]
}
{% endschema %}
