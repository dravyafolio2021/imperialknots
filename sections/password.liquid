{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}




{{ 'cora-password.css' | asset_url | stylesheet_tag }}

<section 
  class="cora-password-section" 
  style="{% if section.settings.bg_image %}background-image: url('{{ section.settings.bg_image | img_url: '2000x' }}');{% endif %}"
>
  
  <div class="cora-password-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="cora-password-card">
    
    {% if section.settings.logo %}
      <img 
        src="{{ section.settings.logo | img_url: '400x' }}" 
        alt="{{ shop.name }}" 
        class="cora-password-logo"
        width="{{ section.settings.logo_width }}"
        height="auto"
      >
    {% else %}
      <h2 class="cora-password-title" style="margin-bottom: 30px;">{{ shop.name }}</h2>
    {% endif %}

    <h1 class="cora-password-title">{{ section.settings.heading | default: 'Exclusive Access' }}</h1>
    
    {% if shop.password_message != blank %}
      <div class="cora-password-msg">
        {{ shop.password_message }}
      </div>
    {% else %}
      <p class="cora-password-msg">{{ section.settings.text }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'cora-password-form' %}
      
      {% if form.errors %}
        <div class="cora-form-error">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="cora-input-group">
        <input 
          type="password" 
          name="password" 
          id="password-input" 
          class="cora-password-input" 
          placeholder="{{ 'password.password' | t }}"
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="cora-password-btn">
        {{ 'password.enter' | t }}
      </button>

    {% endform %}

    <div class="cora-password-footer">
      <p>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}</p>
      <p>Are you the store owner? <a href="/admin">Log in here</a></p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Password Page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo Image" },
    { "type": "range", "id": "logo_width", "min": 50, "max": 300, "step": 10, "default": 150, "label": "Logo Width" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Private Access" },
    { "type": "textarea", "id": "text", "label": "Subtext", "default": "Our online boutique is currently private. Please enter your password to enter." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 10, "default": 40, "label": "Overlay Opacity %" }
  ]
}
{% endschema %}
{% comment %} <h1>{{ 'password.title' | t }}</h1>

{% if shop.password_message %}
  <p>{{ shop.password_message }}</p>
{% endif %}

{% form 'storefront_password' %}
  {% if form.errors %}
    {{ form.errors | default_errors }}
  {% endif %}

  <label for="password-input">
    {{ 'password.password' | t }}
  </label>

  <input type="password" name="password" id="password-input">

  <button type="submit">
    {{ 'password.enter' | t }}
  </button>
{% endform %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %} {% endcomment %}
