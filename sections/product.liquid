{% comment %}
  SECTION: CORA MAIN PRODUCT
  Design: Custom Split Layout with Variant Pills
{% endcomment %}

{{ 'cora-main-product.css' | asset_url | stylesheet_tag }}

{% style %}
    /* --- 7. MOBILE RESPONSIVENESS --- */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .cmp-container {
      flex-direction: column !important;
      gap: 30px !important;
    }

    #shopify-section-{{ section.id }} .cmp-info {
      width: 100% !important;
      flex: auto !important;
      position: static !important;
    }

    .cmp-gallery {
      width: 100% !important;
      max-width: 100% !important;
    }
  }
{% endstyle %}

<section class="cmp-section" id="MainProduct-{{ section.id }}">
  <div class="cmp-container">
    <div class="cmp-gallery">
      <div class="cmp-main-image">
        {%- if product.featured_image -%}
          <img
            id="MainImg-{{ section.id }}"
            width=""
            height=""
            src="{{ product.featured_image | img_url: '1200x' }}"
            alt="{{ product.title }}"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
        <div class="cmp-image-counter">1 / {{ product.images.size }}</div>
      </div>
       <div class="cmp-meta">
        {%- if product.collections.first -%}
          <span class="cmp-category">{{ product.collections.first.title }}</span>
        {%- endif -%}
        
      </div>

      {%- if product.images.size > 1 -%}
        <div class="cmp-thumbnails">
          {%- for media in product.images -%}
            <div
              class="cmp-thumb {% if forloop.first %}active{% endif %}"
              onclick="changeImage('{{ media | img_url: '1200x' }}', this)"
            >
              <img src="{{ media | img_url: '200x' }}" width="" height="" alt="{{ media.alt }}">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="cmp-info">
      <div class="cmp-meta">
        {%- if product.collections.first -%}
          <span class="cmp-category">{{ product.collections.first.title }}</span>
        {%- endif -%}
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        <span class="cmp-sku"
          >SKU: <span id="Sku-{{ section.id }}">{{ current_variant.sku | default: 'N/A' }}</span></span
        >
      </div>

      <h1 class="cmp-title">{{ product.title }}</h1>
      <div class="cmp-price" id="Price-{{ section.id }}">{{ current_variant.price | money }}</div>
      <div class="cmp-emi">Easy EMI options available at Checkout</div>

      {% form 'product', product, id: 'product-form' %}
        <input type="hidden" name="id" id="MasterSelect-{{ section.id }}" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="cmp-form-group">
              <div class="cmp-option-header">
                <span class="cmp-option-name">
                  {% if option.name == 'Size' %}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 7V5c0-1.1.9-2 2-2h2"/><path d="M17 3h2c1.1 0 2 .9 2 2v2"/><path d="M21 17v2c0 1.1-.9 2-2 2h-2"/><path d="M7 21H5c-1.1 0-2-.9-2-2v-2"/><rect x="7" y="7" width="10" height="10" rx="2"/>
                    </svg>
                  {% elsif option.name contains 'Delivery' %}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                  {% endif %}
                  Select {{ option.name }}
                </span>
                {%- if option.name == 'Size' -%}
                  <a href="#" style="font-size:12px;color:#cca36e;text-decoration:underline;">Size Guide</a>
                {%- endif -%}
              </div>

              <div class="cmp-pills">
                {%- for value in option.values -%}
                  <input
                    type="radio"
                    id="Opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                    name="options[{{ option.name }}]"
                    value="{{ value | escape }}"
                    class="cmp-option-input"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >

                  <label for="Opt-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="cmp-pill-label">
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="cmp-actions-row">
          <label class="cmp-qty-label">Quantity</label>
          <div class="cmp-qty-wrapper">
            <button type="button" class="cmp-qty-btn" onclick="this.nextElementSibling.stepDown()">-</button>
            <input type="number" name="quantity" value="1" min="1" class="cmp-qty-input">
            <button type="button" class="cmp-qty-btn" onclick="this.nextElementSibling.stepUp()">+</button>
          </div>

          <button
            type="submit"
            name="add"
            class="cmp-atc-btn"
            id="AddToCart-{{ section.id }}"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            {% if current_variant.available %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
              </svg>
              <span>Add to Cart</span>
            {% else %}
              <span>Sold Out</span>
            {% endif %}
          </button>
        </div>
      {% endform %}

      <div class="cmp-accordions">
        <div class="cmp-accordion-item">
          <div class="cmp-accordion-header" onclick="toggleAccordion(this)">
            Description
            <span class="cmp-accordion-icon">+</span>
          </div>
          <div class="cmp-accordion-content">
            <div class="cmp-accordion-inner">{{ product.description }}</div>
          </div>
        </div>

        {%- for block in section.blocks -%}
          <div class="cmp-accordion-item">
            <div class="cmp-accordion-header" onclick="toggleAccordion(this)">
              {{ block.settings.heading }}
              <span class="cmp-accordion-icon">+</span>
            </div>
            <div class="cmp-accordion-content">
              <div class="cmp-accordion-inner">{{ block.settings.content }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="ProductJson-{{ section.id }}">
  {{ product.variants | json }}
</script>

<script>
  function changeImage(src, thumb) {
    document.getElementById('MainImg-{{ section.id }}').src = src;
    document.querySelectorAll('.cmp-thumb').forEach((t) => t.classList.remove('active'));
    thumb.classList.add('active');
  }

  function toggleAccordion(header) {
    var content = header.nextElementSibling;
    var item = header.parentElement;
    if (content.style.maxHeight) {
      content.style.maxHeight = null;
      item.removeAttribute('open');
    } else {
      content.style.maxHeight = content.scrollHeight + 'px';
      item.setAttribute('open', '');
    }
  }

  (function () {
    var variants = JSON.parse(document.getElementById('ProductJson-{{ section.id }}').innerHTML);
    var container = document.querySelector('#shopify-section-{{ section.id }}');
    var inputs = container.querySelectorAll('.cmp-option-input');

    inputs.forEach(function (input) {
      input.addEventListener('change', function () {
        var selectedOptions = [];
        container.querySelectorAll('.cmp-option-input:checked').forEach(function (radio) {
          selectedOptions.push(radio.value);
        });

        var matchedVariant = variants.find(function (variant) {
          return variant.options.every(function (val, index) {
            return val === selectedOptions[index];
          });
        });

        if (matchedVariant) {
          document.getElementById('MasterSelect-{{ section.id }}').value = matchedVariant.id;

          // Use innerHTML for Money so Bucks can read the <span>
          var price = (matchedVariant.price / 100).toFixed(2);
          var symbol = '{{ cart.currency.symbol }}';
          document.getElementById('Price-{{ section.id }}').innerHTML =
            '<span class="money">' + symbol + price + '</span>';

          var btn = document.getElementById('AddToCart-{{ section.id }}');
          if (matchedVariant.available) {
            btn.disabled = false;
            btn.querySelector('span').innerText = 'Add to Cart';
          } else {
            btn.disabled = true;
            btn.querySelector('span').innerText = 'Sold Out';
          }

          window.history.replaceState(null, null, '?variant=' + matchedVariant.id);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": [],
  "blocks": [
    {
      "type": "accordion",
      "name": "Info Tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Material & Care" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [{ "name": "Main Product", "category": "Products" }]
}
{% endschema %}

{% comment %}
  <div class="product-images">
    {% for image in product.images %}
      {% render 'image', class: 'product-image', image: image %}
    {% endfor %}
  </div>

  <div class="product-info">
    <h1>{{ product.title }}</h1>
    <p>{{ product.price | money }}</p>
    <p>{{ product.description }}</p>
  </div>

  <div class="product-form">
    {% form 'product', product %}
      {% assign current_variant = product.selected_or_first_available_variant %}

      <select name="id">
        {% for variant in product.variants %}
          <option
            value="{{ variant.id }}"
            {% if variant == current_variant %}
              selected="selected"
            {% endif %}
          >
            {{ variant.title }} - {{ variant.price | money }}
          </option>
        {% endfor %}
      </select>

      <input type="text" name="quantity" min="1" value="1">

      <input type="submit" value="Add to cart">
      {{ form | payment_button }}
    {% endform %}
  </div>

  {% schema %}
  {
    "name": "t:general.product",
    "settings": [],
    "disabled_on": {
      "groups": ["header", "footer"]
    }
  }
  {% endschema %}
{% endcomment %}
