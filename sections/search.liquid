{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}



{{ 'cora-search.css' | asset_url | stylesheet_tag }}

<div class="cora-search-section">
  <div class="cora-search-container">

    <header class="cora-search-header">
      <h1 class="cora-search-title">
        {% if search.performed %}
          {{ search.results_count }} Results for "{{ search.terms }}"
        {% else %}
          Search our store
        {% endif %}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="cora-search-form">
        <input
          class="cora-search-input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search for rugs, styles, or colors..."
          autocomplete="off"
        >
        <button type="submit" class="cora-search-submit" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
    </header>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div style="text-align: center; margin-top: 40px; color: #64748b;">
          <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
        </div>
      {% else %}
        
        <div class="cora-search-results">
          {% paginate search.results by 24 %}
            
            {% for item in search.results %}
              <a href="{{ item.url }}" class="cora-search-card">
                
                <div class="cora-card-image-wrapper">
                  {% if item.object_type != 'product' %}
                    <span class="cora-card-badge">{{ item.object_type }}</span>
                  {% elsif item.compare_at_price > item.price %}
                    <span class="cora-card-badge">Sale</span>
                  {% endif %}

                  {% assign featured_image = item.featured_image | default: item.image %}
                  {% if featured_image %}
                    <img 
                      class="cora-card-image" 
                      src="{{ featured_image | img_url: '600x600', crop: 'center' }}" 
                      alt="{{ item.title | escape }}" 
                      loading="lazy"
                    >
                  {% else %}
                    <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#cbd5e1; background:#f8fafc;">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                      </svg>
                    </div>
                  {% endif %}
                </div>

                <div class="cora-card-content">
                  <h3 class="cora-card-title">{{ item.title }}</h3>
                  
                  {% if item.object_type == 'product' %}
                    <div class="cora-card-price">
                      {% if item.compare_at_price > item.price %}
                        <span class="compare-price">{{ item.compare_at_price | money }}</span>
                        <span class="sale-price">{{ item.price | money }}</span>
                      {% else %}
                        {{ item.price | money }}
                      {% endif %}
                    </div>
                  {% else %}
                    <div class="cora-card-price" style="font-size: 12px; opacity: 0.7;">
                      {{ item.content | strip_html | truncate: 50 }}
                    </div>
                  {% endif %}
                </div>

              </a>
            {% endfor %}

            {% if paginate.pages > 1 %}
              <nav class="cora-pagination" role="navigation" aria-label="Pagination">
                {% if paginate.previous %}
                  <a href="{{ paginate.previous.url }}" class="cora-pagination__btn">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.84182 3.13514C9.04327 3.32401 9.05348 3.64042 8.86462 3.84188L5.43521 7.49991L8.86462 11.1579C9.05348 11.3594 9.04327 11.6758 8.84182 11.8647C8.64036 12.0535 8.32394 12.0433 8.13508 11.8419L4.38508 7.84188C4.20477 7.64955 4.20477 7.35027 4.38508 7.15794L8.13508 3.15794C8.32394 2.95648 8.64036 2.94628 8.84182 3.13514Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/></svg>
                    <span>Prev</span>
                  </a>
                {% else %}
                  <span class="cora-pagination__btn cora-pagination__btn--disabled">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.84182 3.13514C9.04327 3.32401 9.05348 3.64042 8.86462 3.84188L5.43521 7.49991L8.86462 11.1579C9.05348 11.3594 9.04327 11.6758 8.84182 11.8647C8.64036 12.0535 8.32394 12.0433 8.13508 11.8419L4.38508 7.84188C4.20477 7.64955 4.20477 7.35027 4.38508 7.15794L8.13508 3.15794C8.32394 2.95648 8.64036 2.94628 8.84182 3.13514Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/></svg>
                    <span>Prev</span>
                  </span>
                {% endif %}

                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="cora-pagination__item">{{ part.title }}</a>
                  {% else %}
                    {% if part.title == paginate.current_page %}
                      <span class="cora-pagination__item active">{{ part.title }}</span>
                    {% else %}
                      <span class="cora-pagination__item cora-pagination__item--dots">...</span>
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% if paginate.next %}
                  <a href="{{ paginate.next.url }}" class="cora-pagination__btn">
                    <span>Next</span>
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/></svg>
                  </a>
                {% else %}
                  <span class="cora-pagination__btn cora-pagination__btn--disabled">
                    <span>Next</span>
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/></svg>
                  </span>
                {% endif %}
              </nav>
            {% endif %}

          {% endpaginate %}
        </div>

      {% endif %}
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}