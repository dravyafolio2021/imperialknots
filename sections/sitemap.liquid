{% comment %}
  SECTION: HTML SITEMAP
  Purpose: Displays a human-readable list of all store content.
{% endcomment %}

<style>
  .sitemap-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    font-family: var(--font-body-family, sans-serif);
  }

  .sitemap-header {
    text-align: center;
    margin-bottom: 50px;
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 30px;
  }

  .sitemap-header h1 {
    font-size: 36px;
    margin-bottom: 10px;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  /* Columns */
  .sitemap-col h2 {
    font-size: 20px;
    border-bottom: 2px solid #000;
    padding-bottom: 10px;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Lists */
  .sitemap-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sitemap-list li {
    margin-bottom: 12px;
  }

  .sitemap-list a {
    text-decoration: none;
    color: #333;
    font-size: 15px;
    transition: color 0.2s;
  }

  .sitemap-list a:hover {
    color: #666;
    text-decoration: underline;
  }

  /* Nested Lists (Products/Articles) */
  .sitemap-sublist {
    list-style: none;
    padding-left: 15px;
    margin-top: 8px;
    margin-bottom: 15px;
    border-left: 1px solid #ddd;
  }

  .sitemap-sublist li {
    margin-bottom: 6px;
  }

  .sitemap-sublist a {
    font-size: 13px;
    color: #666;
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    .sitemap-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="sitemap-wrapper">
  
  <div class="sitemap-header">
    <h1>{{ page.title }}</h1>
    <p>An overview of the available content on our site.</p>
  </div>

  <div class="sitemap-grid">

    <div class="sitemap-col">
      <h2>Collections & Products</h2>
      <ul class="sitemap-list">
        {%- for collection in collections -%}
          {%- comment -%} Skip Frontpage collection {%- endcomment -%}
          {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
          
          <li>
            <a href="{{ collection.url }}"><strong>{{ collection.title }}</strong></a>
            
            {%- if section.settings.show_products -%}
              <ul class="sitemap-sublist">
                {%- for product in collection.products limit: 10 -%}
                  <li><a href="{{ product.url }}">{{ product.title }}</a></li>
                {%- endfor -%}
                {%- if collection.all_products_count > 10 -%}
                  <li><a href="{{ collection.url }}" style="font-style:italic;">View all {{ collection.all_products_count }} products...</a></li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="sitemap-col">
      <h2>Journal & News</h2>
      <ul class="sitemap-list">
        {%- for blog in blogs -%}
          <li>
            <a href="{{ blog.url }}"><strong>{{ blog.title }}</strong></a>
            
            {%- if section.settings.show_articles -%}
              <ul class="sitemap-sublist">
                {%- for article in blog.articles limit: 10 -%}
                  <li><a href="{{ article.url }}">{{ article.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="sitemap-col">
      <h2>Pages & Info</h2>
      {%- if section.settings.pages_menu != blank -%}
        <ul class="sitemap-list">
          {%- for link in linklists[section.settings.pages_menu].links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
              
              {%- if link.links.size > 0 -%}
                <ul class="sitemap-sublist">
                  {%- for child_link in link.links -%}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p style="color:red; font-size:12px;">
          * Please select a Menu in the theme editor to display Pages here.
        </p>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "HTML Sitemap",
  "settings": [
    {
      "type": "header",
      "content": "Pages Settings"
    },
    {
      "type": "link_list",
      "id": "pages_menu",
      "label": "Select 'All Pages' Menu",
      "info": "Create a menu in Navigation containing all your static pages (About, Contact, Legal, etc)."
    },
    {
      "type": "header",
      "content": "Detail Settings"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show Products under Collections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_articles",
      "label": "Show Articles under Blogs",
      "default": true
    }
  ],
  "presets": [{ "name": "HTML Sitemap" }]
}
{% endschema %}