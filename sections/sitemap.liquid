{% comment %}
  sections/sitemap.liquid
  - Human-readable sitemap for QA / quick-checking
  - Shows: Collections (optionally products), Blogs & Articles, Custom Links
  - Client-side search (sitemap.js) filters results instantly
  - CSS lives in assets/sitemap.css
{% endcomment %}

{{ 'sitemap.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Per-section container width & gap vars */
  #shopify-section-{{ section.id }} .sitemap__container {
    max-width: {{ section.settings.container_width | default: 1200 }}px;
    margin: 0 auto;
    padding: 36px 20px;
  }
{%- endstyle -%}

<section id="shopify-section-{{ section.id }}" class="sitemap-section" aria-label="Sitemap">
  <div class="sitemap__container">
    <div class="sitemap__top">
      <h1 class="sitemap__title">{{ section.settings.title | default: 'Sitemap' }}</h1>
      {% if section.settings.show_search %}
        <div class="sitemap__search">
          <input
            id="sitemap-search"
            class="sitemap__search-input"
            type="search"
            placeholder="Search pages, products, articles..."
            aria-label="Search sitemap"
          >
          <small class="sitemap__search-hint">Type to filter results instantly (Ctrl+F to focus)</small>
        </div>
      {% endif %}
    </div>

    <div class="sitemap__grid">
      <!-- Left column: Collections -->
      <div class="sitemap__col sitemap__col--collections" aria-labelledby="sitemap-collections">
        <div class="sitemap__col-head">
          <h2 id="sitemap-collections">Collections</h2>
          {% if section.settings.include_products %}
            <button class="sitemap__toggle-products" id="sitemap-toggle-products" aria-pressed="false">
              Show products
            </button>
          {% endif %}
        </div>

        <ul class="sitemap__list sitemap__list--collections" id="sitemap-collections-list">
          {% comment %}
            Iterate through all visible collections.
            If include_products is enabled we output up to products_per_collection for each collection.
            Note: listing ALL products for very large stores can be heavy — we limit per collection.
          {% endcomment %}
          {% for collection in collections %}
            <li class="sitemap__item sitemap__collection" data-sitemap-index="{{ collection.handle }}">
              <a class="sitemap__link sitemap__link--collection" href="{{ collection.url }}">{{ collection.title }}</a>
              <span class="sitemap__meta">({{ collection.products_count }} products)</span>

              {% if section.settings.include_products and collection.products_count > 0 %}
                <button
                  class="sitemap__expand-products"
                  aria-expanded="false"
                  data-collection-handle="{{ collection.handle }}"
                >
                  Show
                </button>
                <ul
                  class="sitemap__sublist sitemap__sublist--products"
                  data-collection="{{ collection.handle }}"
                  hidden
                >
                  {% assign limit = section.settings.products_per_collection | default: 6 %}
                  {% for product in collection.products limit: limit %}
                    <li class="sitemap__subitem">
                      <a href="{{ product.url }}" class="sitemap__sublink">{{ product.title }}</a>
                      <span class="sitemap__small">{{ product.price | money }}</span>
                    </li>
                  {% endfor %}
                  {% if collection.products_count > limit %}
                    <li class="sitemap__subitem sitemap__see-all">
                      <a href="{{ collection.url }}">See all products in {{ collection.title }}</a>
                    </li>
                  {% endif %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Middle column: Blogs & Articles -->
      <div class="sitemap__col sitemap__col--blogs" aria-labelledby="sitemap-blogs">
        <h2 id="sitemap-blogs">Blogs & Articles</h2>
        <ul class="sitemap__list sitemap__list--blogs">
          {% assign articles_limit_each = section.settings.articles_per_blog | default: 5 %}
          {% for blog in blogs %}
            <li class="sitemap__item sitemap__blog" data-sitemap-index="blog-{{ blog.handle }}">
              <a class="sitemap__link sitemap__link--blog" href="{{ blog.url }}">{{ blog.title }}</a>
              <ul class="sitemap__sublist sitemap__sublist--articles">
                {% for article in blog.articles limit: articles_limit_each %}
                  <li class="sitemap__subitem">
                    <a href="{{ article.url }}" class="sitemap__sublink">{{ article.title }}</a>
                    <span class="sitemap__small">{{ article.published_at | date: '%b %d, %Y' }}</span>
                  </li>
                {% endfor %}
                {% if blog.articles_count > articles_limit_each %}
                  <li class="sitemap__subitem sitemap__see-all">
                    <a href="{{ blog.url }}">See all articles in {{ blog.title }}</a>
                  </li>
                {% endif %}
              </ul>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Right column: Custom Links & Navigation -->
      <div class="sitemap__col sitemap__col--custom" aria-labelledby="sitemap-custom">
        <h2 id="sitemap-custom">Custom Links & Navigation</h2>

        <!-- Custom links added in section blocks (link picker) -->
        {% if section.blocks.size > 0 %}
          <ul class="sitemap__list sitemap__list--custom">
            {% for block in section.blocks %}
              <li class="sitemap__item sitemap__custom-item">
                {% if block.settings.link %}
                  <a class="sitemap__link" href="{{ block.settings.link }}">
                    {{- block.settings.title | default: block.settings.link.title -}}
                  </a>
                {% else %}
                  <span class="sitemap__link">{{ block.settings.title }}</span>
                {% endif %}
                {% if block.settings.note %}
                  <div class="sitemap__small">{{ block.settings.note }}</div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="sitemap__muted">
            No custom links added. Use the theme editor to add important pages here (e.g., Contact, FAQ, Shipping,
            Returns).
          </div>
        {% endif %}

        <!-- Menus: render linklists that are commonly used (header/footer) -->
        <div class="sitemap__navs">
          {% comment %}
            We show a few known linklists if they exist: 'main-menu', 'footer', 'secondary-menu' — change handles as needed.
          {% endcomment %}
          {% assign known_menus = 'main-menu,footer,secondary-menu' | split: ',' %}
          {% for menu_handle in known_menus %}
            {% assign menu = linklists[menu_handle] %}
            {% if menu and menu.links_count > 0 %}
              <div class="sitemap__menu">
                <h3 class="sitemap__menu-title">{{ menu.title }}</h3>
                <ul>
                  {% for link in menu.links %}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="sitemap__footer">
      <p class="sitemap__muted">
        Generated sitemap for quick checks. Use the search or the expand buttons to reveal products & articles. For full
        XML sitemaps (for crawlers), use Shopify's built-in `/sitemap.xml`.
      </p>
    </div>
  </div>
</section>

{{ 'sitemap.js' | asset_url | script_tag }}
