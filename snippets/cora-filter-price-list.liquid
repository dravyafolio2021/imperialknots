{% comment %}
  Snippet: cora-filter-price-list.liquid
  Usage: Renders a list of price ranges that act like radio buttons.
{% endcomment %}

<div class="sidebar-block filter-group price-list-group">
  <div class="filter-title">
    <span>{{ block.settings.title }}</span>
  </div>

  <div class="filter-content">
    <ul class="price-list-items">
      {%- assign range_lines = block.settings.price_ranges | newline_to_br | split: '<br />' -%}
      
      {%- for line in range_lines -%}
        {%- assign parts = line | split: ':' -%}
        {%- assign range_vals = parts[0] | split: '-' -%}
        {%- assign label_text = parts[1] | strip -%}
        
        {%- assign min_price = range_vals[0] | strip -%}
        {%- assign max_price = range_vals[1] | strip -%}
        
        {%- comment -%} Check if active based on URL params {%- endcomment -%}
        {%- assign is_active = false -%}
        
        {%- assign current_min = cart.currency.symbol -%} 
        {%- comment -%} 
           Note: We check URL params directly because collection.filters object 
           might be using different formatting. 
        {%- endcomment -%}
        
        {%- capture current_query -%}{{ request.query_string }}{%- endcapture -%}
        {%- assign min_param = 'filter.v.price.gte=' | append: min_price -%}
        {%- assign max_param = 'filter.v.price.lte=' | append: max_price -%}

        {%- if current_query contains min_param and current_query contains max_param -%}
           {%- assign is_active = true -%}
        {%- endif -%}

        <li class="price-list-item">
          <label class="cora-radio-label">
            <input type="radio" 
                   name="cora_price_radio" 
                   value="{{ min_price }}-{{ max_price }}"
                   {% if is_active %}checked{% endif %}
                   onclick="applyPriceFilter('{{ min_price }}', '{{ max_price }}', this)"
            >
            <span class="cora-check-box"></span>
            <span class="cora-label-text">{{ label_text }}</span>
          </label>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  function applyPriceFilter(min, max, element) {
    // 1. Get current URL params
    const params = new URLSearchParams(window.location.search);

    // 2. If the user clicks the ALREADY selected radio, we clear the filter (Toggle off)
    // We detect this by checking if the URL already has these exact values
    const currentMin = params.get('filter.v.price.gte');
    const currentMax = params.get('filter.v.price.lte');

    if (currentMin === min && currentMax === max) {
        params.delete('filter.v.price.gte');
        params.delete('filter.v.price.lte');
        element.checked = false; // Visually uncheck
    } else {
        // 3. Set new values (Radio behavior: replaces existing price filters)
        params.set('filter.v.price.gte', min);
        params.set('filter.v.price.lte', max);
    }

    // 4. Reset pagination to page 1 to avoid empty results
    params.delete('page');

    // 5. Reload page with new params
    window.location.search = params.toString();
  }
</script>

<style>
  .price-list-group .filter-title {
    font-weight: 600;
    margin-bottom: 12px;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.5px;
  }
  
  .price-list-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .price-list-item {
    margin-bottom: 10px;
  }

  .cora-radio-label {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 15px;
    color: #333;
  }

  /* Hide default radio input */
  .cora-radio-label input[type="radio"] {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }

  /* Custom Square "Radio" (Looks like checkbox per user request) */
  .cora-check-box {
    height: 18px;
    width: 18px;
    background-color: #fff;
    border: 1px solid #ccc;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0; /* Prevent squishing */
  }

  /* Hover effect */
  .cora-radio-label:hover .cora-check-box {
    border-color: #000;
  }

  /* Checked State */
  .cora-radio-label input:checked ~ .cora-check-box {
    background-color: #000;
    border-color: #000;
  }

  /* Checkmark Icon (CSS Only) */
  .cora-check-box::after {
    content: "";
    display: none;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px; /* Alignment tweak */
  }

  .cora-radio-label input:checked ~ .cora-check-box::after {
    display: block;
  }

  .cora-label-text {
    line-height: 1.4;
  }
</style>