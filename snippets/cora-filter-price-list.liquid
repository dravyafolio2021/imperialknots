{% comment %}
  Snippet: cora-filter-price-list.liquid
  Usage: Custom Price List (Collapsible) with comma-safe active state check.
{% endcomment %}

<div class="sidebar-block filter-group price-list-group">
  {%- comment -%} Collapsible Details Element {%- endcomment -%}
  <details {% if block.settings.default_open %}open{% endif %}>
    <summary class="filter-title">
      <span class="filter-heading-text">{{ block.settings.title }}</span>
      <span class="icon-chevron">
        {% comment %} <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg> {% endcomment %}
      </span>
    </summary>

    <div class="filter-content">
      <ul class="price-list-items">
        {%- assign range_lines = block.settings.price_ranges | newline_to_br | split: '<br />' -%}
        
        {%- for line in range_lines -%}
          {%- assign parts = line | split: ':' -%}
          {%- assign range_vals = parts[0] | split: '-' -%}
          {%- assign label_text = parts[1] | strip -%}
          
          {%- assign min_price = range_vals[0] | strip -%}
          {%- assign max_price = range_vals[1] | strip -%}

          <li class="price-list-item">
            <div class="cora-radio-fake"
                 data-min="{{ min_price }}"
                 data-max="{{ max_price }}"
                 onclick="applyCustomPrice('{{ min_price }}', '{{ max_price }}', this)"
                 role="button">
              <span class="cora-check-box"></span>
              <span class="cora-label-text">{{ label_text }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </details>
</div>

<script>
  // Helper to safely parse numbers, removing commas (e.g. "1,00,000" -> 100000)
  function parsePrice(val) {
    if (!val) return 0;
    return parseFloat(val.toString().replace(/,/g, '')) || 0;
  }

  function applyCustomPrice(min, max, element) {
    const params = new URLSearchParams(window.location.search);
    
    // Clean inputs before comparing
    const currentMin = parsePrice(params.get('filter.v.price.gte'));
    const currentMax = parsePrice(params.get('filter.v.price.lte'));
    const targetMin = parsePrice(min);
    const targetMax = parsePrice(max);

    if (currentMin === targetMin && currentMax === targetMax) {
      // Toggle OFF
      params.delete('filter.v.price.gte');
      params.delete('filter.v.price.lte');
    } else {
      // Set NEW
      params.set('filter.v.price.gte', parsePrice(min)); // Send clean number to URL
      params.set('filter.v.price.lte', parsePrice(max)); // Send clean number to URL
    }
    params.delete('page');
    window.location.href = '?' + params.toString();
  }

  // Highlight Active Box
  (function() {
    function highlightActive() {
      const params = new URLSearchParams(window.location.search);
      const urlMin = parsePrice(params.get('filter.v.price.gte'));
      const urlMax = parsePrice(params.get('filter.v.price.lte'));

      const boxes = document.querySelectorAll('.cora-radio-fake');
      
      boxes.forEach(box => {
        const boxMin = parsePrice(box.getAttribute('data-min'));
        const boxMax = parsePrice(box.getAttribute('data-max'));

        // Match logic: ignores commas and slight formatting diffs
        if (urlMin === boxMin && urlMax === boxMax && urlMax > 0) {
          box.classList.add('active');
        } else {
          box.classList.remove('active');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', highlightActive);
    } else {
      highlightActive();
    }
  })();
</script>

<style>
  /* Force Details/Summary Layout */
  .price-list-group details > summary {
    list-style: none !important;
    cursor: pointer;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding-bottom: 12px;
    width: 100%;
  }
  .price-list-group details > summary::-webkit-details-marker { display: none !important; }
  
  /* Heading Style */
  .price-list-group .filter-heading-text {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.5px;
  }

  /* Chevron Icon */
  .price-list-group .icon-chevron {
    display: flex;
    align-items: center;
  }
  .price-list-group .icon-chevron svg { 
    transition: transform 0.3s ease; 
    width: 12px; 
    height: 12px; 
  }
  .price-list-group details[open] .icon-chevron svg { 
    transform: rotate(180deg); 
  }

  /* List Styles */
  .price-list-items { list-style: none; padding: 10px 0 0 0; margin: 0; }
  .price-list-item { margin-bottom: 12px; }

  /* Checkbox Fake Styles */
  .cora-radio-fake { display: flex; align-items: center; cursor: pointer; font-size: 15px; color: #333; user-select: none; }
  .cora-check-box { height: 18px; width: 18px; background-color: #fff; border: 1px solid #dcdcdc; margin-right: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  
  /* Active State */
  .cora-radio-fake.active .cora-check-box { background-color: #000; border-color: #000; }
  .cora-check-box::after { content: ""; display: none; width: 5px; height: 10px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); margin-bottom: 2px; }
  .cora-radio-fake.active .cora-check-box::after { display: block; }
</style>