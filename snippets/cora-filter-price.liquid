{% comment %}
  Snippet: cora-filter-item.liquid
  Usage: Standard Filters (Color, Size, Availability) using URL-forcing logic.
{% endcomment %}

<div class="sidebar-block filter-group">
  <details {% if default_open or filter.active_values.size > 0 %}open{% endif %}>
    <summary class="filter-title">
      <span>{{ filter.label }}</span>
      <span class="icon-chevron">
        <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </summary>

    <div class="filter-content">
      <ul class="filter-list">
        {%- for value in filter.values -%}
          <li class="filter-item">
            <div class="cora-checkbox-fake {% if value.active %}active{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}"
                 onclick="applyStandardFilter('{{ value.param_name }}', '{{ value.value }}', this)"
                 role="button">
              
              <span class="cora-check-box"></span>
              <span class="cora-label-text">
                {{ value.label }}
                <span class="count">({{ value.count }})</span>
              </span>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </details>
</div>

<script>
  function applyStandardFilter(paramName, paramValue, element) {
    const params = new URLSearchParams(window.location.search);
    
    // Check if we are adding or removing
    // Shopify allows multiple values for same param (e.g. Color=Red&Color=Blue)
    
    // We need to rebuild the params to toggle this specific value
    let newParams = new URLSearchParams();
    let found = false;
    
    // Loop through existing params to rebuild
    for(const [key, value] of params.entries()) {
      if(key === paramName && value === paramValue) {
        // If match found, we SKIP it (Removing the filter)
        found = true;
      } else {
        newParams.append(key, value);
      }
    }
    
    // If we didn't find it to remove, we ADD it
    if(!found) {
      newParams.append(paramName, paramValue);
    }
    
    newParams.delete('page'); // Reset pagination
    window.location.href = '?' + newParams.toString();
  }
</script>

<style>
  .filter-group details > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
  }
  .filter-group details > summary::-webkit-details-marker { display: none; }
  .filter-group .icon-chevron svg { transition: transform 0.3s ease; }
  .filter-group details[open] .icon-chevron svg { transform: rotate(180deg); }
  .filter-group .filter-title { font-weight: 600; text-transform: uppercase; font-size: 14px; letter-spacing: 0.5px; width: 100%; }
  
  .filter-list { list-style: none; padding: 10px 0 0 0; margin: 0; }
  .filter-item { margin-bottom: 10px; }

  .cora-checkbox-fake { display: flex; align-items: center; cursor: pointer; font-size: 15px; color: #333; user-select: none; }
  .cora-checkbox-fake.disabled { opacity: 0.5; cursor: not-allowed; pointer-events: none; }
  
  .cora-check-box { height: 18px; width: 18px; background-color: #fff; border: 1px solid #dcdcdc; margin-right: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cora-checkbox-fake.active .cora-check-box { background-color: #000; border-color: #000; }
  
  /* Checkmark for Standard Filters */
  .cora-checkbox-fake .cora-check-box::after { content: ""; display: none; width: 5px; height: 10px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); margin-bottom: 2px; }
  .cora-checkbox-fake.active .cora-check-box::after { display: block; }
  
  .count { color: #888; margin-left: 4px; font-size: 13px; }
</style>