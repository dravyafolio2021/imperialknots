{% comment %}
  Snippet: cora-filter-price.liquid
  Usage: Custom Price Buckets (Ranges) for Shopify OS 2.0
{% endcomment %}

<div class="filter-group price-bucket-group">
  <div class="filter-title">
    <span>PRICE RANGE</span>
  </div>

  <div class="filter-content">
    <ul class="price-bucket-list">
      
      {%- comment -%} 
        CONFIGURATION: Define your ranges here.
        Format: Min | Max | Label
      {%- endcomment -%}
      
      {%- capture price_ranges -%}
        0|20000|Under - ₹20,000
        20000|50000|₹20,000 - ₹50,000
        50000|100000|₹50,000 - ₹1,00,000
        100000|200000|₹1,00,000 - ₹2,00,000
        200000|300000|₹2,00,000 - ₹3,00,000
      {%- endcapture -%}

      {%- assign ranges = price_ranges | newline_to_br | split: '<br />' -%}

      {%- for range in ranges -%}
        {%- assign parts = range | split: '|' -%}
        {%- assign min_val = parts[0] | strip | times: 100 -%} {% comment %} Shopify uses cents {% endcomment %}
        {%- assign max_val = parts[1] | strip | times: 100 -%}
        {%- assign label = parts[2] | strip -%}
        
        {%- comment -%} Check if this range is currently active in the URL {%- endcomment -%}
        {%- assign is_active = false -%}
        {%- if filter.min_value.value == min_val and filter.max_value.value == max_val -%}
          {%- assign is_active = true -%}
        {%- endif -%}

        <li class="price-item">
          <label class="checkbox-label">
            <input type="checkbox" 
                   class="price-bucket-input" 
                   value="{{ min_val }}-{{ max_val }}"
                   {% if is_active %}checked{% endif %}>
            <span class="custom-checkbox"></span>
            <span class="text">{{ label }}</span>
          </label>
        </li>
      {%- endfor -%}
    </ul>
    
    <a href="#" class="price-load-more">Load More</a>

    {%- comment -%} 
      HIDDEN NATIVE INPUTS 
      These are the actual inputs Shopify reads to filter the collection.
    {%- endcomment -%}
    <div class="price-range-hidden" style="display:none;">
      <input name="{{ filter.min_value.param_name }}"
        id="Filter-{{ filter.label | escape }}-GTE"
        {%- if filter.min_value.value -%}
          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
        {%- endif -%}
        type="number"
        placeholder="0"
        min="0"
        max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
      >
      <input name="{{ filter.max_value.param_name }}"
        id="Filter-{{ filter.label | escape }}-LTE"
        {%- if filter.max_value.value -%}
          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
        {%- endif -%}
        type="number"
        min="0"
        max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
        placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
      >
    </div>

  </div>
</div>

<style>
  /* CSS to match the image provided */
  .price-bucket-group .filter-title {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 15px;
    font-size: 14px;
  }

  .price-bucket-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .price-item {
    margin-bottom: 12px;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 15px;
    color: #333;
  }

  /* Hide default checkbox */
  .price-bucket-input {
    display: none; 
  }

  /* Custom Box */
  .custom-checkbox {
    width: 20px;
    height: 20px;
    border: 1px solid #dcdcdc; /* Light grey border */
    margin-right: 12px;
    display: inline-block;
    position: relative;
    background: #fff;
    transition: all 0.2s;
  }

  /* Checked State */
  .price-bucket-input:checked + .custom-checkbox {
    background-color: #000; /* Or your theme color */
    border-color: #000;
  }

  /* Checkmark */
  .price-bucket-input:checked + .custom-checkbox::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 6px;
    height: 12px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .price-load-more {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    text-decoration: underline;
    color: #000;
    font-style: italic;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const buckets = document.querySelectorAll('.price-bucket-input');
    const minInput = document.getElementById('Filter-{{ filter.label | escape }}-GTE');
    const maxInput = document.getElementById('Filter-{{ filter.label | escape }}-LTE');
    const form = minInput.closest('form');

    buckets.forEach(bucket => {
      bucket.addEventListener('change', function() {
        if (this.checked) {
          // 1. Uncheck all other boxes (Single select behavior mimics radio)
          buckets.forEach(b => {
            if (b !== this) b.checked = false;
          });

          // 2. Get values from the clicked bucket
          const values = this.value.split('-');
          // Convert from cents (Shopify default) to whole numbers for the input
          const min = values[0] / 100; 
          const max = values[1] / 100;

          // 3. Set the hidden native inputs
          minInput.value = min;
          maxInput.value = max;
        } else {
          // If unchecking the active box, clear filters
          minInput.value = '';
          maxInput.value = '';
        }

        // 4. Submit the form (The parent 'filter-form')
        // We use a small timeout to ensure values populate
        setTimeout(() => {
          // Trigger the standard theme event for form submission
          // Most themes use a custom event or just submit()
          // Try standard submit first:
           const event = new Event('input', { bubbles: true });
           minInput.dispatchEvent(event); // Trigger theme listeners
           
           // Fallback if theme doesn't auto-submit on input change
           // form.submit(); 
        }, 50);
      });
    });
  });
</script>