{% comment %}
  Snippet: cora-filter-price-list.liquid
  Usage: Custom Price List (Collapsible) targeting Sale Price.
  Updated: Uses JS to set active state and ensures "Radio" behavior.
{% endcomment %}

<div class="sidebar-block filter-group price-list-group">
  <details {% if block.settings.default_open %}open{% endif %}>
    <summary class="filter-title">
      <span>{{ block.settings.title }}</span>
      <span class="icon-chevron">
        <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </summary>

    <div class="filter-content">
      <ul class="price-list-items">
        {%- assign range_lines = block.settings.price_ranges | newline_to_br | split: '<br />' -%}
        
        {%- for line in range_lines -%}
          {%- assign parts = line | split: ':' -%}
          {%- assign range_vals = parts[0] | split: '-' -%}
          {%- assign label_text = parts[1] | strip -%}
          
          {%- assign min_price = range_vals[0] | strip -%}
          {%- assign max_price = range_vals[1] | strip -%}

          <li class="price-list-item">
            {%- comment -%} 
              We assign data attributes (data-min, data-max) so JS can find the active one easily 
            {%- endcomment -%}
            <div class="cora-radio-fake"
                 data-min="{{ min_price }}"
                 data-max="{{ max_price }}"
                 onclick="applyCustomPrice('{{ min_price }}', '{{ max_price }}', this)"
                 role="button">
              <span class="cora-check-box"></span>
              <span class="cora-label-text">{{ label_text }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </details>
</div>

<script>
  // 1. Function to Handle Clicks
  function applyCustomPrice(min, max, element) {
    const params = new URLSearchParams(window.location.search);
    const currentMin = params.get('filter.v.price.gte');
    const currentMax = params.get('filter.v.price.lte');

    if (currentMin === min && currentMax === max) {
      // Toggle OFF if clicking the active one
      params.delete('filter.v.price.gte');
      params.delete('filter.v.price.lte');
    } else {
      // Set NEW Price Range
      params.set('filter.v.price.gte', min);
      params.set('filter.v.price.lte', max);
    }
    params.delete('page');
    window.location.href = '?' + params.toString();
  }

  // 2. Function to Highlight Active Box on Load
  document.addEventListener("DOMContentLoaded", function() {
    const params = new URLSearchParams(window.location.search);
    const urlMin = params.get('filter.v.price.gte');
    const urlMax = params.get('filter.v.price.lte');

    if (urlMin && urlMax) {
      // Find the box that matches the current URL params
      const activeBox = document.querySelector(`.cora-radio-fake[data-min="${urlMin}"][data-max="${urlMax}"]`);
      if (activeBox) {
        activeBox.classList.add('active');
      }
    }
  });
</script>

<style>
  .price-list-group details > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
  }
  .price-list-group details > summary::-webkit-details-marker { display: none; }
  .price-list-group .icon-chevron svg { transition: transform 0.3s ease; }
  .price-list-group details[open] .icon-chevron svg { transform: rotate(180deg); }
  .price-list-group .filter-title { font-weight: 600; text-transform: uppercase; font-size: 14px; letter-spacing: 0.5px; width: 100%; }
  
  .price-list-items { list-style: none; padding: 10px 0 0 0; margin: 0; }
  .price-list-item { margin-bottom: 12px; }

  .cora-radio-fake { display: flex; align-items: center; cursor: pointer; font-size: 15px; color: #333; user-select: none; }
  
  .cora-check-box { height: 18px; width: 18px; background-color: #fff; border: 1px solid #dcdcdc; margin-right: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  
  /* Active State Styles */
  .cora-radio-fake.active .cora-check-box { background-color: #000; border-color: #000; }
  .cora-check-box::after { content: ""; display: none; width: 5px; height: 10px; border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg); margin-bottom: 2px; }
  .cora-radio-fake.active .cora-check-box::after { display: block; }
</style>