{% comment %}
  Snippet: cora-filter-price-list.liquid
  Usage: Custom Price List (Radio Style) that forces URL updates, bypassing Theme AJAX.
{% endcomment %}

<div class="sidebar-block filter-group price-list-group">
  <div class="filter-title">
    <span>{{ block.settings.title }}</span>
  </div>

  <div class="filter-content">
    <ul class="price-list-items">
      {%- assign range_lines = block.settings.price_ranges | newline_to_br | split: '<br />' -%}
      
      {%- for line in range_lines -%}
        {%- assign parts = line | split: ':' -%}
        {%- assign range_vals = parts[0] | split: '-' -%}
        {%- assign label_text = parts[1] | strip -%}
        
        {%- assign min_price = range_vals[0] | strip -%}
        {%- assign max_price = range_vals[1] | strip -%}
        
        {%- comment -%} Check active state from URL {%- endcomment -%}
        {%- assign is_active = false -%}
        
        {%- comment -%} 
          We must check the URL parameters directly to see if this specific range is active.
        {%- endcomment -%}
        {%- capture current_query -%}{{ request.query_string }}{%- endcapture -%}
        {%- assign min_check = 'filter.v.price.gte=' | append: min_price -%}
        {%- assign max_check = 'filter.v.price.lte=' | append: max_price -%}

        {%- if current_query contains min_check and current_query contains max_check -%}
           {%- assign is_active = true -%}
        {%- endif -%}

        <li class="price-list-item">
          {%- comment -%} 
            IMPORTANT: We use a DIV with onClick, not an INPUT. 
            This prevents the Theme's AJAX from "hijacking" the click.
          {%- endcomment -%}
          <div class="cora-radio-fake {% if is_active %}active{% endif %}"
               onclick="applyCustomPrice('{{ min_price }}', '{{ max_price }}', this)"
               role="button"
               tabindex="0">
            
            <span class="cora-check-box"></span>
            <span class="cora-label-text">{{ label_text }}</span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script>
  function applyCustomPrice(min, max, element) {
    // 1. Get current URL params
    const params = new URLSearchParams(window.location.search);

    // 2. Check if we are clicking the already active item
    const currentMin = params.get('filter.v.price.gte');
    const currentMax = params.get('filter.v.price.lte');

    if (currentMin === min && currentMax === max) {
      // User clicked the active filter -> Toggle OFF (Remove params)
      params.delete('filter.v.price.gte');
      params.delete('filter.v.price.lte');
    } else {
      // User clicked a new filter -> Set new params
      params.set('filter.v.price.gte', min);
      params.set('filter.v.price.lte', max);
    }

    // 3. Reset pagination to avoid empty pages
    params.delete('page');

    // 4. FORCE RELOAD to apply filters
    window.location.href = '?' + params.toString();
  }
</script>

<style>
  .price-list-group .filter-title {
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.5px;
  }
  
  .price-list-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .price-list-item {
    margin-bottom: 12px;
  }

  /* Fake Radio Styles */
  .cora-radio-fake {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 15px;
    color: #333;
    user-select: none;
  }

  .cora-check-box {
    height: 18px;
    width: 18px;
    background-color: #fff;
    border: 1px solid #dcdcdc;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  /* Hover effect */
  .cora-radio-fake:hover .cora-check-box {
    border-color: #000;
  }

  /* Active State (Simulating Checked) */
  .cora-radio-fake.active .cora-check-box {
    background-color: #000;
    border-color: #000;
  }

  /* Checkmark Icon */
  .cora-check-box::after {
    content: "";
    display: none;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-bottom: 2px;
  }

  .cora-radio-fake.active .cora-check-box::after {
    display: block;
  }

  .cora-label-text {
    line-height: 1.4;
  }
</style>