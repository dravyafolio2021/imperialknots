{% comment %}
  Snippet: cora-filter-price.liquid
  Usage: Renders specific Price Range inputs for the collection filter.
{% endcomment %}

<style>
  /* Basic styling for the price filter to match your theme */
  .cora-price-group {
    padding: 15px 0;
    border-bottom: 1px solid #eee;
  }
  .cora-price-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 10px;
  }
  .cora-price-inputs {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cora-price-field {
    display: flex;
    flex-direction: column;
    width: 48%;
  }
  .cora-price-field label {
    font-size: 11px;
    text-transform: uppercase;
    color: #666;
    margin-bottom: 4px;
  }
  .cora-input-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid #ccc;
    padding: 8px;
    border-radius: 4px;
  }
  .cora-currency {
    font-size: 14px;
    margin-right: 4px;
    color: #333;
  }
  .cora-price-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 14px;
    padding: 0;
    -moz-appearance: textfield;
  }
  .cora-price-input::-webkit-outer-spin-button,
  .cora-price-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .cora-apply-btn {
    margin-top: 10px;
    width: 100%;
    padding: 8px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    text-transform: uppercase;
  }
  .cora-apply-btn:hover {
    opacity: 0.8;
  }
</style>

<div class="cora-price-group">
  <details {% if default_open %}open{% endif %}>
    <summary class="cora-price-header">
      <span>{{ filter.label | escape }}</span>
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6" style="width: 10px;">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path>
      </svg>
    </summary>

    <div class="cora-price-content">
      <price-range class="facets__price">
        <div class="cora-price-inputs">
          
          <div class="cora-price-field">
            <label for="Filter-{{ filter.label | escape }}-GTE">Min</label>
            <div class="cora-input-wrapper">
              <span class="cora-currency">{{ cart.currency.symbol }}</span>
              <input class="cora-price-input"
                name="{{ filter.min_value.param_name }}"
                id="Filter-{{ filter.label | escape }}-GTE"
                type="number"
                placeholder="0"
                min="0"
                max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                {% if filter.min_value.value %}
                  value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                {% endif %}
              >
            </div>
          </div>

          <div class="cora-price-field">
            <label for="Filter-{{ filter.label | escape }}-LTE">Max</label>
            <div class="cora-input-wrapper">
              <span class="cora-currency">{{ cart.currency.symbol }}</span>
              <input class="cora-price-input"
                name="{{ filter.max_value.param_name }}"
                id="Filter-{{ filter.label | escape }}-LTE"
                type="number"
                min="0"
                max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                {% if filter.max_value.value %}
                  value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                {% endif %}
              >
            </div>
          </div>

        </div>
      </price-range>
      
      <noscript>
        <button type="submit" class="cora-apply-btn">Apply</button>
      </noscript>
    </div>
  </details>
</div>