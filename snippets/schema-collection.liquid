<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://www.imperialknots.com{{ collection.url }}",
      "url": "https://www.imperialknots.com{{ collection.url }}",
      "name": "{{ collection.title | escape }}",
      "description": "{{ collection.description | strip_html | escape }}",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://www.imperialknots.com/#website"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "https://www.imperialknots.com/#organization"
      },
      "about": {
        "@type": "Thing",
        "name": "Rugs & Carpets"
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://www.imperialknots.com{{ collection.url }}#itemlist",
      "name": "{{ collection.title | escape }} – Products",
      "numberOfItems": {{ collection.products_count }},
      "itemListElement": [
        {% for product in collection.products limit: 50 %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": "{{ product.title | escape }}",
          "url": "https://www.imperialknots.com{{ product.url }}"
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.imperialknots.com{{ collection.url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.imperialknots.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rugs & Carpets",
          "item": "https://www.imperialknots.com/collections"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ collection.title | escape }}",
          "item": "https://www.imperialknots.com{{ collection.url }}"
        }
      ]
    }
  ]
}
</script>