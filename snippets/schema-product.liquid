<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "https://www.imperialknots.com{{ product.url }}",
  "name": "{{ product.title | escape }}",
  "description": "{{ product.description | strip_html | escape }}",
  "image": [
    {% for image in product.images %}
      "{{ image | image_url: width: 1024 }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "brand": {
    "@type": "Brand",
    "name": "Imperial Knots",
    "url": "https://www.imperialknots.com"
  },
  "sku": "{{ product.selected_or_first_available_variant.sku }}",
  "mpn": "{{ product.id }}",
  "category": "Rugs & Carpets",
  "material": "{{ product.metafields.custom.material | default: 'Wool, Cotton, Silk, Jute' }}",
  "color": "{{ product.metafields.custom.color | default: 'Multiple color options available' }}",
  "size": "{{ product.metafields.custom.size | default: 'Multiple size options available' }}",
  "pattern": "{{ product.metafields.custom.pattern | default: 'Handcrafted' }}",
  "offers": {
    "@type": "Offer",
    "url": "https://www.imperialknots.com{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "@id": "https://www.imperialknots.com/#organization",
      "name": "Imperial Knots",
      "url": "https://www.imperialknots.com"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0",
        "currency": "{{ cart.currency.iso_code }}"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": [
          "IN","US","GB","AE","AU","SG","CA","DE","FR","IT","ES","NL","BE"
        ]
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 7,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 5,
          "maxValue": 28,
          "unitCode": "DAY"
        }
      }
    }
  }
}
</script>