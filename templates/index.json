      "type": "cora-faq-v2",
      "blocks": {
        "category_CWJGQf": {
          "type": "category",
          "settings": {
            "title": "About Imperial Knots"
          }
        },
        "question_ifmTAG": {
          "type": "question",
          "settings": {
            "title": "What makes Imperial Knots carpets different?",
            "answer": "<p>Handcrafted by skilled Indian artisans, using premium natural materials and ethical, small-<br/>batch production. Expect authentic techniques, durable construction, and timeless design.</p>"
          }
        },
        "question_hEWNGA": {
          "type": "question",
          "settings": {
            "title": "Where are Imperial Knots rugs made?",
            "answer": "<p>In India, by artisan weaving communities using traditional knotting and weaving methods.</p>"
          }
        },
        "question_Kfh38c": {
          "type": "question",
          "settings": {
            "title": "Do you offer international shipping?",
            "answer": "<p>Yes, we ship worldwide. Rates and delivery times vary by destination and rug size; details<br/>appear at checkout.</p>"
          }
        },
        "question_w7EUxV": {
          "type": "question",
          "settings": {
            "title": "What social initiatives does Imperial Knots support in the weavers' community?",
            "answer": "<p>Fair wages, safer workplaces, healthcare support, and education initiatives for artisan<br/>families—sustaining heritage crafts. Imperial is also the founding member of Care & Fare.</p>"
          }
        },
        "category_7K3jmc": {
          "type": "category",
          "settings": {
            "title": "Custom & Bespoke Rugs"
          }
        },
        "question_yfthfF": {
          "type": "question",
          "settings": {
            "title": "Do you make customized rugs?",
            "answer": "<p>Yes—choose your size, colors, material, pattern, and finish.</p>"
          }
        },
        "question_ekHQTK": {
          "type": "question",
          "settings": {
            "title": "What is a Bespoke Rug & how do I place my order?",
            "answer": "<p>A fully made-to-order rug tailored to your specs. Share your dimensions, palette, references, or sketches; we’ll develop a visualization and proceed after your approval.</p>"
          }
        },
        "question_HnaiMz": {
          "type": "question",
          "settings": {
            "title": "What is the lead time for a custom rug?",
            "answer": "<p>Typically 5–12 weeks, depending on size, design complexity, and technique.</p>"
          }
        },
        "question_MyNQNM": {
          "type": "question",
          "settings": {
            "title": "Can I provide my design for a custom rug?",
            "answer": "<p>Absolutely—upload sketches, artwork, photos, or CAD files; we’ll translate them into a weave-ready map.</p>"
          }
        },
        "question_tErmNV": {
          "type": "question",
          "settings": {
            "title": "What materials and techniques are available for custom rugs?",
            "answer": "<p>Materials: wool, silk, bamboo silk, viscose, jute, cotton.Techniques: hand-knotted, hand-tufted, flatweave, hand-woven.</p>"
          }
        },
        "question_aYTBHy": {
          "type": "question",
          "settings": {
            "title": "What is your return policy for custom rugs?",
            "answer": "<p>Custom pieces are made to your specifications and are <strong>non-returnable</strong> (except in case of confirmed manufacturing defects).</p>"
          }
        },
        "category_7AFgjY": {
          "type": "category",
          "settings": {
            "title": "Product & Quality"
          }
        },
        "question_6TwP9m": {
          "type": "question",
          "settings": {
            "title": "What is the difference between hand-knotted, hand-tufted, and flatweave rugs?",
            "answer": "<ul><li><strong>Hand-knotted:</strong> knot-by-knot on a loom; heirloom durability.</li><li><strong>Hand-tufted:</strong> tufting tool; faster, great value, sturdy.</li></ul><p><strong>Flatweave:</strong> no pile; lightweight, reversible, ideal for high traffic.</p>"
          }
        },
        "question_ah3RWq": {
          "type": "question",
          "settings": {
            "title": "Why is wool (or silk) the best material for a carpet?",
            "answer": "<p>Wool: naturally resilient, stain-resistant, fire-resistant, and cozy.<br/>Silk: fine detail and luxurious sheen. Both are long-lasting and premium.</p>"
          }
        },
        "question_79y7kn": {
          "type": "question",
          "settings": {
            "title": "Will I see the exact carpet I’m ordering?",
            "answer": "<p>Yes—ready-made listings show the actual rug. For custom rugs, we share approval images;<br/>minor tone/texture variations are natural with hand-dyed fibers.</p>"
          }
        },
        "category_ViDb9y": {
          "type": "category",
          "settings": {
            "title": "Care & Maintenance"
          }
        },
        "question_Ne3qDV": {
          "type": "question",
          "settings": {
            "title": "How should I clean my rug regularly?",
            "answer": "<p>Vacuum weekly on low suction (no beater bar), shake out dust, and use a quality rug pad.</p>"
          }
        },
        "question_W97LCd": {
          "type": "question",
          "settings": {
            "title": "How do I handle spills and stains on my rug?",
            "answer": "<p>Blot immediately with a clean, dry cloth (don’t rub). Use mild soap with cool water if needed; call a rug-care professional for tough stains.</p>"
          }
        },
        "question_B7nqqc": {
          "type": "question",
          "settings": {
            "title": "Can I wash my rug at home?",
            "answer": "<p>Avoid machine washing. Professional cleaning is recommended for handmade rugs.</p>"
          }
        },
        "question_yLQrBY": {
          "type": "question",
          "settings": {
            "title": "How often should I rotate my rug?",
            "answer": "<p>Every <strong>3–6 months</strong> to even out wear and sun exposure.</p>"
          }
        },
        "question_Mc6rzG": {
          "type": "question",
          "settings": {
            "title": "What should I do to protect my rug from sunlight?",
            "answer": "<p>Use curtains/UV blinds, rotate routinely, and avoid prolonged direct sunlight.</p>"
          }
        },
        "question_kt6WDt": {
          "type": "question",
          "settings": {
            "title": "How do I store my rug properly?",
            "answer": "<p>Clean, roll (don’t fold), wrap in breathable fabric or cotton sheeting, and store in a cool, dry space off the floor.</p>"
          }
        },
        "question_bF8Hne": {
          "type": "question",
          "settings": {
            "title": "How do I clean and maintain my handmade wool carpet?",
            "answer": "<p>Regular low-suction vacuuming, prompt blotting of spills, professional deep clean every 12–18 months, and routine rotation.</p>"
          }
        },
        "question_WrqBjY": {
          "type": "question",
          "settings": {
            "title": "Do handmade carpets shed?",
            "answer": "<p>New wool rugs may shed lightly at first; this reduces with regular vacuuming and use.</p>"
          }
        },
        "category_rAT9Ue": {
          "type": "category",
          "settings": {
            "title": "Shipping, Ordering & Cancellations"
          }
        },
        "question_QQfcGc": {
          "type": "question",
          "settings": {
            "title": "Is there a time limit for canceling my order?",
            "answer": "<p>Yes—within <strong>24 hours</strong> of placement. Once processed or shipped, the order can’t be canceled. For custom rugs, cancellation isn’t possible after production begins.</p>"
          }
        },
        "question_t8VK6j": {
          "type": "question",
          "settings": {
            "title": "How can I cancel my order?",
            "answer": "<p>Contact Customer Support with your order number <strong>as soon as possible</strong>. If it hasn’t been processed or shipped, we’ll cancel and confirm via email.</p>"
          }
        },
        "question_Rc7Nza": {
          "type": "question",
          "settings": {
            "title": "Will I see the exact carpet I'm ordering?",
            "answer": "<p>Yes for in-stock rugs; for custom rugs we provide approval photos before shipping.</p>"
          }
        },
        "category_Npmj6m": {
          "type": "category",
          "settings": {
            "title": "Returns & Refunds"
          }
        },
        "question_G7fazi": {
          "type": "question",
          "settings": {
            "title": "What is your return policy?",
            "answer": "<p>Unused, ready-made rugs may be returned within the stated window in original condition/packaging. <strong>Custom rugs are non-returnable.</strong></p>"
          }
        },
        "question_epBTyx": {
          "type": "question",
          "settings": {
            "title": "How do I initiate a return?",
            "answer": "<p>Contact Customer Support with your order details to receive return instructions and an authorization.</p>"
          }
        },
        "question_4aWHhf": {
          "type": "question",
          "settings": {
            "title": "Do you offer free returns?",
            "answer": "<p>Policies vary by region; return shipping/fees may apply. Custom rugs are not eligible.</p>"
          }
        },
        "question_H7N6Lb": {
          "type": "question",
          "settings": {
            "title": "How long does it take to process a return?",
            "answer": "<p>Typically <strong>7–10 business days</strong> after the rug is received and inspected.</p>"
          }
        },
        "question_AnjA4M": {
          "type": "question",
          "settings": {
            "title": "Will I receive a full refund?",
            "answer": "<p>Eligible returns are refunded to the original payment method, minus any applicable shipping/fees.</p>"
          }
        },
        "question_DKQgWf": {
          "type": "question",
          "settings": {
            "title": "Can I exchange a rug?",
            "answer": "<p>Yes—exchanges for standard sizes are possible if the rug is unused and within the return window.</p>"
          }
        },
        "question_WG6Nz8": {
          "type": "question",
          "settings": {
            "title": "Do you offer refunds, and how are they processed?",
            "answer": "<p>Yes—refunds are issued to the original payment method after inspection approval.</p>"
          }
        },
