          "settings": {
            "title": "What payment methods do you accept?",
            "answer": "<p>Credit/debit cards (<strong>Visa, MasterCard, American Express</strong>), <strong>bank transfers, Razorpay, and EMIs</strong> (where available). All transactions use secure, encrypted gateways.</p>"
          }
        },
        "question_qb9hX9": {
          "type": "question",
          "settings": {
