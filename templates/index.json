        },
        "question_ifmTAG": {
          "type": "question",
          "settings": {
            "title": "What makes Imperial Knots carpets different?",
            "answer": "<p>Handcrafted by skilled Indian artisans, using premium natural materials and ethical, small-batch production. Expect authentic techniques, durable construction, and timeless design.</p>"
          }
        },
        "question_Kfh38c": {
          "type": "question",
          "settings": {
            "title": "Where are Imperial Knots rugs made?",
            "answer": "<p>In India, by artisan weaving communities using traditional knotting and weaving methods.<br/><br/></p>"
          }
        },
        "question_w7EUxV": {
          "type": "question",
