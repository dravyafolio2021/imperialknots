          "type": "question",
          "settings": {
            "title": "When will my card be charged?",
            "answer": "<p>At checkout (time of purchase).</p>"
          }
        },
        "question_9eBAzX": {
          "type": "question",
          "settings": {
            "title": "Do you offer financing or installment payment options?",
            "answer": "<p>EMI/installments may be available via Razorpay/issuer programs (availability varies by region and eligibility).</p>"
          }
        },
        "question_wDj6xb": {
          "type": "question",
          "settings": {
            "title": "What should I do if my payment is declined?",
            "answer": "<p>Check card details and online/intl limits, try another method, or contact your bank. Our team can help with alternatives.</p>"
