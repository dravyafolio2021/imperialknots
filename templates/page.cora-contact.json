            "custom_liquid": "{%- style -%}\n  /* SECTION WRAPPER */\n  #cora-contact-{{ section.id }} {\n    background-color: #ffffff;\n    padding: 60px 20px;\n    font-family: 'Poppins', sans-serif;\n    color: #1a1a1a;\n  }\n\n  .cora-form-container {\n    max-width: 700px;\n    margin: 0 auto;\n  }\n\n  .cora-form-heading {\n    text-align: left;\n    font-size: 32px;\n    margin-bottom: 10px;\n    font-weight: 600;\n    color: #000;\n  }\n  \n  .cora-form-subtext {\n    text-align: left;\n    font-size: 16px;\n    color: #666;\n    margin-bottom: 40px;\n  }\n\n  /* FORM STRUCTURE */\n  .cora-form-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n  }\n\n  .cora-form-row {\n    display: flex;\n    gap: 20px;\n  }\n\n  .cora-form-col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  /* LABELS */\n  .cora-label {\n    font-size: 14px;\n    color: #1a1a1a;\n    font-weight: 600;\n    display: block;\n  }\n  \n  .cora-label span {\n    color: #e53e3e; /* Red asterisk */\n  }\n\n  /* INPUTS */\n  .cora-input, .cora-textarea {\n    width: 100%;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    font-size: 15px;\n    background: #fff;\n    outline: none;\n    color: #333;\n    transition: border-color 0.2s;\n  }\n\n  .cora-input:focus, .cora-textarea:focus {\n    border-color: #000;\n  }\n\n  .cora-input::placeholder, .cora-textarea::placeholder {\n    color: #a0aec0;\n  }\n\n  .cora-textarea {\n    resize: vertical;\n    min-height: 150px;\n  }\n\n  /* SUBMIT BUTTON */\n  .cora-submit-btn {\n    background-color: #000;\n    color: #fff;\n    border: none;\n    padding: 16px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 500;\n    cursor: pointer;\n    margin-top: 10px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    transition: opacity 0.3s;\n  }\n  \n  .cora-submit-btn:hover {\n    opacity: 0.9;\n  }\n\n  .cora-submit-icon {\n    width: 18px;\n    height: 18px;\n    stroke: currentColor;\n    fill: none;\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 768px) {\n    .cora-form-row {\n      flex-direction: column;\n      gap: 24px;\n    }\n    .cora-form-container {\n      padding: 0 5px;\n    }\n  }\n{%- endstyle -%}\n\n<section id=\"cora-contact-{{ section.id }}\">\n  <div class=\"cora-form-container\">\n\n    {% form 'contact' %}\n      {% if form.posted_successfully? %}\n        <p class=\"form-success\" style=\"text-align:center; padding: 15px; background: #f0fff4; color: #276749; border-radius: 8px; margin-bottom: 20px;\">\n          Thank you! We have received your message.\n        </p>\n      {% elsif form.errors %}\n        <div class=\"form-errors\" style=\"text-align:center; padding: 15px; background: #fff5f5; color: #c53030; border-radius: 8px; margin-bottom: 20px;\">\n          {{ form.errors | default_errors }}\n        </div>\n      {% endif %}\n\n      <div class=\"cora-form-grid\">\n\n        <div class=\"cora-form-row\">\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Name <span>*</span></label>\n            <input type=\"text\" name=\"contact[name]\" class=\"cora-input\" placeholder=\"e.g. Rahul Kumar\" minlength=\"2\" autocomplete=\"name\" required>\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Phone Number</label>\n            <input type=\"tel\" name=\"contact[phone]\" class=\"cora-input\" placeholder=\"+91 98765 43210\" pattern=\"^\\+[1-9][0-9]{0,2}[\\s\\-]?[0-9\\s\\-]{7,15}$\" title=\"Phone number must include a country code starting with '+' (e.g., +91 98765 43210)\" autocomplete=\"tel\">\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Email Address <span>*</span></label>\n          <input type=\"email\" name=\"contact[email]\" class=\"cora-input\" placeholder=\"your.email@example.com\" autocomplete=\"email\" required>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Message <span>*</span></label>\n          <textarea name=\"contact[body]\" class=\"cora-textarea\" placeholder=\"Please describe how we can help you in detail...\" minlength=\"10\" required></textarea>\n        </div>\n\n        <button type=\"submit\" class=\"cora-submit-btn\">\n          Send Message\n          <svg class=\"cora-submit-icon\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line>\n            <polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon>\n          </svg>\n        </button>\n\n      </div>\n    {% endform %}\n  </div>\n</section>",
