            "custom_liquid": "{%- style -%}\n  /* SECTION WRAPPER */\n  #cora-form-{{ section.id }} {\n    background-color: #ffffff;\n    padding: 20px 0;\n    font-family: 'Poppins', sans-serif;\n    color: #1a1a1a;\n  }\n\n  .cora-form-container {\n    max-width: 700px;\n    margin: 0 auto;\n  }\n\n  .cora-form-heading {\n    text-align: left;\n    font-size: 28px;\n    margin-bottom: 30px;\n    font-weight: 600;\n    color: #000;\n  }\n\n  /* FORM STRUCTURE */\n  .cora-form-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n  }\n\n  .cora-form-row {\n    display: flex;\n    gap: 20px;\n  }\n\n  .cora-form-col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  /* LABELS */\n  .cora-label {\n    font-size: 14px;\n    color: #1a1a1a;\n    font-weight: 600;\n    display: block;\n  }\n  \n  .cora-label span {\n    color: #e53e3e;\n  }\n\n  /* INPUTS */\n  .cora-input, .cora-textarea {\n    width: 100%;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    font-size: 15px;\n    background: #fff;\n    outline: none;\n    color: #333;\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n\n  .cora-input:focus, .cora-textarea:focus {\n    border-color: #000;\n  }\n\n  .cora-input::placeholder, .cora-textarea::placeholder {\n    color: #a0aec0;\n  }\n\n  .cora-textarea {\n    resize: vertical;\n    min-height: 120px;\n  }\n\n  /* SUBMIT BUTTON */\n  .cora-submit-btn {\n    background-color: #000;\n    color: #fff;\n    border: none;\n    padding: 16px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 500;\n    cursor: pointer;\n    margin-top: 10px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    transition: opacity 0.3s;\n  }\n  \n  .cora-submit-btn:hover {\n    opacity: 0.9;\n  }\n\n  .cora-submit-icon {\n    width: 16px;\n    height: 16px;\n    fill: currentColor;\n  }\n\n  /* PHONE GROUP */\n  .cora-phone-group {\n    display: flex;\n    gap: 10px;\n  }\n  .cora-phone-code {\n    width: 90px;\n    flex-shrink: 0;\n    text-align: center;\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 768px) {\n    .cora-form-row {\n      flex-direction: column;\n      gap: 24px;\n    }\n    .cora-form-container {\n      padding: 0 15px;\n    }\n  }\n{%- endstyle -%}\n\n<section id=\"cora-form-{{ section.id }}\">\n  <div class=\"cora-form-container\">\n    \n    {% form 'contact' %}\n      {% if form.posted_successfully? %}\n        <p class=\"form-success\" style=\"text-align:center; padding: 15px; background: #f0fff4; color: #276749; border-radius: 8px; margin-bottom: 20px;\">\n          Thank you! We have received your design request.\n        </p>\n      {% elsif form.errors %}\n        <div class=\"form-errors\" style=\"text-align:center; padding: 15px; background: #fff5f5; color: #c53030; border-radius: 8px; margin-bottom: 20px;\">\n          {{ form.errors | default_errors }}\n        </div>\n      {% endif %}\n\n      <div class=\"cora-form-grid\">\n\n        <div class=\"cora-form-row\">\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\" for=\"ContactFormFirstName\">First Name <span>*</span></label>\n            <input type=\"text\" id=\"ContactFormFirstName\" name=\"contact[First Name]\" class=\"cora-input\" placeholder=\"Your first name\" required>\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\" for=\"ContactFormLastName\">Last Name <span>*</span></label>\n            <input type=\"text\" id=\"ContactFormLastName\" name=\"contact[Last Name]\" class=\"cora-input\" placeholder=\"Your last name\" required>\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\" for=\"ContactFormEmail\">Email Address <span>*</span></label>\n          <input type=\"email\" id=\"ContactFormEmail\" name=\"contact[email]\" class=\"cora-input\" placeholder=\"your.email@example.com\" required>\n        </div>\n        \n        <div class=\"cora-form-row\">\n           <div class=\"cora-form-col\">\n            <label class=\"cora-label\" for=\"ContactFormCountry\">Country</label>\n            <input type=\"text\" id=\"ContactFormCountry\" name=\"contact[Country]\" class=\"cora-input\" placeholder=\"e.g. Australia, India\" required>\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Phone Number</label>\n            <div class=\"cora-phone-group\">\n              <input type=\"text\" name=\"contact[Phone Code]\" class=\"cora-input cora-phone-code\" placeholder=\"+61\" pattern=\"[\\+]\\d{1,3}\" title=\"Must start with + followed by country code\">\n              <input type=\"tel\" name=\"contact[Phone Number]\" class=\"cora-input\" placeholder=\"12345 67890\" pattern=\"[0-9\\s]{7,15}\" title=\"Please enter a valid phone number\">\n            </div>\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\" for=\"ContactFormMessage\">Design Details <span>*</span></label>\n          <textarea id=\"ContactFormMessage\" name=\"contact[body]\" class=\"cora-textarea\" placeholder=\"I was thinking if my rug could have a...\" required minlength=\"10\"></textarea>\n        </div>\n\n        <button type=\"submit\" class=\"cora-submit-btn\">\n          Submit Request\n          <svg class=\"cora-submit-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            <polyline points=\"12 5 19 12 12 19\"></polyline>\n          </svg>\n        </button>\n\n      </div>\n    {% endform %}\n  </div>\n</section>",
