            "custom_liquid": "{%- style -%}\n  /* SECTION WRAPPER */\n  #cora-influencer-{{ section.id }} {\n    background-color: #ffffff;\n    padding: 60px 20px;\n    font-family: 'Poppins', sans-serif;\n    color: #1a1a1a;\n  }\n\n  .cora-form-container {\n    max-width: 700px;\n    margin: 0 auto;\n  }\n\n  .cora-form-heading {\n    text-align: left;\n    font-size: 28px;\n    margin-bottom: 30px;\n    font-weight: 600;\n    color: #000;\n  }\n\n  /* FORM STRUCTURE */\n  .cora-form-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n  }\n\n  .cora-form-row {\n    display: flex;\n    gap: 20px;\n  }\n\n  .cora-form-col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  /* LABELS */\n  .cora-label {\n    font-size: 14px;\n    color: #1a1a1a;\n    font-weight: 600;\n    display: block;\n  }\n  \n  .cora-label span {\n    color: #e53e3e; /* Red asterisk */\n  }\n\n  /* INPUTS */\n  .cora-input, .cora-select, .cora-textarea {\n    width: 100%;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    font-size: 15px;\n    background: #fff;\n    outline: none;\n    color: #333;\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n\n  .cora-input:focus, .cora-select:focus, .cora-textarea:focus {\n    border-color: #000;\n  }\n\n  .cora-input::placeholder, .cora-textarea::placeholder {\n    color: #a0aec0;\n  }\n\n  .cora-textarea {\n    resize: vertical;\n    min-height: 100px;\n  }\n\n  /* UPLOAD BOX (Modern Style) */\n  .cora-upload-box {\n    border: 1px dashed #a0aec0;\n    border-radius: 8px;\n    background: #f8f9fa;\n    padding: 30px 20px;\n    text-align: center;\n    cursor: pointer;\n    transition: background 0.2s, border-color 0.2s;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n  }\n\n  .cora-upload-box:hover {\n    background-color: #f0f0f0;\n    border-color: #718096;\n  }\n\n  .cora-upload-icon {\n    width: 24px;\n    height: 24px;\n    color: #4a5568;\n  }\n\n  .cora-upload-title {\n    font-weight: 500;\n    font-size: 14px;\n    color: #2d3748;\n  }\n\n  /* SUBMIT BUTTON */\n  .cora-submit-btn {\n    background-color: #000;\n    color: #fff;\n    border: none;\n    padding: 16px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 500;\n    cursor: pointer;\n    margin-top: 10px;\n    width: 100%;\n    transition: opacity 0.3s;\n  }\n  \n  .cora-submit-btn:hover {\n    opacity: 0.9;\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 768px) {\n    .cora-form-row {\n      flex-direction: column;\n      gap: 24px;\n    }\n    .cora-form-container {\n      padding: 0 5px;\n    }\n  }\n{%- endstyle -%}\n\n<section id=\"cora-influencer-{{ section.id }}\">\n  <div class=\"cora-form-container\">\n \n\n    {% form 'contact' %}\n      {% if form.posted_successfully? %}\n        <p class=\"form-success\" style=\"text-align:center; padding: 15px; background: #f0fff4; color: #276749; border-radius: 8px; margin-bottom: 20px;\">\n          Thank you! Your application has been submitted successfully.\n        </p>\n      {% elsif form.errors %}\n        <div class=\"form-errors\" style=\"text-align:center; padding: 15px; background: #fff5f5; color: #c53030; border-radius: 8px; margin-bottom: 20px;\">\n          {{ form.errors | default_errors }}\n        </div>\n      {% endif %}\n\n      <div class=\"cora-form-grid\">\n\n        <div class=\"cora-form-row\">\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">First Name <span>*</span></label>\n            <input type=\"text\" name=\"contact[first_name]\" class=\"cora-input\" required>\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Last Name <span>*</span></label>\n            <input type=\"text\" name=\"contact[last_name]\" class=\"cora-input\" required>\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Email Address <span>*</span></label>\n          <input type=\"email\" name=\"contact[email]\" class=\"cora-input\" required>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Instagram URL <span>*</span></label>\n          <input type=\"url\" name=\"contact[note][Instagram URL]\" class=\"cora-input\" placeholder=\"https://instagram.com/yourhandle\" required>\n        </div>\n\n        <div class=\"cora-form-row\">\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Number of Instagram followers</label>\n            <input type=\"text\" name=\"contact[note][Instagram Followers]\" class=\"cora-input\">\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Engagement rate</label>\n            <input type=\"text\" name=\"contact[note][Engagement Rate]\" class=\"cora-input\">\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Link to website or blog</label>\n          <input type=\"url\" name=\"contact[note][Website]\" class=\"cora-input\">\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Links to additional social media</label>\n          <input type=\"text\" name=\"contact[note][Other Socials]\" class=\"cora-input\">\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Link to the product in which you are interested</label>\n          <input type=\"text\" name=\"contact[note][Preferred Product]\" class=\"cora-input\">\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Link to a backup product</label>\n          <input type=\"text\" name=\"contact[note][Backup Product]\" class=\"cora-input\">\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">What is your niche? <span>*</span></label>\n          <textarea name=\"contact[note][Niche]\" class=\"cora-textarea\" rows=\"2\" required></textarea>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Tell us about your project. What is the decor project... <span>*</span></label>\n          <textarea name=\"contact[body]\" class=\"cora-textarea\" rows=\"4\" required></textarea>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">What is your time frame? When do you need the product... <span>*</span></label>\n          <textarea name=\"contact[note][Time Frame]\" class=\"cora-textarea\" rows=\"2\" required></textarea>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Upload a rate card or media kit if applicable</label>\n          <input type=\"file\" name=\"contact[note][Media Kit]\" id=\"media-kit-file\" hidden>\n          <label for=\"media-kit-file\" class=\"cora-upload-box\">\n             <svg class=\"cora-upload-icon\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n               <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12\" />\n             </svg>\n             <span class=\"cora-upload-title\" id=\"file-label-text\">Click to upload file</span>\n          </label>\n        </div>\n\n        <button type=\"submit\" class=\"cora-submit-btn\">Submit Application</button>\n\n      </div>\n    {% endform %}\n  </div>\n</section>\n\n<script>\n  // Simple script to show filename after selection\n  document.getElementById('media-kit-file').addEventListener('change', function() {\n    var fileName = this.files[0] ? this.files[0].name : \"Click to upload file\";\n    document.getElementById('file-label-text').textContent = fileName;\n  });\n</script>",
