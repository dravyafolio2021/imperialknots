            "custom_liquid": "{%- style -%}\n  /* SECTION WRAPPER */\n  #cora-form-{{ section.id }} {\n    background-color: #ffffff;\n    padding: 60px 20px;\n    font-family: 'Poppins', sans-serif;\n    color: #1a1a1a;\n  }\n\n  .cora-form-container {\n    max-width: 700px; \n    margin: 0 auto;\n  }\n\n  .cora-form-heading {\n    text-align: left; \n    font-size: 28px;\n    margin-bottom: 30px;\n    font-weight: 600;\n    color: #000;\n  }\n\n  /* FORM STRUCTURE */\n  .cora-form-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 24px; \n  }\n\n  .cora-form-row {\n    display: flex;\n    gap: 20px;\n  }\n\n  .cora-form-col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  /* LABELS */\n  .cora-label {\n    font-size: 14px;\n    color: #1a1a1a;\n    font-weight: 600; \n    display: block;\n  }\n  \n  .cora-label span {\n    color: #e53e3e; \n  }\n\n  /* INPUTS */\n  .cora-input, .cora-select, .cora-textarea {\n    width: 100%;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0; \n    border-radius: 8px; \n    font-size: 15px;\n    background: #fff;\n    outline: none;\n    color: #333;\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n\n  .cora-input:focus, .cora-select:focus, .cora-textarea:focus {\n    border-color: #000;\n  }\n\n  .cora-input::placeholder, .cora-textarea::placeholder {\n    color: #a0aec0;\n  }\n\n  .cora-textarea {\n    resize: vertical;\n    min-height: 120px;\n  }\n\n  /* CUSTOM UPLOAD BOX */\n  .cora-upload-box {\n    border: 1px solid #888; \n    border-radius: 8px;\n    background: #fff;\n    padding: 40px 20px;\n    text-align: center;\n    cursor: pointer;\n    transition: background 0.2s;\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n  }\n\n  .cora-upload-box:hover {\n    background-color: #f9f9f9;\n  }\n\n  .cora-upload-icon {\n    width: 24px;\n    height: 24px;\n    margin-bottom: 5px;\n    color: #1a1a1a;\n  }\n\n  .cora-upload-title {\n    font-weight: 600;\n    font-size: 15px;\n    color: #1a1a1a;\n  }\n\n  .cora-upload-desc {\n    font-size: 12px;\n    color: #718096;\n  }\n\n  /* SUBMIT BUTTON */\n  .cora-submit-btn {\n    background-color: #000;\n    color: #fff;\n    border: none;\n    padding: 16px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 500;\n    cursor: pointer;\n    margin-top: 10px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    transition: opacity 0.3s;\n  }\n  \n  .cora-submit-btn:hover {\n    opacity: 0.9;\n  }\n\n  .cora-submit-icon {\n    width: 16px;\n    height: 16px;\n    fill: currentColor;\n  }\n\n  /* PHONE GROUP */\n  .cora-phone-group {\n    display: flex;\n    gap: 10px;\n  }\n  \n  .cora-phone-code {\n    width: 110px; \n    flex-shrink: 0;\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 768px) {\n    .cora-form-row {\n      flex-direction: column;\n      gap: 24px;\n    }\n    .cora-form-container {\n      padding: 0 5px;\n    }\n  }\n{%- endstyle -%}\n\n<section id=\"cora-form-{{ section.id }}\">\n  <div class=\"cora-form-container\">\n\n    {% form 'contact' %}\n      {% if form.posted_successfully? %}\n        <p class=\"form-success\" style=\"text-align:center; padding: 15px; background: #f0fff4; color: #276749; border-radius: 8px; margin-bottom: 20px;\">\n          Thank you! We have received your design request.\n        </p>\n      {% elsif form.errors %}\n        <div class=\"form-errors\" style=\"text-align:center; padding: 15px; background: #fff5f5; color: #c53030; border-radius: 8px; margin-bottom: 20px;\">\n          {{ form.errors | default_errors }}\n        </div>\n      {% endif %}\n\n      <div class=\"cora-form-grid\">\n\n        <div class=\"cora-form-row\">\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">First Name <span>*</span></label>\n            <input type=\"text\" name=\"contact[first_name]\" class=\"cora-input\" placeholder=\"e.g. Rahul\" minlength=\"2\" autocomplete=\"given-name\" required>\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Last Name <span>*</span></label>\n            <input type=\"text\" name=\"contact[last_name]\" class=\"cora-input\" placeholder=\"e.g. Kumar\" minlength=\"2\" autocomplete=\"family-name\" required>\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Email Address <span>*</span></label>\n          <input type=\"email\" name=\"contact[email]\" class=\"cora-input\" placeholder=\"your.email@example.com\" autocomplete=\"email\" required>\n        </div>\n        \n        <div class=\"cora-form-row\">\n           <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Country</label>\n            <select name=\"contact[note][Country]\" class=\"cora-select\">\n              <optgroup label=\"Frequently Used\">\n                <option value=\"India\">India</option>\n                <option value=\"USA\">USA</option>\n                <option value=\"UK\">UK</option>\n                <option value=\"Canada\">Canada</option>\n                <option value=\"Australia\">Australia</option>\n              </optgroup>\n              <optgroup label=\"All Countries\">\n                <option value=\"Argentina\">Argentina</option>\n                <option value=\"Austria\">Austria</option>\n                <option value=\"Bangladesh\">Bangladesh</option>\n                <option value=\"Belgium\">Belgium</option>\n                <option value=\"Brazil\">Brazil</option>\n                <option value=\"China\">China</option>\n                <option value=\"Denmark\">Denmark</option>\n                <option value=\"Egypt\">Egypt</option>\n                <option value=\"Finland\">Finland</option>\n                <option value=\"France\">France</option>\n                <option value=\"Germany\">Germany</option>\n                <option value=\"Greece\">Greece</option>\n                <option value=\"Hong Kong\">Hong Kong</option>\n                <option value=\"Indonesia\">Indonesia</option>\n                <option value=\"Ireland\">Ireland</option>\n                <option value=\"Israel\">Israel</option>\n                <option value=\"Italy\">Italy</option>\n                <option value=\"Japan\">Japan</option>\n                <option value=\"Malaysia\">Malaysia</option>\n                <option value=\"Mexico\">Mexico</option>\n                <option value=\"Netherlands\">Netherlands</option>\n                <option value=\"New Zealand\">New Zealand</option>\n                <option value=\"Nigeria\">Nigeria</option>\n                <option value=\"Norway\">Norway</option>\n                <option value=\"Pakistan\">Pakistan</option>\n                <option value=\"Philippines\">Philippines</option>\n                <option value=\"Poland\">Poland</option>\n                <option value=\"Portugal\">Portugal</option>\n                <option value=\"Qatar\">Qatar</option>\n                <option value=\"Saudi Arabia\">Saudi Arabia</option>\n                <option value=\"Singapore\">Singapore</option>\n                <option value=\"South Africa\">South Africa</option>\n                <option value=\"South Korea\">South Korea</option>\n                <option value=\"Spain\">Spain</option>\n                <option value=\"Sri Lanka\">Sri Lanka</option>\n                <option value=\"Sweden\">Sweden</option>\n                <option value=\"Switzerland\">Switzerland</option>\n                <option value=\"Taiwan\">Taiwan</option>\n                <option value=\"Thailand\">Thailand</option>\n                <option value=\"Turkey\">Turkey</option>\n                <option value=\"UAE\">UAE</option>\n                <option value=\"Vietnam\">Vietnam</option>\n                <option value=\"Other\">Other</option>\n              </optgroup>\n            </select>\n          </div>\n          <div class=\"cora-form-col\">\n            <label class=\"cora-label\">Phone Number</label>\n            <div class=\"cora-phone-group\">\n              \n              <input type=\"text\" list=\"country-codes\" name=\"contact[note][Phone Code]\" class=\"cora-input cora-phone-code\" value=\"+91\" placeholder=\"+1\" pattern=\"^\\+[0-9]{1,4}$\" maxlength=\"5\" oninput=\"this.value = this.value.replace(/[^0-9+]/g, '').replace(/(?!^)\\+/g, '')\" title=\"Enter a valid country code starting with '+' (e.g., +91)\" required>\n              <datalist id=\"country-codes\">\n                <option value=\"+91\">India</option>\n                <option value=\"+1\">USA/Canada</option>\n                <option value=\"+44\">UK</option>\n                <option value=\"+61\">Australia</option>\n                <option value=\"+20\">Egypt</option>\n                <option value=\"+27\">South Africa</option>\n                <option value=\"+33\">France</option>\n                <option value=\"+34\">Spain</option>\n                <option value=\"+39\">Italy</option>\n                <option value=\"+49\">Germany</option>\n                <option value=\"+55\">Brazil</option>\n                <option value=\"+65\">Singapore</option>\n                <option value=\"+81\">Japan</option>\n                <option value=\"+86\">China</option>\n                <option value=\"+971\">UAE</option>\n              </datalist>\n\n              <input type=\"tel\" name=\"contact[phone]\" class=\"cora-input\" placeholder=\"98765 43210\" pattern=\"^[0-9\\s\\-]{7,15}$\" title=\"Please enter your local phone number without the country code (7-15 digits).\" autocomplete=\"tel-local\">\n            </div>\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Reference Image Upload <span>*</span></label>\n          <input type=\"file\" name=\"contact[note][Reference Image]\" id=\"real-file\" accept=\".jpg,.jpeg,.png,.pdf\" hidden required>\n          \n          <label for=\"real-file\" class=\"cora-upload-box\">\n             <svg class=\"cora-upload-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n               <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n               <polyline points=\"17 8 12 3 7 8\"></polyline>\n               <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n             </svg>\n             <span class=\"cora-upload-title\" id=\"upload-title\">Click to upload your image</span>\n             <span class=\"cora-upload-desc\">JPG, PNG, PDF up to 5MB</span>\n          </label>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Design Details <span>*</span></label>\n          <textarea name=\"contact[body]\" class=\"cora-textarea\" placeholder=\"Describe the pattern, colors, and dimensions you have in mind...\" minlength=\"15\" required></textarea>\n        </div>\n\n        <button type=\"submit\" class=\"cora-submit-btn\">\n          Submit Request\n          <svg class=\"cora-submit-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            <polyline points=\"12 5 19 12 12 19\"></polyline>\n          </svg>\n        </button>\n\n      </div>\n    {% endform %}\n  </div>\n</section>\n\n<script>\n  // Update upload text on file select\n  document.getElementById('real-file').addEventListener('change', function() {\n    var fileName = this.files[0] ? this.files[0].name : \"Click to upload your image\";\n    var titleEl = document.getElementById('upload-title');\n    titleEl.textContent = fileName;\n    \n    // Optional: visual feedback\n    if(this.files[0]) {\n      titleEl.style.color = \"#000\";\n      titleEl.style.textDecoration = \"underline\";\n    }\n  });\n</script>",
