            "custom_liquid": "{%- style -%}\n  /* SECTION WRAPPER */\n  #cora-form-{{ section.id }} {\n    background-color: #ffffff;\n    padding: 60px 20px;\n    font-family: 'Poppins', sans-serif;\n    color: #1a1a1a;\n  }\n\n  .cora-form-container {\n    max-width: 700px; /* Slightly tighter width for the modern look */\n    margin: 0 auto;\n  }\n\n  .cora-form-heading {\n    text-align: left; /* Align left matches the reference image style usually, or keep center */\n    font-size: 28px;\n    margin-bottom: 30px;\n    font-weight: 600;\n    color: #000;\n  }\n\n  /* FORM STRUCTURE */\n  .cora-form-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 24px; /* More breathing room */\n  }\n\n  .cora-form-row {\n    display: flex;\n    gap: 20px;\n  }\n\n  .cora-form-col {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  /* LABELS */\n  .cora-label {\n    font-size: 14px;\n    color: #1a1a1a;\n    font-weight: 600; /* Bold labels */\n    display: block;\n  }\n  \n  .cora-label span {\n    color: #e53e3e; /* Optional red asterisk color */\n  }\n\n  /* INPUTS */\n  .cora-input, .cora-select, .cora-textarea {\n    width: 100%;\n    padding: 14px 16px;\n    border: 1px solid #e2e8f0; /* Soft grey border */\n    border-radius: 8px; /* Rounded corners */\n    font-size: 15px;\n    background: #fff;\n    outline: none;\n    color: #333;\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n\n  .cora-input:focus, .cora-select:focus, .cora-textarea:focus {\n    border-color: #000;\n    /* box-shadow: 0 0 0 3px rgba(0,0,0,0.05); Optional glow */\n  }\n\n  .cora-input::placeholder, .cora-textarea::placeholder {\n    color: #a0aec0;\n  }\n\n  .cora-textarea {\n    resize: vertical;\n    min-height: 120px;\n  }\n\n  /* CUSTOM UPLOAD BOX (Matches \"Resume Upload\" style) */\n  .cora-upload-box {\n    border: 1px solid #888; /* Slightly darker border like screenshot */\n    border-radius: 8px;\n    background: #fff;\n    padding: 40px 20px;\n    text-align: center;\n    cursor: pointer;\n    transition: background 0.2s;\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n  }\n\n  .cora-upload-box:hover {\n    background-color: #f9f9f9;\n  }\n\n  .cora-upload-icon {\n    width: 24px;\n    height: 24px;\n    margin-bottom: 5px;\n    color: #1a1a1a;\n  }\n\n  .cora-upload-title {\n    font-weight: 600;\n    font-size: 15px;\n    color: #1a1a1a;\n  }\n\n  .cora-upload-desc {\n    font-size: 12px;\n    color: #718096;\n  }\n\n  /* SUBMIT BUTTON */\n  .cora-submit-btn {\n    background-color: #000;\n    color: #fff;\n    border: none;\n    padding: 16px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 500;\n    cursor: pointer;\n    margin-top: 10px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    transition: opacity 0.3s;\n  }\n  \n  .cora-submit-btn:hover {\n    opacity: 0.9;\n  }\n\n  .cora-submit-icon {\n    width: 16px;\n    height: 16px;\n    fill: currentColor;\n  }\n\n  /* PHONE GROUP */\n  .cora-phone-group {\n    display: flex;\n    gap: 10px;\n  }\n  .cora-phone-code {\n    width: 90px;\n    flex-shrink: 0;\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 768px) {\n    .cora-form-row {\n      flex-direction: column;\n      gap: 24px;\n    }\n    .cora-form-container {\n      padding: 0 5px;\n    }\n  }\n{%- endstyle -%}\n\n<section id=\"cora-form-{{ section.id }}\">\n  <div class=\"cora-form-container\">\n \n\n    {% form 'contact' %}\n      {% if form.posted_successfully? %}\n        <p class=\"form-success\" style=\"text-align:center; padding: 15px; background: #f0fff4; color: #276749; border-radius: 8px; margin-bottom: 20px;\">\n          Thank you! We have received your design request.\n        </p>\n      {% elsif form.errors %}\n        <div class=\"form-errors\" style=\"text-align:center; padding: