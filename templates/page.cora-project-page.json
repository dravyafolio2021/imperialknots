tion value=\"+44\">+44</option>\n              </select>\n              <input type=\"tel\" name=\"contact[phone]\" class=\"cora-input\" placeholder=\"12345 67890\">\n            </div>\n          </div>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Reference Image Upload <span>*</span></label>\n          \n          <input type=\"file\" name=\"contact[note][Reference Image]\" id=\"real-file\" hidden>\n          \n          <label for=\"real-file\" class=\"cora-upload-box\">\n             <svg class=\"cora-upload-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n               <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n               <polyline points=\"17 8 12 3 7 8\"></polyline>\n               <line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\"></line>\n             </svg>\n             <span class=\"cora-upload-title\" id=\"upload-title\">Click to upload your image</span>\n             <span class=\"cora-upload-desc\">JPG, PNG, PDF up to 5MB</span>\n          </label>\n        </div>\n\n        <div class=\"cora-form-col\">\n          <label class=\"cora-label\">Design Details <span>*</span></label>\n          <textarea name=\"contact[body]\" class=\"cora-textarea\" placeholder=\"I was thinking if my rug could have a...\" required></textarea>\n        </div>\n\n        <button type=\"submit\" class=\"cora-submit-btn\">\n          Submit Request\n          <svg class=\"cora-submit-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line>\n            <polyline points=\"12 5 19 12 12 19\"></polyline>\n          </svg>\n        </button>\n\n      </div>\n    {% endform %}\n  </div>\n</section>\n\n<script>\n  // Update upload text on file select\n  document.getElementById('real-file').addEventListener('change', function() {\n    var fileName = this.files[0] ? this.files[0].name : \"Click to upload your image\";\n    var titleEl = document.getElementById('upload-title');\n    titleEl.textContent = fileName;\n    \n    // Optional: visual feedback\n    if(this.files[0]) {\n      titleEl.style.color = \"#000\";\n      titleEl.style.textDecoration = \"underline\";\n    }\n  });\n</script>",
