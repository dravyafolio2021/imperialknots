# Standard Shopify Rules
{%- for group in robots.default_groups -%}
  {{- group.user_agent -}}

  {%- for rule in group.rules -%}
    {{- rule -}}
  {%- endfor -%}

  {%- if group.sitemap != blank -%}
    {{- group.sitemap -}}
  {%- endif -%}
{%- endfor -%}

# --- CUSTOM FIXES TO REDUCE CRAWL WASTE ---
# These rules stop bots from crawling duplicate filter/sort combinations

Disallow: /*?*filter*  
Disallow: /*?*sort_by* 
Disallow: /*?*variant* 
Disallow: /*?*page= 
Disallow: /search 
Disallow: /collections/*+* 

# ------------------------------------------