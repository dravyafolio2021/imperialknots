{% comment %}
Imperial Knots - robots.txt
Clean + SEO optimized + correct formatting
{% endcomment %}

# ----------------------------------
# STANDARD SHOPIFY RULES
# ----------------------------------

{% for group in robots.default_groups %}
{{ group.user_agent }}

{% for rule in group.rules %}
{{ rule }}
{% endfor %}

{% if group.sitemap != blank %}
{{ group.sitemap }}
{% endif %}

{% endfor %}

# ----------------------------------
# CUSTOM SEO RULES (IMPORTANT)
# ----------------------------------

User-agent: *

# -------------------------------
# BLOCK FILTERS & PARAMETERS
# -------------------------------

Disallow: /*?*filter*
Disallow: /*?*sort_by*
Disallow: /*?*variant*
Disallow: /*?*page=
Disallow: /*?*size=
Disallow: /*?*color=
Disallow: /*?*q=

# Fallback: block any unknown parameters (optional but safe)
Disallow: /*?*

# -------------------------------
# BLOCK FACETED COLLECTION URLS
# (CRITICAL FIX)
# -------------------------------

Disallow: /collections/*/*
Disallow: /collections/*+*
Disallow: /collections/*%2B*
Disallow: /collections/*%2b*

# -------------------------------
# BLOCK SEARCH & SYSTEM PATHS
# -------------------------------

Disallow: /search
Disallow: /apple-app-site-association
Disallow: /.well-known/shopify/monorail
Disallow: /cdn/wpm/

# -------------------------------
# ALLOW IMPORTANT PAGES
# -------------------------------

Allow: /collections/
Allow: /collections/*.json
Allow: /collections/*/products/
Allow: /products/
Allow: /blogs/
Allow: /pages/

# -------------------------------
# SITEMAP
# -------------------------------

Sitemap: https://www.imperialknots.com/sitemap.xml

